<Window x:Class="Kora.SessionsWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Kora.Controls"
    Title="Sessions - authoritative work and durable history" Icon="/Assets/Kora.ico"
    Width="1180" Height="900" MinWidth="900" MinHeight="700"
    Background="{DynamicResource KoraWindowBackgroundBrush}"
    Foreground="{DynamicResource KoraForegroundBrush}" WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="/ConversationPresentation.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>
  <Grid Margin="24" RowDefinitions="Auto,Auto,Auto,Auto,*,Auto" RowSpacing="12">
    <StackPanel Orientation="Horizontal" Spacing="10">
      <TextBlock Text="Sessions (Active / Done)" FontSize="20" FontWeight="SemiBold" />
      <Button x:Name="NewRequest" Content="_New request (fresh target)" IsEnabled="{Binding CanRead}" />
      <Button x:Name="Refresh" Content="_Refresh" IsEnabled="{Binding CanRead}" />
      <Button x:Name="Next" Content="Next session page" IsEnabled="{Binding CanNext}" />
      <Button x:Name="AllWork" Content="_All work / attention overview" IsEnabled="{Binding CanRead}"
              AutomationProperties.Name="Open passive bounded cross-session work observations; opening grants nothing and does not resume or dispatch" />
      <ComboBox ItemsSource="{Binding SessionFilters}" SelectedItem="{Binding SessionFilter, Mode=TwoWay}"
                IsEnabled="{Binding CanRead}" AutomationProperties.Name="All, Active or Done: ordinary current page filter, or metadata-search scope across pages; no activity or routing" />
    </StackPanel>
    <controls:NamedTextBlock Grid.Row="1" Text="{Binding Status}" TextWrapping="Wrap" AutomationProperties.Name="Sessions status and unavailable reasons" />
    <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
      <TextBox Text="{Binding NameDraft, Mode=TwoWay}" MaxLength="240" IsEnabled="{Binding CanRead}"
               PlaceholderText="Name: NFC Unicode, up to 120 scalars / 480 UTF-8 bytes"
               AutomationProperties.Name="Session name draft; names never resolve authority" />
      <Button Grid.Column="1" x:Name="CreateSession" Content="_Create empty Active session" IsEnabled="{Binding CanCreate}" />
      <Button Grid.Column="2" x:Name="RenameSession" Content="Re_name selected ID" IsEnabled="{Binding CanRename}"
              AutomationProperties.Name="Rename the exact selected session ID using its generation and metadata revision; does not resume" />
    </Grid>
    <ScrollViewer Grid.Row="3" MaxHeight="260" VerticalScrollBarVisibility="Auto"
                  AutomationProperties.Name="Selected-session controls and provider policy review; scroll for complete controls">
    <StackPanel Spacing="6">
    <Expander Header="Exact-session conversation and composer — generation unavailable" IsExpanded="True">
      <StackPanel Spacing="6">
        <controls:NamedTextBlock Text="{Binding ComposerTarget}" TextWrapping="Wrap"
            AutomationProperties.Name="Composer exact target ID, name, generation, metadata and saved draft revisions, private control epoch" />
        <Button x:Name="CompactConversation" Content="Open / activate compact selected conversation" HorizontalAlignment="Left" />
        <TextBlock Text="Submit retains accepted text exactly and records a truthful unavailable-provider host outcome. Local best-effort structural credential checks reject detected material before Save or Submit; they cannot identify arbitrary passwords or guarantee secret-free text. Correct the memory draft or use supported secure credential flows; no Save anyway or silent redaction. No generation, runtime fallback, history, tools or network. Drafts are memory-only unless explicitly saved." TextWrapping="Wrap" />
        <WrapPanel>
          <Button x:Name="ReadConversation" Content="Read exact conversation / saved revision" IsEnabled="{Binding CanReadConversation}" />
          <Button x:Name="NextConversation" Content="Next bounded conversation page" IsEnabled="{Binding CanNextConversation}" />
        </WrapPanel>
        <controls:ScrollableListBox ItemsSource="{Binding ConversationMessages}" MaxHeight="160"
            ItemTemplate="{StaticResource ConversationMessageTemplate}"
            AutomationProperties.Name="Chronological immutable original user messages and separate host statuses; inert native text, not model answers or replay controls" />
        <TextBox x:Name="ConversationQuery" Text="{Binding ConversationQuery, Mode=TwoWay}" IsEnabled="{Binding CanReadConversation}"
            PlaceholderText="Search retained USER words or typed HOST outcome/reason/task state in only this exact selected session"
            AutomationProperties.Name="Private exact-session conversation lexical query; memory-only, not composer input, a model instruction or global search" />
         <ComboBox x:Name="ConversationRole" ItemsSource="{Binding ConversationRoles}"
            SelectedItem="{Binding ConversationRole, Mode=TwoWay}" IsEnabled="{Binding CanReadConversation}"
            AutomationProperties.Name="Conversation search field filter: All original USER and typed HOST fields, USER original body only, HOST outcome reason and task state only; editing does not read" />
        <TextBlock Text="Inclusive original-message ranges (empty means Any). Minimum must not exceed maximum; all ranges AND with the query, role and terminal predicates." TextWrapping="Wrap" />
        <TextBlock Text="Minimum message sequence" />
        <TextBox x:Name="ConversationMinimumSequence" Text="{Binding ConversationMinimumSequence, Mode=TwoWay}" IsEnabled="{Binding CanReadConversation}"
            AutomationProperties.Name="Inclusive minimum original message sequence; invariant decimal within conversation limits, empty means Any; editing does not read" />
        <TextBlock Text="Maximum message sequence" />
        <TextBox x:Name="ConversationMaximumSequence" Text="{Binding ConversationMaximumSequence, Mode=TwoWay}" IsEnabled="{Binding CanReadConversation}"
            AutomationProperties.Name="Inclusive maximum original message sequence; invariant decimal within conversation limits, empty means Any; editing does not read" />
        <TextBlock Text="Submitted from UTC (yyyy-MM-ddTHH:mm:ss.fffffff+00:00)" />
        <TextBox x:Name="ConversationSubmittedFrom" Text="{Binding ConversationSubmittedFrom, Mode=TwoWay}" IsEnabled="{Binding CanReadConversation}"
            AutomationProperties.Name="Inclusive submitted from canonical UTC time; yyyy-MM-ddTHH:mm:ss.fffffff+00:00, empty means Any; editing does not read" />
        <TextBlock Text="Submitted through UTC (yyyy-MM-ddTHH:mm:ss.fffffff+00:00)" />
        <TextBox x:Name="ConversationSubmittedThrough" Text="{Binding ConversationSubmittedThrough, Mode=TwoWay}" IsEnabled="{Binding CanReadConversation}"
            AutomationProperties.Name="Inclusive submitted through canonical UTC time; yyyy-MM-ddTHH:mm:ss.fffffff+00:00, empty means Any; editing does not read" />
        <TextBlock Text="Exact terminal HOST predicates (Any means unrestricted). USER-only with any predicate yields zero; all predicates AND with the query and role." TextWrapping="Wrap" />
        <TextBlock Text="Terminal outcome" />
        <ComboBox x:Name="ConversationOutcome" ItemsSource="{Binding ConversationOutcomes}"
            SelectedItem="{Binding ConversationOutcomeChoice, Mode=TwoWay}" IsEnabled="{Binding CanReadConversation}"
            AutomationProperties.Name="Exact terminal HOST ModelTurnOutcome; Any or one defined outcome; editing does not read" />
        <TextBlock Text="Terminal reason" />
        <ComboBox x:Name="ConversationReason" ItemsSource="{Binding ConversationReasons}"
            SelectedItem="{Binding ConversationReasonChoice, Mode=TwoWay}" IsEnabled="{Binding CanReadConversation}"
            AutomationProperties.Name="Exact terminal HOST ModelTurnReason; Any or one defined reason; editing does not read" />
        <TextBlock Text="Expected terminal task state" />
        <ComboBox x:Name="ConversationTaskState" ItemsSource="{Binding ConversationTaskStates}"
            SelectedItem="{Binding ConversationTaskStateChoice, Mode=TwoWay}" IsEnabled="{Binding CanReadConversation}"
            AutomationProperties.Name="Exact terminal HOST expected HostTaskState; Any or one defined state; editing does not read" />
        <WrapPanel>
          <Button x:Name="SearchConversation" Content="Search this conversation" IsEnabled="{Binding CanSearchConversation}" />
          <Button x:Name="NextConversationSearch" Content="Next conversation matches" IsEnabled="{Binding CanNextConversationSearch}" />
          <Button x:Name="CancelConversationSearch" Content="Cancel conversation search" IsEnabled="{Binding CanCancelConversationSearch}" />
          <Button x:Name="ClearConversationSearch" Content="Clear private conversation search" />
        </WrapPanel>
        <controls:NamedTextBlock Text="{Binding ConversationSearchStatus}" TextWrapping="Wrap"
            AutomationProperties.Name="Conversation search counters, exact snapshot continuation and explicit failures; no model context" />
        <controls:ScrollableListBox x:Name="ConversationSearchResults" ItemsSource="{Binding ConversationSearchMessages}" MaxHeight="160"
            ItemTemplate="{StaticResource ConversationMessageTemplate}"
            AutomationProperties.Name="Exact immutable USER messages matching lexical words or typed HOST status; inert native text, chronological, no export or actions" />
        <TextBox x:Name="ConversationComposer" Text="{Binding ComposerBody, Mode=TwoWay}" AcceptsReturn="True"
            Height="90" TextWrapping="Wrap" IsEnabled="{Binding CanCompose}"
            PlaceholderText="Original message: up to 4096 UTF-16 characters and 16384 UTF-8 bytes; invalid or oversized text is rejected, not truncated"
            AutomationProperties.Name="Memory-only exact-session conversation draft; not a question answer or approval" />
        <WrapPanel>
          <Button x:Name="SaveConversationDraft" Content="Explicitly Save draft" IsEnabled="{Binding CanSaveConversationDraft}" />
          <Button x:Name="ReloadConversationDraft" Content="Reload saved draft" IsEnabled="{Binding CanReloadConversationDraft}" />
          <Button x:Name="DiscardComposer" Content="Discard memory buffer only" IsEnabled="{Binding CanReadConversation}" />
          <Button x:Name="ReviewClearConversationDraft" Content="Review Clear saved draft" IsEnabled="{Binding CanReviewClearConversationDraft}" />
          <Button x:Name="ClearConversationDraft" Content="Confirm exact saved draft Clear" IsEnabled="{Binding CanClearConversationDraft}" />
          <Button x:Name="SubmitConversation" Content="Submit exact message — unavailable provider" IsEnabled="{Binding CanSubmitConversation}" />
        </WrapPanel>
        <TextBlock Text="{Binding SavedConversationDraftReview}" TextWrapping="Wrap"
            AutomationProperties.Name="Complete exact saved draft body under clear review; content is inert and not current instructions" />
        <controls:NamedTextBlock Text="{Binding ConversationStatus}" TextWrapping="Wrap"
            AutomationProperties.Name="Conversation actual save, submission, unavailable or recovery status" />
      </StackPanel>
    </Expander>
    <WrapPanel>
      <Button x:Name="AttachFile" Content="Attach text file to this exact Session" IsEnabled="{Binding CanAttachFile}"
              AutomationProperties.Name="Native picker then metadata and durable-copy review; one file, 256 KiB original UTF-8 bytes, sixteen retained profile files, no eviction" />
      <Button x:Name="InspectAttachment" Content="Inspect retained attachment / remove Kora copies" IsEnabled="{Binding CanInspectAttachment}"
              AutomationProperties.Name="Passive exact-session historical full inert source and lexical citations, including retained Done sessions; separate exact removal confirmation" />
    </WrapPanel>
    <Expander Header="Selected-session retention: status and exact review">
      <StackPanel Spacing="6">
        <controls:NamedTextBlock Text="{Binding RetentionStatus}" TextWrapping="Wrap"
                                AutomationProperties.Name="Exact selected session retention UTC clocks, kept and purged state; passive observation only" />
        <WrapPanel>
          <Button x:Name="RefreshRetention" Content="Refresh _retention status" IsEnabled="{Binding CanRefreshRetention}" />
          <Button x:Name="KeepSession" Content="_Keep this session" IsEnabled="{Binding CanKeepSession}" />
          <Button x:Name="OrdinaryRetention" Content="Use _ordinary retention" IsEnabled="{Binding CanUseOrdinaryRetention}" />
          <Button x:Name="ConfirmRetention" Content="Confirm exact retention review" IsEnabled="{Binding CanConfirmRetention}"
                  AutomationProperties.Name="Freshly confirm one exact session, generation, displayed dates and hold revision; no cleanup now" />
          <Button x:Name="CancelRetentionReview" Content="Cancel retention review" />
        </WrapPanel>
        <controls:NamedTextBlock Text="{Binding RetentionPreview}" TextWrapping="Wrap"
                                AutomationProperties.Name="Exact retention confirmation; ordinary policy may already be due; session hold is not an operation grant" />
      </StackPanel>
    </Expander>
    <Expander Header="Selected-session provider overrides: inherit app or exact desired choices">
      <StackPanel Spacing="6">
        <controls:NamedTextBlock Text="{Binding ProviderStatus}" TextWrapping="Wrap"
            AutomationProperties.Name="Exact selected session saved sparse fields, inherited flags, effective unavailable or resolved tuple, account and catalogue provenance; no generation or authentication" />
        <WrapPanel>
          <Button x:Name="RefreshProviders" Content="Refresh exact session provider status" IsEnabled="{Binding CanInspectProviders}" />
          <ComboBox ItemsSource="{Binding ProviderServices}" SelectedItem="{Binding ProviderService, Mode=TwoWay}"
              IsEnabled="{Binding CanReviewProviders}" AutomationProperties.Name="Desired service for this exact session; selecting grants nothing" />
          <Button x:Name="ReviewProviderService" Content="Review service override" IsEnabled="{Binding CanReviewProviders}" />
          <Button x:Name="ResetProviderService" Content="Inherit app service" IsEnabled="{Binding CanReviewProviders}" />
        </WrapPanel>
        <TextBlock Text="Change only one field from the current effective tuple. Retained choices must remain compatible; otherwise use complete-profile review below." TextWrapping="Wrap" />
        <WrapPanel>
          <ComboBox ItemsSource="{Binding ProviderModels}" SelectedItem="{Binding ProviderFieldModel, Mode=TwoWay}" Width="200"
              IsEnabled="{Binding CanSelectProviderField}" AutomationProperties.Name="Only session model override; retains effective reasoning and context without freezing inheritance">
            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
          </ComboBox>
          <Button x:Name="ReviewProviderModel" Content="Review model only" IsEnabled="{Binding CanReviewProviderModelField}" />
          <ComboBox ItemsSource="{Binding ProviderFieldReasonings}" SelectedItem="{Binding ProviderFieldReasoning, Mode=TwoWay}" Width="150"
              IsEnabled="{Binding CanSelectProviderField}" AutomationProperties.Name="Only session reasoning override; options belong to current effective model">
            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
          </ComboBox>
          <Button x:Name="ReviewProviderReasoning" Content="Review reasoning only" IsEnabled="{Binding CanReviewProviderReasoningField}" />
          <ComboBox ItemsSource="{Binding ProviderFieldContexts}" SelectedItem="{Binding ProviderFieldContext, Mode=TwoWay}" Width="150"
              IsEnabled="{Binding CanSelectProviderField}" AutomationProperties.Name="Only session context override; options belong to current effective model and cannot raise security envelope">
            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
          </ComboBox>
          <Button x:Name="ReviewProviderContext" Content="Review context only" IsEnabled="{Binding CanReviewProviderContextField}" />
        </WrapPanel>
        <TextBlock Text="Complete-profile recovery: explicitly choose all three values. This replaces all dependent overrides, not app preferences." TextWrapping="Wrap" />
        <WrapPanel>
          <ComboBox ItemsSource="{Binding ProviderModels}" SelectedItem="{Binding ProviderModel, Mode=TwoWay}" Width="200"
              IsEnabled="{Binding CanSelectProviderModel}" AutomationProperties.Name="Exact current advertised model; empty means unavailable, never fake choices">
            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
          </ComboBox>
          <ComboBox ItemsSource="{Binding ProviderReasonings}" SelectedItem="{Binding ProviderReasoning, Mode=TwoWay}" Width="150"
              IsEnabled="{Binding CanSelectProviderModel}" AutomationProperties.Name="Exact current model-specific reasoning option">
            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
          </ComboBox>
          <ComboBox ItemsSource="{Binding ProviderContexts}" SelectedItem="{Binding ProviderContext, Mode=TwoWay}" Width="150"
              IsEnabled="{Binding CanSelectProviderModel}" AutomationProperties.Name="Exact current model-specific context option; cannot raise security envelope">
            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
          </ComboBox>
          <Button x:Name="ReviewProviderTuple" Content="Review complete exact tuple" IsEnabled="{Binding CanReviewProviderModel}" />
        </WrapPanel>
        <WrapPanel>
          <Button x:Name="ResetProviderModel" Content="Inherit app model" IsEnabled="{Binding CanReviewProviders}" />
          <Button x:Name="ResetProviderReasoning" Content="Inherit app reasoning" IsEnabled="{Binding CanReviewProviders}" />
          <Button x:Name="ResetProviderContext" Content="Inherit app context" IsEnabled="{Binding CanReviewProviders}" />
          <Button x:Name="ResetProviders" Content="Use app defaults for this session: review all-field reset" IsEnabled="{Binding CanReviewProviders}" />
          <Button x:Name="ConfirmProviders" Content="Confirm exact selected-session proposal" IsEnabled="{Binding CanConfirmProviders}" />
          <Button x:Name="CancelProviders" Content="Cancel provider review" />
        </WrapPanel>
      </StackPanel>
    </Expander>
    <WrapPanel>
      <ComboBox ItemsSource="{Binding ListSearchKinds}" SelectedItem="{Binding ListSearchKind, Mode=TwoWay}"
                IsEnabled="{Binding CanEditListSearch}" AutomationProperties.Name="Session metadata search mode: literal ordinal case-sensitive NameSubstring or canonical lowercase exact immutable ID" />
      <TextBox x:Name="ListQuery" Text="{Binding ListQuery, Mode=TwoWay}" Width="320"
               IsEnabled="{Binding CanEditListSearch}" PlaceholderText="Session name substring or exact ID; Enter searches"
               AutomationProperties.Name="Volatile session-list metadata query, not conversation-history search; NFC name limits, no silent truncation or normalization" />
      <TextBox x:Name="ListMinimumGeneration" Text="{Binding ListMinimumGeneration, Mode=TwoWay}" Width="190"
               IsEnabled="{Binding CanEditListSearch}" PlaceholderText="Generation minimum; Any"
               AutomationProperties.Name="Session-list authority generation inclusive minimum; positive decimal or empty for Any; passive metadata, not authority" />
      <TextBox x:Name="ListMaximumGeneration" Text="{Binding ListMaximumGeneration, Mode=TwoWay}" Width="190"
               IsEnabled="{Binding CanEditListSearch}" PlaceholderText="Generation maximum; Any"
               AutomationProperties.Name="Session-list authority generation inclusive maximum; positive decimal or empty for Any; passive metadata, not authority" />
      <TextBox x:Name="ListMinimumMetadataRevision" Text="{Binding ListMinimumMetadataRevision, Mode=TwoWay}" Width="190"
               IsEnabled="{Binding CanEditListSearch}" PlaceholderText="Name revision minimum; Any"
               AutomationProperties.Name="Session-list name metadata revision inclusive minimum; positive decimal or empty for Any; unnamed never matches a revision bound" />
      <TextBox x:Name="ListMaximumMetadataRevision" Text="{Binding ListMaximumMetadataRevision, Mode=TwoWay}" Width="190"
               IsEnabled="{Binding CanEditListSearch}" PlaceholderText="Name revision maximum; Any"
               AutomationProperties.Name="Session-list name metadata revision inclusive maximum; positive decimal or empty for Any; unnamed never matches a revision bound" />
      <Button x:Name="SearchList" Content="Search session _metadata" IsEnabled="{Binding CanSearchList}"
              AutomationProperties.Name="Search names or exact IDs across bounded session metadata pages, never target an action by name" />
      <Button x:Name="NextListSearch" Content="Next metadata search" IsEnabled="{Binding CanNextListSearch}"
              AutomationProperties.Name="Continue the query-bound mutable metadata scan, including after zero matches; not an atomic history snapshot" />
      <Button x:Name="CancelListSearch" Content="Cancel metadata search" IsEnabled="{Binding CanCancelListSearch}" />
      <Button x:Name="ClearListSearch" Content="Clear metadata search" IsEnabled="{Binding CanEditListSearch}" />
    </WrapPanel>
    <WrapPanel>
      <TextBox Text="{Binding HistorySessionId, Mode=TwoWay}" Width="320" IsEnabled="{Binding CanRead}"
               AutomationProperties.Name="Exact immutable session ID for passive history; names do not select sessions" />
      <Button x:Name="ReadHistory" Content="_Read exact history" IsEnabled="{Binding CanHistory}"
              AutomationProperties.Name="Read bounded ordered session history without resuming, replying, replaying or changing voice target" />
      <Button x:Name="ReadExactRetention" Content="Read exact ID retention" IsEnabled="{Binding CanReadExactRetention}"
              AutomationProperties.Name="Read retention metadata only for this canonical exact immutable ID, even when due content inspection is held; names and history are not read" />
      <Button x:Name="NextHistory" Content="Next history snapshot page" IsEnabled="{Binding CanNextHistory}" />
      <Button x:Name="OpenHistoryDetail" Content="Open immutable receipt _details" IsEnabled="{Binding CanOpenHistoryDetail}"
              AutomationProperties.Name="Freshly resolve the exact selected session history receipt into read-only native details; no artifact body or execution authority" />
    </WrapPanel>
    <WrapPanel>
      <TextBox x:Name="HistoryQuery" Text="{Binding HistoryQuery, Mode=TwoWay}" Width="320" MaxLength="256"
               IsEnabled="{Binding CanRead}" PlaceholderText="Lexical words; Enter searches, Escape clears"
               AutomationProperties.Name="Volatile exact-session history query; whole-word Unicode OR search, no model or activity renewal" />
      <Button x:Name="SearchHistory" Content="_Search exact history" IsEnabled="{Binding CanSearchHistory}"
              AutomationProperties.Name="Search retained committed history for this exact immutable session ID; no resume or reply" />
      <Button x:Name="NextHistorySearch" Content="Next _search snapshot page" IsEnabled="{Binding CanNextHistorySearch}"
              AutomationProperties.Name="Continue bounded lexical scan even when the previous search page has no matches" />
      <Button x:Name="CancelHistorySearch" Content="Cancel search" IsEnabled="{Binding CanCancelHistorySearch}" />
      <Button x:Name="ClearHistorySearch" Content="Clear query and results" IsEnabled="{Binding CanRead}" />
    </WrapPanel>
    </StackPanel>
    </ScrollViewer>
    <Grid Grid.Row="4" ColumnDefinitions="320,*" ColumnSpacing="14">
      <controls:ScrollableListBox x:Name="Records" ItemsSource="{Binding Sessions}" SelectedItem="{Binding SelectedSessionRecord, Mode=OneWay}" IsEnabled="{Binding CanRead}"
               AutomationProperties.Name="Durable session names, exact IDs, lifecycle and optimistic revisions">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel>
              <TextBlock Text="{Binding Metadata.Name.Value, TargetNullValue='Unnamed session', FallbackValue='Unnamed session'}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding Authority.SessionId.Value}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding Authority.IsActive, StringFormat='Active: {0} (false means Done)'}" />
              <TextBlock Text="{Binding Authority.Generation.Value, StringFormat='Generation: {0}'}" />
              <TextBlock Text="{Binding Metadata.Revision.Value, TargetNullValue='Metadata not yet set', FallbackValue='Metadata not yet set', StringFormat='Metadata revision: {0}'}" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </controls:ScrollableListBox>
      <Grid Grid.Column="1" RowDefinitions="Auto,2*,Auto,*,*" RowSpacing="10">
        <controls:NamedTextBlock Text="{Binding WorkStatus}" TextWrapping="Wrap"
                                AutomationProperties.Name="Selected exact session work snapshot, revisions, observation time, capacity and gaps" />
        <controls:ScrollableListBox Grid.Row="1" x:Name="WorkRecords" ItemsSource="{Binding WorkRecords}"
                 SelectedItem="{Binding SelectedWorkRecord, Mode=OneWay}"
                 AutomationProperties.Name="Authoritative queued, current, waiting, blocked, cancelled and unknown work; selection is passive">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Spacing="3" Margin="4">
                <TextBlock Text="{Binding State}" />
                <TextBlock Text="{Binding Identity}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Revisions}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Deadline}" TextWrapping="Wrap" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </controls:ScrollableListBox>
        <WrapPanel Grid.Row="2">
          <Button x:Name="ReadQueue" Content="Refresh selected _work" IsEnabled="{Binding CanRefreshWork}"
                  AutomationProperties.Name="Passively refresh selected exact session work; no meaningful activity or dispatch" />
          <Button x:Name="InspectWork" Content="_Inspect selected work ID" IsEnabled="{Binding CanInspectWork}"
                  AutomationProperties.Name="Inspect exact selected task or queue ID without execution authority" />
          <Button x:Name="CancelQueueEntry" Content="_Cancel selected eligible work" IsEnabled="{Binding CanCancelWork}"
                  AutomationProperties.Name="Cancel only the exact displayed pending queue entry or admitted pre-dispatch question wait at its revisions" />
          <Button x:Name="RemoveQueueEntry" Content="_Remove pending ID" IsEnabled="{Binding CanRemoveQueueEntry}"
                  AutomationProperties.Name="Remove only the exact selected pending queue ID and revision; history retained" />
          <Button x:Name="MoveQueueUp" Content="Review Move _up" IsEnabled="{Binding CanMoveQueueUp}"
                  AutomationProperties.Name="Review selected exact pending ID swapping only with its displayed previous pending neighbor" />
          <Button x:Name="MoveQueueDown" Content="Review Move _down" IsEnabled="{Binding CanMoveQueueDown}"
                  AutomationProperties.Name="Review selected exact pending ID swapping only with its displayed next pending neighbor" />
          <Button x:Name="EnqueueVersion" Content="Enqueue local version" IsEnabled="{Binding CanEnqueueVersion}"
                  AutomationProperties.Name="Enqueue version with the explicit optional prerequisite choice; no automatic dispatch" />
          <Button x:Name="EnqueueCapabilities" Content="Enqueue capabilities.list" IsEnabled="{Binding CanEnqueueVersion}"
                  AutomationProperties.Name="Enqueue capabilities.list with the explicit optional prerequisite choice; no automatic dispatch" />
          <Button x:Name="EnqueueReadiness" Content="Enqueue readiness.get" IsEnabled="{Binding CanEnqueueVersion}"
                  AutomationProperties.Name="Enqueue readiness.get with the explicit optional prerequisite choice; no automatic dispatch" />
          <Button x:Name="EnqueueRuntimes" Content="Enqueue runtime.list" IsEnabled="{Binding CanEnqueueVersion}"
                  AutomationProperties.Name="Enqueue runtime.list with the explicit optional prerequisite choice; no automatic dispatch" />
          <Button x:Name="EnqueueCapability" Content="Enqueue selected capabilities.get" IsEnabled="{Binding CanEnqueueCapability}"
                  AutomationProperties.Name="Enqueue only the explicitly selected exact current descriptor with the same optional prerequisite; no automatic dispatch" />
          <Button x:Name="EnqueueRuntimeStatus" Content="Enqueue recorded local runtime status" IsEnabled="{Binding CanEnqueueVersion}"
                  AutomationProperties.Name="Enqueue runtime.get_status for fixed recorded local.inference only with the optional prerequisite; no automatic dispatch, probe or inference" />
          <Button x:Name="DispatchQueue" Content="Dispatch ready fixed reads fairly" IsEnabled="{Binding CanControlQueue}"
                  AutomationProperties.Name="Explicit manual bounded fair dispatch among already enqueued current-run sessions; no effect or provider execution" />
          <Button x:Name="PauseQueue" Content="Pause this session's new dispatch" IsEnabled="{Binding CanChangeQueuePause}"
                  AutomationProperties.Name="Pause exact current-run session queue admissions only; already committed work drains normally" />
          <Button x:Name="ResumeQueue" Content="Resume this session's dispatch eligibility" IsEnabled="{Binding CanChangeQueuePause}"
                  AutomationProperties.Name="Withdraw exact current-run pause only; no automatic dispatch, cancellation or restart replay" />
          <Button x:Name="ClearQueue" Content="Confirm clear displayed pending queue" IsEnabled="{Binding CanClearQueue}"
                  AutomationProperties.Name="Explicitly confirm removal of the displayed pending queue at its exact revision; active work and history remain" />
        </WrapPanel>
        <ScrollViewer Grid.Row="3" MaxHeight="180" VerticalScrollBarVisibility="Auto"
                      AutomationProperties.Name="Routine notices and pending exact questions; scroll for complete retained cards">
        <StackPanel Spacing="4">
          <controls:NamedTextBlock Text="{Binding QueueCapabilityStatus}" TextWrapping="Wrap"
                                  AutomationProperties.Name="Closed descriptor target choice and recorded local runtime boundary" />
          <ComboBox x:Name="QueueCapabilities" ItemsSource="{Binding QueueCapabilities}"
                    SelectedItem="{Binding SelectedQueueCapability, Mode=OneWay}" IsEnabled="{Binding CanSelectQueueCapability}"
                    AutomationProperties.Name="Explicit exact descriptor target from the current six read-only catalogue records; no default selection">
            <ComboBox.ItemTemplate>
              <DataTemplate><TextBlock Text="{Binding Label}" TextWrapping="Wrap" /></DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <controls:NamedTextBlock Text="{Binding QueuePrerequisiteStatus}" TextWrapping="Wrap"
                                  AutomationProperties.Name="Optional prerequisite choice and prospective fixed-read consequence; bounded observed metadata only" />
          <Button x:Name="NoQueuePrerequisite" Content="None: enqueue without a prerequisite" IsEnabled="{Binding CanRead}"
                  AutomationProperties.Name="Explicitly choose None for the next fixed read; never infer a prerequisite from work selection" />
          <controls:ScrollableListBox x:Name="QueuePrerequisites" MaxHeight="160"
                                     ItemsSource="{Binding QueuePrerequisites}"
                                     SelectedItem="{Binding SelectedQueuePrerequisite, Mode=OneWay}"
                                     IsEnabled="{Binding CanSelectQueuePrerequisite}"
                                     AutomationProperties.Name="Optional exact prerequisite task from at most 50 nonqueue and 50 already-observed queued same-session host metadata rows; IDs, generation, real host task state/revision and UTC source; no history scan">
            <ListBox.ItemTemplate>
              <DataTemplate><TextBlock Text="{Binding Label}" TextWrapping="Wrap" /></DataTemplate>
            </ListBox.ItemTemplate>
          </controls:ScrollableListBox>
          <controls:ScrollableListBox x:Name="PendingCancellationEntries" MaxHeight="160"
                                     ItemsSource="{Binding PendingCancellationEntries}" SelectionMode="Multiple,Toggle"
                                     IsEnabled="{Binding CanSelectPendingCancellation}"
                                     AutomationProperties.Name="Current-run pending queue only; independently select explicit subset for atomic cancellation">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Spacing="2">
                  <TextBlock Text="{Binding Request.TaskId.Value}" />
                  <TextBlock Text="{Binding ReadProfile}" />
                  <TextBlock Text="{Binding Revision.Value, StringFormat='Entry revision {0}'}" />
                  <TextBlock Text="{Binding ExpiresAt, StringFormat='Original pending expiry {0:O}'}" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </controls:ScrollableListBox>
          <controls:NamedTextBlock Text="{Binding PendingCancellationStatus}" TextWrapping="Wrap"
                                  AutomationProperties.Name="Complete selected pending cancellation review, count, exact IDs, order, profiles and original deadlines" />
          <WrapPanel>
            <Button x:Name="ReviewPendingCancellation" Content="Review selected pending cancellation" IsEnabled="{Binding CanReviewPendingCancellation}" />
            <Button x:Name="ConfirmPendingCancellation" Content="Cancel these pending entries only" IsEnabled="{Binding CanConfirmPendingCancellation}"
                    AutomationProperties.Name="Explicitly confirm atomic cancellation of the complete exact reviewed pending subset only" />
            <Button x:Name="DiscardPendingCancellation" Content="Cancel cancellation review" IsEnabled="{Binding CanDiscardPendingCancellation}"
                    AutomationProperties.Name="Cancel review without pending mutation; keep explicit pending selection and input drafts" />
          </WrapPanel>
          <controls:NamedTextBlock Text="{Binding QueueMoveStatus}" TextWrapping="Wrap"
                                  AutomationProperties.Name="Exact current and proposed adjacent pair order, immutable IDs, profiles and original pending deadlines" />
          <controls:NamedTextBlock Text="{Binding ExpiredRequeueStatus}" TextWrapping="Wrap"
                                  AutomationProperties.Name="Review old expired removal with retained history and separate fresh IDs, original prerequisite, fresh lifetime and deadline at queue tail; no replay or dispatch" />
          <WrapPanel>
            <Button x:Name="ReviewExpiredRequeue" Content="Review expired removal and NEW tail task" IsEnabled="{Binding CanReviewExpiredRequeue}" />
            <Button x:Name="ConfirmExpiredRequeue" Content="Confirm exact old removal and NEW tail task" IsEnabled="{Binding CanConfirmExpiredRequeue}"
                    AutomationProperties.Name="Confirm atomic removal of exact reviewed expired source and admission of separate fresh same-profile decision at tail only" />
            <Button x:Name="DiscardExpiredRequeue" Content="Cancel replacement review" IsEnabled="{Binding CanDiscardExpiredRequeue}"
                    AutomationProperties.Name="Cancel expired replacement review without queue mutation or admission of fresh IDs; drafts unchanged" />
          </WrapPanel>
          <WrapPanel>
            <Button x:Name="ConfirmQueueMove" Content="Confirm exact adjacent move" IsEnabled="{Binding CanConfirmQueueMove}"
                    AutomationProperties.Name="Confirm only reviewed exact adjacent pair, queue and entry revisions, current run and private control" />
            <Button x:Name="CancelQueueMove" Content="Cancel move review" IsEnabled="{Binding CanCancelQueueMove}"
                    AutomationProperties.Name="Cancel exact move review without changing queue order or draft" />
          </WrapPanel>
          <controls:NamedTextBlock Text="{Binding RoutineQuietStatus}" TextWrapping="Wrap"
                                  AutomationProperties.Name="Run-only routine quiet status; Work and Maintenance only, failures and required questions unchanged" />
          <WrapPanel>
            <Button x:Name="QuietRoutineNotices" Content="Quiet routine notices for this run" IsEnabled="{Binding CanChangeRoutineQuiet}"
                    AutomationProperties.Name="Enable quiet for Work and Maintenance notices and rows until explicitly cleared or Kora restarts; no speech or work changes" />
            <Button x:Name="ClearRoutineQuiet" Content="Turn routine quiet off" IsEnabled="{Binding CanChangeRoutineQuiet}"
                    AutomationProperties.Name="Clear run-only routine quiet; future new notices only, no suppressed backlog replay" />
            <Button x:Name="ResetRoutineQuiet" Content="Reset routine quiet to Off" IsEnabled="{Binding CanChangeRoutineQuiet}"
                    AutomationProperties.Name="Reset run-only routine quiet to default Off; no preference saved and no backlog replay" />
          </WrapPanel>
          <controls:NamedTextBlock Text="{Binding LocalEventStatus}" TextWrapping="Wrap"
                                  AutomationProperties.Name="Trusted visual local event status, fatigue, deferral and no replay reasons; no speech or focus change" />
          <WrapPanel>
            <TextBlock Text="Local event category" VerticalAlignment="Center" />
            <ComboBox x:Name="LocalEventCategoryFilter" ItemsSource="{Binding LocalEventCategoryFilters}"
                      SelectedItem="{Binding LocalEventCategoryChoice}" IsEnabled="{Binding CanFilterLocalEvents}"
                      AutomationProperties.Name="Filter loaded local events by authoritative category; All, Work, Failure, Attention or Maintenance; clears exact event selection" />
            <TextBlock Text="Local event reason" VerticalAlignment="Center" />
            <ComboBox x:Name="LocalEventReasonFilter" ItemsSource="{Binding LocalEventReasonFilters}"
                      SelectedItem="{Binding LocalEventReasonChoice}" IsEnabled="{Binding CanFilterLocalEvents}"
                      AutomationProperties.Name="Filter loaded local events by exact delivery reason or All; combines with category, source and type and clears exact event selection" />
            <TextBlock Text="Local event source" VerticalAlignment="Center" />
            <ComboBox x:Name="LocalEventSourceFilter" ItemsSource="{Binding LocalEventSourceFilters}"
                      SelectedItem="{Binding LocalEventSourceChoice}" IsEnabled="{Binding CanFilterLocalEvents}"
                      AutomationProperties.Name="Filter loaded local events by exact authoritative source or All; combines with category, reason and type and clears exact event selection" />
            <TextBlock Text="Local event type" VerticalAlignment="Center" />
            <ComboBox x:Name="LocalEventTypeFilter" ItemsSource="{Binding LocalEventTypeFilters}"
                      SelectedItem="{Binding LocalEventTypeChoice}" IsEnabled="{Binding CanFilterLocalEvents}"
                      AutomationProperties.Name="Filter loaded local events by exact authoritative type or All; combines with category, reason and source and clears exact event selection" />
            <TextBlock Text="Local event request origin" VerticalAlignment="Center" />
            <ComboBox x:Name="LocalEventOriginFilter" ItemsSource="{Binding LocalEventOriginFilters}"
                      SelectedItem="{Binding LocalEventOriginChoice}" IsEnabled="{Binding CanFilterLocalEvents}"
                      AutomationProperties.Name="Filter loaded local events by exact request origin or Any; combines with all event filters and clears exact event selection" />
            <TextBlock Text="Local event queue eligibility reason" VerticalAlignment="Center" />
            <ComboBox x:Name="LocalEventQueueReasonFilter" ItemsSource="{Binding LocalEventQueueReasonFilters}"
                      SelectedItem="{Binding LocalEventQueueReasonChoice}" IsEnabled="{Binding CanFilterLocalEvents}"
                      AutomationProperties.Name="Filter loaded local events by Any, No queue reason / not applicable, or exact queue eligibility reason; combines with all event filters and clears exact event selection; absence is not success or authority" />
            <TextBlock Text="Local event session ID" VerticalAlignment="Center" />
            <TextBox x:Name="LocalEventSessionIdFilter" Text="{Binding LocalEventSessionIdFilter}" Width="300"
                     PlaceholderText="Any session ID (empty)" IsEnabled="{Binding CanFilterLocalEvents}"
                     AutomationProperties.Name="Filter loaded local events by exact session ID; empty for Any, complete lowercase D GUID; AND with all filters; clears selection; correlation only, never retargets or authorizes" />
            <TextBlock Text="Local event task ID" VerticalAlignment="Center" />
            <TextBox x:Name="LocalEventTaskIdFilter" Text="{Binding LocalEventTaskIdFilter}" Width="300"
                     PlaceholderText="Any task ID (empty)" IsEnabled="{Binding CanFilterLocalEvents}"
                     AutomationProperties.Name="Filter loaded local events by exact task ID; empty for Any, complete lowercase D GUID; missing tasks never match; AND with all filters; clears selection; correlation only, never retargets or authorizes" />
            <TextBlock Text="Local event subject ID" VerticalAlignment="Center" />
            <TextBox x:Name="LocalEventSubjectIdFilter" Text="{Binding LocalEventSubjectIdFilter}" Width="300"
                     PlaceholderText="Any subject ID (empty)" IsEnabled="{Binding CanFilterLocalEvents}"
                     AutomationProperties.Name="Filter loaded local events by exact subject ID; empty for Any, complete lowercase D GUID; AND with all filters; clears selection; correlation only, never retargets or authorizes" />
            <Button x:Name="ClearLocalEventFilters" Content="Clear local event filters" IsEnabled="{Binding CanFilterLocalEvents}"
                    AutomationProperties.Name="Show all already-loaded local events and clear exact selection; no source read or quiet change" />
          </WrapPanel>
          <controls:NamedTextBlock Text="{Binding LocalEventFilterStatus}" TextWrapping="Wrap"
                                  AutomationProperties.Name="Matching loaded local-event counts and empty filter results; bounded source omissions and quiet status are separate" />
          <controls:ScrollableListBox x:Name="EventRecords" MaxHeight="130" ItemsSource="{Binding LocalEvents}"
                   SelectedItem="{Binding SelectedLocalEvent, Mode=OneWay}"
                   AutomationProperties.Name="Content-free exact host event IDs and revisions; pending questions remain independent">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel>
                  <TextBlock Text="{Binding DisplaySummary}" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding Event.Id, StringFormat='Exact event {0}'}" />
                  <TextBlock Text="{Binding Event.SessionId.Value, StringFormat='Session ID {0:D}'}" />
                  <TextBlock Text="{Binding Event.TaskId.Value, StringFormat='Task ID {0:D}'}" />
                  <TextBlock Text="{Binding Event.SubjectId, StringFormat='Subject ID {0:D}'}" />
                  <TextBlock Text="{Binding Event.Revision, StringFormat='Revision {0}'}" />
                  <TextBlock Text="{Binding Reason, StringFormat='Delivery state {0}'}" />
                  <TextBlock Text="{Binding Event.ExpiresAt, StringFormat='Original expiry {0:O}'}" />
                  <TextBlock Text="{Binding DeferredUntil, StringFormat='Deferred until {0:O}'}" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </controls:ScrollableListBox>
          <WrapPanel>
            <Button x:Name="ReviewLocalEvent" Content="Review exact event" IsEnabled="{Binding CanControlLocalEvent}"
                    AutomationProperties.Name="Review only the selected exact event ID and revision; does not answer or retarget any question" />
            <Button x:Name="DismissLocalEvent" Content="Dismiss exact event" IsEnabled="{Binding CanControlLocalEvent}"
                    AutomationProperties.Name="Dismiss only the selected exact event revision; no task cancellation or maintenance action" />
            <Button x:Name="DeferLocalEvent" Content="Defer exact event 15 minutes" IsEnabled="{Binding CanControlLocalEvent}"
                    AutomationProperties.Name="Defer only this event for fifteen minutes, capped at its original expiry; no work deadline extension" />
          </WrapPanel>
          <TextBlock Text="Pending questions — exact original targets; answer only in the separate Questions window" TextWrapping="Wrap" FontWeight="SemiBold" />
          <ScrollViewer MaxHeight="160">
          <ItemsControl ItemsSource="{Binding PendingQuestions}" AutomationProperties.Name="Pending questions remain visible beside work and history; never retargeted by selection">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel>
                  <TextBlock Text="{Binding Key.QuestionId.Value, StringFormat='Question {0}'}" />
                  <TextBlock Text="{Binding Key.Request.TaskId.Value, StringFormat='Exact task {0}'}" />
                  <TextBlock Text="{Binding Key.Revision.Value, StringFormat='Question revision {0}'}" />
                  <TextBlock Text="{Binding Generation.Value, StringFormat='Session generation {0}'}" />
                  <TextBlock Text="{Binding Kind, StringFormat='Question kind {0}'}" />
                  <TextBlock Text="{Binding ExpiresAt, StringFormat='User-wait expiry {0:O}; no scheduler slot or active-task clock'}" TextWrapping="Wrap" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          </ScrollViewer>
        </StackPanel>
        </ScrollViewer>
        <TabControl Grid.Row="4">
        <TabItem Header="History and evidence">
        <Grid RowDefinitions="Auto,*" RowSpacing="6">
          <ListBox x:Name="HistoryRecords" MaxHeight="150" ItemsSource="{Binding HistoryRecords}"
                   SelectedItem="{Binding SelectedHistoryRecord, Mode=OneWay}" IsEnabled="{Binding CanRead}"
                   AutomationProperties.Name="Immutable history receipts for the exact history subject; detail opening requires the selected session">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="{Binding Sequence}" />
                  <TextBlock Text="{Binding Kind}" />
                  <TextBlock Text="{Binding Availability}" />
                  <TextBlock Text="{Binding Id}" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        <ScrollViewer Grid.Row="1">
          <controls:NamedTextBlock Text="{Binding Detail}" TextWrapping="Wrap" FontFamily="Consolas"
                     AutomationProperties.Name="Typed question, exact task and evidence details; inspection is not approval"
                     AutomationProperties.AutomationId="SessionDetail" />
        </ScrollViewer>
        </Grid>
        </TabItem>
        <TabItem Header="Session memories">
          <ScrollViewer>
            <StackPanel Spacing="8">
              <TextBlock Text="Active selected session only. New user proposals stay volatile until separate admission. Classification is not secrecy detection. List contains metadata, not values. Inspect exact content and classification before review. No conversational Remember trigger, model tool, recall or hosted disclosure."
                         TextWrapping="Wrap" />
              <Button x:Name="ListMemories" Content="_List selected session memories" IsEnabled="{Binding CanReadMemories}"
                      AutomationProperties.Name="List exact active selected session memory identity, revision, scope, review, retention and creation time only" />
              <TextBlock Text="Filter only the frozen listed metadata. No content search or classification filter. Edits clear selection, inspection and replacement draft; select and inspect an exact visible result again. List explicitly to refresh." TextWrapping="Wrap" />
              <TextBox x:Name="MemoryIdFilter" Text="{Binding MemoryIdFilter, Mode=TwoWay}"
                       IsEnabled="{Binding CanFilterMemories}" PlaceholderText="Exact memory GUID, or empty for Any"
                       AutomationProperties.Name="Exact memory GUID filter over listed metadata only; no content reads" />
              <TextBlock Text="Inclusive ranges, combined with all metadata filters. Empty bounds mean Any. Revisions are positive decimal integers. UTC Created times use yyyy-MM-ddTHH:mm:ss.fffffff+00:00 (seven fractional digits)." TextWrapping="Wrap" />
              <TextBox x:Name="MemoryMinimumRevisionFilter" Text="{Binding MemoryMinimumRevisionFilter, Mode=TwoWay}"
                       IsEnabled="{Binding CanFilterMemories}" PlaceholderText="Minimum revision (inclusive), or empty for Any"
                       AutomationProperties.Name="Minimum memory revision inclusive; positive decimal or empty for Any; metadata only" />
              <TextBox x:Name="MemoryMaximumRevisionFilter" Text="{Binding MemoryMaximumRevisionFilter, Mode=TwoWay}"
                       IsEnabled="{Binding CanFilterMemories}" PlaceholderText="Maximum revision (inclusive), or empty for Any"
                       AutomationProperties.Name="Maximum memory revision inclusive; positive decimal or empty for Any; metadata only" />
              <TextBox x:Name="MemoryCreatedFromFilter" Text="{Binding MemoryCreatedFromFilter, Mode=TwoWay}"
                       IsEnabled="{Binding CanFilterMemories}" PlaceholderText="Created From UTC (inclusive), or empty for Any"
                       AutomationProperties.Name="Memory Created From UTC inclusive; yyyy-MM-ddTHH:mm:ss.fffffff+00:00 or empty for Any; metadata only" />
              <TextBox x:Name="MemoryCreatedUntilFilter" Text="{Binding MemoryCreatedUntilFilter, Mode=TwoWay}"
                       IsEnabled="{Binding CanFilterMemories}" PlaceholderText="Created Until UTC (inclusive), or empty for Any"
                       AutomationProperties.Name="Memory Created Until UTC inclusive; yyyy-MM-ddTHH:mm:ss.fffffff+00:00 or empty for Any; metadata only" />
              <WrapPanel>
                <TextBlock Text="Scope" VerticalAlignment="Center" />
                <ComboBox x:Name="MemoryScopeFilter" ItemsSource="{Binding MemoryScopeFilters}"
                          SelectedItem="{Binding MemoryScopeChoice, Mode=TwoWay}"
                          IsEnabled="{Binding CanFilterMemories}" AutomationProperties.Name="Memory Scope filter; Any or a defined scope kind; metadata only, not permission" />
                <TextBlock Text="Review" VerticalAlignment="Center" />
                <ComboBox x:Name="MemoryReviewFilter" ItemsSource="{Binding MemoryReviewFilters}"
                          SelectedItem="{Binding MemoryReviewChoice, Mode=TwoWay}"
                          IsEnabled="{Binding CanFilterMemories}" AutomationProperties.Name="Memory Review filter; Any or a defined review state" />
                <TextBlock Text="Retention" VerticalAlignment="Center" />
                <ComboBox x:Name="MemoryRetentionFilter" ItemsSource="{Binding MemoryRetentionFilters}"
                          SelectedItem="{Binding MemoryRetentionChoice, Mode=TwoWay}"
                          IsEnabled="{Binding CanFilterMemories}" AutomationProperties.Name="Memory Retention filter; Any or a defined retention state" />
                <Button x:Name="ClearMemoryFilters" Content="_Clear memory filters"
                        IsEnabled="{Binding CanFilterMemories}" AutomationProperties.Name="Clear memory filters and retire selection, inspection and replacement draft" />
              </WrapPanel>
              <controls:NamedTextBlock Text="{Binding MemoryFilterStatus}" TextWrapping="Wrap"
                                       AutomationProperties.Name="Local memory metadata filter results or validation recovery" />
              <ListBox x:Name="MemoryRecords" MaxHeight="160" ItemsSource="{Binding MemoryRecords}"
                       SelectedItem="{Binding SelectedMemory, Mode=OneWay}" IsEnabled="{Binding CanReadMemories}"
                       AutomationProperties.Name="Content-free memory inventory; selection is passive">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <StackPanel>
                      <TextBlock Text="{Binding Id}" />
                      <TextBlock Text="{Binding Revision, StringFormat='Revision {0}'}" />
                      <TextBlock Text="{Binding Scope.Kind, StringFormat='Scope {0}'}" />
                      <TextBlock Text="{Binding Scope.Identity}" />
                      <TextBlock Text="{Binding Review, StringFormat='Review {0}'}" />
                      <TextBlock Text="{Binding Retention, StringFormat='Retention {0}'}" />
                      <TextBlock Text="{Binding CreatedAt, StringFormat='Created {0:O}'}" />
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <WrapPanel>
                <Button x:Name="InspectMemory" Content="Inspect exact memory" IsEnabled="{Binding CanInspectMemory}" />
                <Button x:Name="AcceptMemory" Content="Review exact content: accept" IsEnabled="{Binding CanReviewMemory}"
                        AutomationProperties.Name="Review this inspected exact revision and classification; accept does not admit or enable" />
                <Button x:Name="RejectMemory" Content="Review exact content: reject" IsEnabled="{Binding CanReviewMemory}" />
                <Button x:Name="AdmitMemory" Content="Admit reviewed revision" IsEnabled="{Binding CanAdmitMemory}"
                        AutomationProperties.Name="Explicitly admit only this exact reviewed pending revision under unchanged private session boundary" />
                <Button x:Name="DisableMemory" Content="Disable admitted memory" IsEnabled="{Binding CanDisableMemory}" />
                <Button x:Name="ForgetMemory" Content="Forget exact memory" IsEnabled="{Binding CanEditMemory}"
                        AutomationProperties.Name="Explicitly forget this exact revision; clear body and review, retain non-reusable tombstone; not forensic erasure" />
              </WrapPanel>
              <controls:NamedTextBlock Text="{Binding MemoryDetail}" TextWrapping="Wrap"
                                       AutomationProperties.Name="Explicitly inspected exact memory content, classification, lineage and review receipt or content-free mutation outcome" />
              <ComboBox ItemsSource="{Binding MemoryClasses}" SelectedItem="{Binding MemoryClass, Mode=TwoWay}"
                        IsEnabled="{Binding CanProposeMemory}" AutomationProperties.Name="User proposal or replacement classification; not sensitivity proof" />
              <TextBox Text="{Binding MemoryDraft, Mode=TwoWay}" IsEnabled="{Binding CanProposeMemory}"
                       AutomationProperties.Name="Exact user proposal or replacement value; no truncation or normalization; 512 UTF-16 code units, 1024 UTF-8 value bytes, 2048 serialized candidate bytes" />
              <Button x:Name="ProposeMemory" Content="_New session memory from draft" IsEnabled="{Binding CanProposeMemory}"
                      AutomationProperties.Name="Create only a volatile Proposed Pending user candidate in the exact active selected session; no review, admission, recall or transmission" />
              <Button x:Name="EditMemory" Content="Replace exact revision; return to Proposed/Pending" IsEnabled="{Binding CanEditMemory}"
                      AutomationProperties.Name="Edit clears earlier review and use; replacement stays volatile until new inspect, review and admission" />
            </StackPanel>
          </ScrollViewer>
        </TabItem>
        </TabControl>
      </Grid>
    </Grid>
    <WrapPanel Grid.Row="5">
      <Button x:Name="NextQuestions" Content="Next questions" IsEnabled="{Binding CanNextQuestions}" />
      <Button x:Name="NextTasks" Content="Next tasks" IsEnabled="{Binding CanNextTasks}" />
      <Button x:Name="Evidence" Content="Read selected evidence" IsEnabled="{Binding CanEvidence}" />
      <Button x:Name="NextEvidence" Content="Next evidence" IsEnabled="{Binding CanNextEvidence}" />
      <Button x:Name="Done" Content="Mark selected ID _Done" IsEnabled="{Binding CanDone}" AutomationProperties.Name="Explicitly mark the displayed selected session ID Done using its expected generation" />
      <Button x:Name="Resume" Content="Explicitly res_ume selected ID" IsEnabled="{Binding CanResume}" AutomationProperties.Name="Explicitly resume the displayed selected session ID without task or approval replay" />
      <Button x:Name="PreviewDisposition" Content="Preview logical disposition" IsEnabled="{Binding CanPreviewDisposition}"
              AutomationProperties.Name="Preview exact selected session ID, revisions, live rows to remove and retained copies; does not delete" />
      <Button x:Name="ConfirmDisposition" Content="Confirm logical disposition" IsEnabled="{Binding CanConfirmDisposition}"
              AutomationProperties.Name="Explicitly confirm the previewed exact session logical disposition; not forensic deletion" />
      <Button x:Name="CloseView" Content="_Close" />
    </WrapPanel>
  </Grid>
</Window>
