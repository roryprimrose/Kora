<Window x:Class="Kora.SettingsWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="{Binding SettingsWindowTitle}" Icon="/Assets/Kora.ico"
    Width="1040" Height="760" MinWidth="860" MinHeight="620"
    Background="{DynamicResource KoraWindowBackgroundBrush}"
    Foreground="{DynamicResource KoraForegroundBrush}" WindowStartupLocation="CenterScreen" />
