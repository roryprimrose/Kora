<Window
    x:Class="Kora.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Kora.Controls"
    Title="{Binding AssistantName}"
    Width="{Binding PresenceSizePixels}"
    Height="{Binding PresenceSizePixels}"
    Background="Transparent"
    CanResize="False"
    IsHitTestVisible="True"
    ShowActivated="False"
    ShowInTaskbar="False"
    WindowDecorations="None"
    Topmost="True"
    TransparencyLevelHint="Transparent"
    WindowStartupLocation="Manual">
  <controls:PresenceControl
      State="{Binding State}"
      IsSpeaking="{Binding IsSpeaking}"
      DotSizePercent="{Binding PresenceDotSizePercent}"
      MovementSpeedPercent="{Binding PresenceMovementSpeedPercent}"
      Cursor="SizeAll"
      IsHitTestVisible="True" />
</Window>
