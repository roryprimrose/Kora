<Window x:Class="Kora.NewRequestWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="New request — fresh session only" Icon="/Assets/Kora.ico"
    Width="840" Height="760" MinWidth="660" MinHeight="580"
    Background="{DynamicResource KoraWindowBackgroundBrush}"
    Foreground="{DynamicResource KoraForegroundBrush}" WindowStartupLocation="CenterScreen">
</Window>
