<ResourceDictionary xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Kora">
  <local:ObservationChoicesConverter x:Key="ObservedResultChoices" />
  <DataTemplate x:Key="ConversationMessageTemplate">
    <StackPanel Spacing="4">
      <TextBlock Text="{Binding Sequence, StringFormat='USER message sequence {0}'}" />
      <TextBlock Text="{Binding Request.RequestId.Value, StringFormat='Original request {0}'}" TextWrapping="Wrap" />
      <TextBlock Text="{Binding Request.TaskId.Value, StringFormat='Original task {0}'}" TextWrapping="Wrap" />
      <TextBlock Text="{Binding SubmittedAt, StringFormat='Submitted UTC {0:O}'}" />
      <TextBlock Name="OriginalMessageText" Text="{Binding Body}" TextWrapping="Wrap" Focusable="True" />
      <StackPanel IsVisible="{Binding HasAssistantResponse}">
        <TextBlock Text="ASSISTANT - finalized admitted local-model answer (not original USER or effect evidence)" />
        <TextBlock Name="RetainedAssistantText" Text="{Binding AssistantResponse.Body}" TextWrapping="Wrap" Focusable="True"
            AutomationProperties.Name="Complete finalized retained ASSISTANT text, inert read-only data separate from original USER and typed HOST status" />
        <Button Name="ReplyToAssistantAnswer" Content="_Reply to this answer"
            IsEnabled="{Binding $parent[Window].DataContext.CanReplyToAnswer}"
            AutomationProperties.Name="Reply to this exact displayed retained assistant answer in the same Active conversation; review and separate local-only confirmation required" />
        <TextBlock Text="{Binding AssistantResponse.Provenance.Turn.Value, StringFormat='Host-owned model turn {0}'}" TextWrapping="Wrap" />
        <ItemsControl ItemsSource="{Binding Converter={StaticResource ObservedResultChoices}}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Name="OpenObservedResult" Content="{Binding Label}"
                  IsEnabled="{Binding $parent[Window].DataContext.CanOpenConversationDetails}"
                  AutomationProperties.Name="{Binding Label}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Button Name="ReviewRegisteredSettingSuggestion" Content="Review setting suggestion..."
            IsEnabled="{Binding $parent[Window].DataContext.CanReviewRegisteredSettingSuggestion}"
            AutomationProperties.Name="Review this exact inert answer as one registered shared setting proposal; nothing is applied without separate original-user confirmation" />
        <Button Name="ReviewModelMemoryProposal" Content="Review session-memory proposal..."
            IsEnabled="{Binding $parent[Window].DataContext.CanReviewModelMemoryProposal}"
            AutomationProperties.Name="Explicitly inspect this exact answer as one inert session-only memory proposal; separate acceptance and admission, never automatic learning" />
      </StackPanel>
      <TextBlock Text="{Binding Outcome, TargetNullValue='Pending / inspect task recovery', StringFormat='HOST status: {0}'}" />
      <TextBlock Text="{Binding Reason, StringFormat='HOST reason: {0}'}" />
      <TextBlock Text="{Binding ExpectedTaskState, StringFormat='HOST task status: {0}'}" />
      <local:ClarificationExchangeView Workspace="{Binding $parent[Window].DataContext}" />
      <Button Name="OpenConversationDetail" Content="Details - exact original USER / separate HOST"
          IsEnabled="{Binding $parent[Window].DataContext.CanOpenConversationDetails}"
          AutomationProperties.Name="Explicit passive Details for this exact retained original USER record and separate typed HOST outcome; no clipboard authority" />
      <Button Name="ReviewOriginalMessageReuse" Content="Review reuse of this original USER text in a New request"
          IsEnabled="{Binding $parent[Window].DataContext.CanReviewOriginalMessageReuse}"
          AutomationProperties.Name="Review complete exact retained original USER text and historical attribution; separate confirmation copies to New request memory only, never replay, HOST output, Save or Submit" />
    </StackPanel>
  </DataTemplate>
</ResourceDictionary>
