<Window x:Class="Kora.SessionsWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Kora.Controls"
    Title="Sessions - bounded durable workspace" Icon="/Assets/Kora.ico"
    Width="1050" Height="760" MinWidth="800" MinHeight="560"
    Background="{DynamicResource KoraWindowBackgroundBrush}"
    Foreground="{DynamicResource KoraForegroundBrush}" WindowStartupLocation="CenterScreen">
  <Grid Margin="24" RowDefinitions="Auto,Auto,Auto,Auto,*,Auto" RowSpacing="12">
    <StackPanel Orientation="Horizontal" Spacing="10">
      <TextBlock Text="Sessions (Active / Done)" FontSize="20" FontWeight="SemiBold" />
      <Button x:Name="Refresh" Content="_Refresh" IsEnabled="{Binding CanRead}" />
      <Button x:Name="Next" Content="Next session page" IsEnabled="{Binding CanNext}" />
    </StackPanel>
    <controls:NamedTextBlock Grid.Row="1" Text="{Binding Status}" TextWrapping="Wrap" AutomationProperties.Name="Sessions status and unavailable reasons" />
    <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
      <TextBox Text="{Binding NameDraft, Mode=TwoWay}" MaxLength="240" IsEnabled="{Binding CanRead}"
               PlaceholderText="Name: NFC Unicode, up to 120 scalars / 480 UTF-8 bytes"
               AutomationProperties.Name="Session name draft; names never resolve authority" />
      <Button Grid.Column="1" x:Name="CreateSession" Content="_Create empty Active session" IsEnabled="{Binding CanCreate}" />
      <Button Grid.Column="2" x:Name="RenameSession" Content="Re_name selected ID" IsEnabled="{Binding CanRename}"
              AutomationProperties.Name="Rename the exact selected session ID using its generation and metadata revision; does not resume" />
    </Grid>
    <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="10">
      <TextBox Text="{Binding HistorySessionId, Mode=TwoWay}" Width="320" IsEnabled="{Binding CanRead}"
               AutomationProperties.Name="Exact immutable session ID for passive history; names do not select sessions" />
      <Button x:Name="ReadHistory" Content="_Read exact history" IsEnabled="{Binding CanHistory}"
              AutomationProperties.Name="Read bounded ordered session history without resuming, replying, replaying or changing voice target" />
      <Button x:Name="NextHistory" Content="Next history snapshot page" IsEnabled="{Binding CanNextHistory}" />
    </StackPanel>
    <Grid Grid.Row="4" ColumnDefinitions="320,*" ColumnSpacing="14">
      <ListBox x:Name="Records" ItemsSource="{Binding Sessions}" IsEnabled="{Binding CanRead}"
               AutomationProperties.Name="Durable session names, exact IDs, lifecycle and optimistic revisions">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel>
              <TextBlock Text="{Binding Metadata.Name.Value, TargetNullValue='Unnamed session', FallbackValue='Unnamed session'}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding Authority.SessionId.Value}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding Authority.IsActive, StringFormat='Active: {0} (false means Done)'}" />
              <TextBlock Text="{Binding Authority.Generation.Value, StringFormat='Generation: {0}'}" />
              <TextBlock Text="{Binding Metadata.Revision.Value, TargetNullValue='Metadata not yet set', FallbackValue='Metadata not yet set', StringFormat='Metadata revision: {0}'}" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <Grid Grid.Column="1" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="10">
        <ComboBox x:Name="TaskRecords" ItemsSource="{Binding TaskRecords}" IsEnabled="{Binding CanRead}"
                  AutomationProperties.Name="Exact task records from the current selected session page; selection is passive">
          <ComboBox.ItemTemplate>
            <DataTemplate><TextBlock Text="{Binding Request.TaskId.Value}" /></DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <ComboBox Grid.Row="1" x:Name="QueueEntries" ItemsSource="{Binding QueueRecords}" IsEnabled="{Binding CanRead}"
                  AutomationProperties.Name="Exact current-run local-version queue entries; select an ID to cancel only before admission">
          <ComboBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{Binding Request.TaskId.Value}" />
                <TextBlock Text="{Binding State}" />
                <TextBlock Text="{Binding Revision.Value, StringFormat='revision {0}'}" />
              </StackPanel>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <WrapPanel Grid.Row="2">
          <Button x:Name="ReadQueue" Content="Read exact queue" IsEnabled="{Binding CanReadQueue}" />
          <Button x:Name="EnqueueVersion" Content="Enqueue local version" IsEnabled="{Binding CanControlQueue}" />
          <Button x:Name="DispatchQueue" Content="Dispatch ready local versions fairly" IsEnabled="{Binding CanControlQueue}"
                  AutomationProperties.Name="Explicit manual bounded fair dispatch among already enqueued current-run sessions; no effect or provider execution" />
          <Button x:Name="CancelQueueEntry" Content="Cancel displayed queued ID" IsEnabled="{Binding CanCancelQueueEntry}" />
          <Button x:Name="ClearQueue" Content="Confirm clear displayed pending queue" IsEnabled="{Binding CanControlQueue}"
                  AutomationProperties.Name="Explicitly confirm removal of the displayed pending queue at its exact revision; active work and history remain" />
        </WrapPanel>
        <ScrollViewer Grid.Row="3">
          <controls:NamedTextBlock Text="{Binding Detail}" TextWrapping="Wrap" FontFamily="Consolas"
                     AutomationProperties.Name="Typed question, exact task and evidence details; inspection is not approval" />
        </ScrollViewer>
      </Grid>
    </Grid>
    <WrapPanel Grid.Row="5">
      <Button x:Name="NextQuestions" Content="Next questions" IsEnabled="{Binding CanNextQuestions}" />
      <Button x:Name="NextTasks" Content="Next tasks" IsEnabled="{Binding CanNextTasks}" />
      <Button x:Name="InspectTask" Content="Inspect exact selected task" IsEnabled="{Binding CanInspectTask}" />
      <Button x:Name="CancelTask" Content="Cancel inspected pre-dispatch wait" IsEnabled="{Binding CanCancelTask}" />
      <Button x:Name="Evidence" Content="Read selected evidence" IsEnabled="{Binding CanEvidence}" />
      <Button x:Name="NextEvidence" Content="Next evidence" IsEnabled="{Binding CanNextEvidence}" />
      <Button x:Name="Done" Content="Mark selected ID _Done" IsEnabled="{Binding CanDone}" AutomationProperties.Name="Explicitly mark the displayed selected session ID Done using its expected generation" />
      <Button x:Name="Resume" Content="Explicitly res_ume selected ID" IsEnabled="{Binding CanResume}" AutomationProperties.Name="Explicitly resume the displayed selected session ID without task or approval replay" />
      <Button x:Name="PreviewDisposition" Content="Preview logical disposition" IsEnabled="{Binding CanPreviewDisposition}"
              AutomationProperties.Name="Preview exact selected session ID, revisions, live rows to remove and retained copies; does not delete" />
      <Button x:Name="ConfirmDisposition" Content="Confirm logical disposition" IsEnabled="{Binding CanConfirmDisposition}"
              AutomationProperties.Name="Explicitly confirm the previewed exact session logical disposition; not forensic deletion" />
      <Button x:Name="CloseView" Content="_Close" />
    </WrapPanel>
  </Grid>
</Window>
