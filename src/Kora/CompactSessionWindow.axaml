<Window x:Class="Kora.CompactSessionWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Kora.Controls"
    Title="Kora - selected session conversation" Icon="/Assets/Kora.ico"
    Width="620" Height="740" MinWidth="420" MinHeight="420"
    Background="{DynamicResource KoraWindowBackgroundBrush}"
    Foreground="{DynamicResource KoraForegroundBrush}" WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="/ConversationPresentation.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>
  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="18" Spacing="8">
      <TextBlock Text="Selected session — native conversation" FontSize="20" FontWeight="SemiBold" />
      <WrapPanel>
        <Button x:Name="Sessions" Content="_Sessions / explicit selection" />
        <Button x:Name="NewRequest" Content="_New request (fresh target)" />
      </WrapPanel>
      <controls:NamedTextBlock Text="{Binding ComposerTarget}" TextWrapping="Wrap"
          AutomationProperties.Name="Shared exact selected ID, name, generation, metadata and saved draft revisions, private control epoch" />
      <TextBlock Text="{Binding SelectedSessionRecord.Authority.IsActive, TargetNullValue='No selected target', StringFormat='Observed Active lifecycle: {0}'}" />
      <controls:NamedTextBlock Text="{Binding WorkStatus}" TextWrapping="Wrap"
          AutomationProperties.Name="Observed exact selected-session work source and time; not inferred execution or current success" />
      <TextBlock Text="No target? Open Sessions and explicitly select one. Opening never selects, loads bodies, resumes work or grants permission. Questions, approvals and voice stay in their existing windows." TextWrapping="Wrap" />
      <WrapPanel>
        <Button x:Name="ReadConversation" Content="Read exact conversation / saved revision" IsEnabled="{Binding CanReadConversation}" />
        <Button x:Name="NextConversation" Content="Next bounded page" IsEnabled="{Binding CanNextConversation}" />
        <Button x:Name="RefreshWork" Content="Refresh observed work" IsEnabled="{Binding CanRefreshWork}" />
      </WrapPanel>
      <controls:ScrollableListBox ItemsSource="{Binding ConversationMessages}" MaxHeight="200"
          ItemTemplate="{StaticResource ConversationMessageTemplate}"
          AutomationProperties.Name="Original USER messages and separate typed HOST outcomes; inert native text, not assistant output" />
      <TextBox x:Name="ConversationQuery" Text="{Binding ConversationQuery, Mode=TwoWay}" IsEnabled="{Binding CanReadConversation}"
          PlaceholderText="Search retained USER words or typed HOST outcome/reason/task state in only this exact selected session"
          AutomationProperties.Name="Shared private exact-session conversation lexical query; memory-only, not composer input, a model instruction or global search" />
       <ComboBox x:Name="ConversationRole" ItemsSource="{Binding ConversationRoles}"
          SelectedItem="{Binding ConversationRole, Mode=TwoWay}" IsEnabled="{Binding CanReadConversation}"
          AutomationProperties.Name="Shared conversation search field filter: All original USER and typed HOST fields, USER original body only, HOST outcome reason and task state only; editing does not read" />
      <TextBlock Text="Inclusive original-message ranges (empty means Any). Minimum must not exceed maximum; all ranges AND with the query, role and terminal predicates." TextWrapping="Wrap" />
      <TextBlock Text="Exact request ID (empty means Any)" />
      <TextBox x:Name="ConversationRequestId" Text="{Binding ConversationRequestId, Mode=TwoWay}" IsEnabled="{Binding CanReadConversation}"
          AutomationProperties.Name="Shared exact conversation request ID; canonical lowercase nonempty D GUID, empty means Any; AND with all predicates; editing does not read" />
      <TextBlock Text="Exact task ID (empty means Any)" />
      <TextBox x:Name="ConversationTaskId" Text="{Binding ConversationTaskId, Mode=TwoWay}" IsEnabled="{Binding CanReadConversation}"
          AutomationProperties.Name="Shared exact conversation task ID; canonical lowercase nonempty D GUID, empty means Any; AND with all predicates; editing does not read" />
      <TextBlock Text="Request/task IDs are passive correlation metadata only. They cannot retarget a session or task, establish identity, intent, ownership, permission, approval or execution authority." TextWrapping="Wrap" />
      <TextBlock Text="Minimum message sequence" />
      <TextBox x:Name="ConversationMinimumSequence" Text="{Binding ConversationMinimumSequence, Mode=TwoWay}" IsEnabled="{Binding CanReadConversation}"
          AutomationProperties.Name="Shared inclusive minimum original message sequence; invariant decimal within conversation limits, empty means Any; editing does not read" />
      <TextBlock Text="Maximum message sequence" />
      <TextBox x:Name="ConversationMaximumSequence" Text="{Binding ConversationMaximumSequence, Mode=TwoWay}" IsEnabled="{Binding CanReadConversation}"
          AutomationProperties.Name="Shared inclusive maximum original message sequence; invariant decimal within conversation limits, empty means Any; editing does not read" />
      <TextBlock Text="Submitted from UTC (yyyy-MM-ddTHH:mm:ss.fffffff+00:00)" />
      <TextBox x:Name="ConversationSubmittedFrom" Text="{Binding ConversationSubmittedFrom, Mode=TwoWay}" IsEnabled="{Binding CanReadConversation}"
          AutomationProperties.Name="Shared inclusive submitted from canonical UTC time; yyyy-MM-ddTHH:mm:ss.fffffff+00:00, empty means Any; editing does not read" />
      <TextBlock Text="Submitted through UTC (yyyy-MM-ddTHH:mm:ss.fffffff+00:00)" />
      <TextBox x:Name="ConversationSubmittedThrough" Text="{Binding ConversationSubmittedThrough, Mode=TwoWay}" IsEnabled="{Binding CanReadConversation}"
          AutomationProperties.Name="Shared inclusive submitted through canonical UTC time; yyyy-MM-ddTHH:mm:ss.fffffff+00:00, empty means Any; editing does not read" />
      <TextBlock Text="Exact terminal HOST predicates (Any means unrestricted). USER-only with any predicate yields zero; all predicates AND with the query and role." TextWrapping="Wrap" />
      <TextBlock Text="Terminal outcome" />
      <ComboBox x:Name="ConversationOutcome" ItemsSource="{Binding ConversationOutcomes}"
          SelectedItem="{Binding ConversationOutcomeChoice, Mode=TwoWay}" IsEnabled="{Binding CanReadConversation}"
          AutomationProperties.Name="Shared exact terminal HOST ModelTurnOutcome; Any or one defined outcome; editing does not read" />
      <TextBlock Text="Terminal reason" />
      <ComboBox x:Name="ConversationReason" ItemsSource="{Binding ConversationReasons}"
          SelectedItem="{Binding ConversationReasonChoice, Mode=TwoWay}" IsEnabled="{Binding CanReadConversation}"
          AutomationProperties.Name="Shared exact terminal HOST ModelTurnReason; Any or one defined reason; editing does not read" />
      <TextBlock Text="Expected terminal task state" />
      <ComboBox x:Name="ConversationTaskState" ItemsSource="{Binding ConversationTaskStates}"
          SelectedItem="{Binding ConversationTaskStateChoice, Mode=TwoWay}" IsEnabled="{Binding CanReadConversation}"
          AutomationProperties.Name="Shared exact terminal HOST expected HostTaskState; Any or one defined state; editing does not read" />
      <WrapPanel>
        <Button x:Name="SearchConversation" Content="Search this conversation" IsEnabled="{Binding CanSearchConversation}" />
        <Button x:Name="NextConversationSearch" Content="Next conversation matches" IsEnabled="{Binding CanNextConversationSearch}" />
        <Button x:Name="CancelConversationSearch" Content="Cancel conversation search" IsEnabled="{Binding CanCancelConversationSearch}" />
        <Button x:Name="ClearConversationSearch" Content="Clear private conversation search" />
      </WrapPanel>
      <controls:NamedTextBlock Text="{Binding ConversationSearchStatus}" TextWrapping="Wrap"
          AutomationProperties.Name="Shared conversation search counters, exact snapshot continuation and explicit failures; no model context" />
      <controls:ScrollableListBox x:Name="ConversationSearchResults" ItemsSource="{Binding ConversationSearchMessages}" MaxHeight="160"
          ItemTemplate="{StaticResource ConversationMessageTemplate}"
          AutomationProperties.Name="Shared exact immutable USER messages matching lexical words or typed HOST status; inert native text, chronological, no export or actions" />
      <TextBlock Text="Submit privately retains the original USER body with the actual HOST outcome. Production generation is unavailable; no runtime fallback, history context, network or tools. Structural credential checks cannot guarantee secret-free text. Draft edits are memory-only; both windows edit the same buffer." TextWrapping="Wrap" />
      <TextBox x:Name="ConversationComposer" Text="{Binding ComposerBody, Mode=TwoWay}" AcceptsReturn="True"
          Height="110" TextWrapping="Wrap" IsEnabled="{Binding CanCompose}"
          PlaceholderText="Original body: at most 4096 UTF-16 characters / 16384 UTF-8 bytes; rejected, never truncated"
          AutomationProperties.Name="Shared exact-session memory draft, not question input or approval" />
      <WrapPanel>
        <Button x:Name="SaveConversationDraft" Content="Explicitly Save draft" IsEnabled="{Binding CanSaveConversationDraft}" />
        <Button x:Name="ReloadConversationDraft" Content="Reload saved draft" IsEnabled="{Binding CanReloadConversationDraft}" />
        <Button x:Name="DiscardComposer" Content="Discard shared memory buffer only" IsEnabled="{Binding CanReadConversation}" />
        <Button x:Name="ReviewClearConversationDraft" Content="Review Clear saved draft" IsEnabled="{Binding CanReviewClearConversationDraft}" />
        <Button x:Name="ClearConversationDraft" Content="Confirm exact saved draft Clear" IsEnabled="{Binding CanClearConversationDraft}" />
        <Button x:Name="SubmitConversation" Content="Submit exact message — unavailable provider" IsEnabled="{Binding CanSubmitConversation}" />
      </WrapPanel>
      <TextBlock Text="{Binding SavedConversationDraftReview}" TextWrapping="Wrap"
          AutomationProperties.Name="Exact saved body under clear review, inert data" />
      <controls:NamedTextBlock Text="{Binding ConversationStatus}" TextWrapping="Wrap"
          AutomationProperties.Name="Actual shared conversation save, submission, unavailable or recovery outcome" />
      <Button x:Name="CloseView" Content="_Close compact view (work unchanged)" HorizontalAlignment="Right" />
    </StackPanel>
  </ScrollViewer>
</Window>
