<Window x:Class="Kora.EvidenceWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Evidence - read-only local inspection" Icon="/Assets/Kora.ico"
    Width="1120" Height="780" MinWidth="860" MinHeight="620"
    Background="{DynamicResource KoraWindowBackgroundBrush}"
    Foreground="{DynamicResource KoraForegroundBrush}" WindowStartupLocation="CenterScreen" />
