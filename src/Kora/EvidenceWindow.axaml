<Window
    x:Class="Kora.EvidenceWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Kora"
    xmlns:controls="using:Kora.Controls"
    x:DataType="local:EvidenceViewModel"
    Title="Evidence - read-only local inspection"
    Icon="/Assets/Kora.ico"
    Width="1120" Height="780" MinWidth="860" MinHeight="620"
    Background="{DynamicResource KoraWindowBackgroundBrush}"
    Foreground="{DynamicResource KoraForegroundBrush}"
    WindowStartupLocation="CenterScreen">
  <Grid Margin="24" RowDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto" RowSpacing="12">
    <TextBlock Text="Evidence - SQLite; DailyLog; opt-in CombinedLog ordinary diagnostics" FontSize="20" FontWeight="SemiBold" />
    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10">
      <ComboBox ItemsSource="{Binding Sources}" SelectedItem="{Binding Source}" MinWidth="130"
                AutomationProperties.Name="Evidence source" />
      <TextBox Text="{Binding SafeText}" PlaceholderText="Safe text contains (max 256 characters)" Width="330"
               ContextMenu="{x:Null}" ContextFlyout="{x:Null}"
               AutomationProperties.Name="Safe evidence text filter" />
      <Button x:Name="Search" Content="Search / refresh" IsEnabled="{Binding CanQuery}"
              AutomationProperties.Name="Search a fresh bounded evidence snapshot" />
      <Button x:Name="Next" Content="Next page" IsEnabled="{Binding CanNext}" />
      <Button x:Name="Trace" Content="Read selected trace" IsEnabled="{Binding CanReadTrace}" />
    </StackPanel>
    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="10">
      <TextBox Text="{Binding SessionFilter}" PlaceholderText="Session GUID (correlation filter only)" Width="300"
               ContextMenu="{x:Null}" ContextFlyout="{x:Null}"
               AutomationProperties.Name="Session correlation filter" />
      <TextBox Text="{Binding TaskFilter}" PlaceholderText="Task GUID" Width="300"
               ContextMenu="{x:Null}" ContextFlyout="{x:Null}"
               AutomationProperties.Name="Task correlation filter" />
      <TextBox Text="{Binding TraceFilter}" PlaceholderText="W3C trace ID" Width="300"
               ContextMenu="{x:Null}" ContextFlyout="{x:Null}"
               AutomationProperties.Name="Trace correlation filter" />
    </StackPanel>
    <Expander Grid.Row="3" Header="Advanced filters (optional)" IsExpanded="False"
              AutomationProperties.Name="Optional advanced evidence filters">
      <StackPanel Spacing="8">
        <WrapPanel>
          <TextBox Text="{Binding RequestFilter}" PlaceholderText="Exact request GUID" Width="300" Margin="0,0,10,8"
                   ContextMenu="{x:Null}" ContextFlyout="{x:Null}" AutomationProperties.Name="Exact request ID filter" />
          <TextBox Text="{Binding InvocationFilter}" PlaceholderText="Exact invocation GUID" Width="300" Margin="0,0,10,8"
                   ContextMenu="{x:Null}" ContextFlyout="{x:Null}" AutomationProperties.Name="Exact invocation ID filter" />
          <TextBox Text="{Binding ApprovalFilter}" PlaceholderText="Exact approval GUID" Width="300" Margin="0,0,10,8"
                   ContextMenu="{x:Null}" ContextFlyout="{x:Null}" AutomationProperties.Name="Exact approval ID filter" />
          <TextBox Text="{Binding CorrelationFilter}" PlaceholderText="Exact audit correlation GUID" Width="300" Margin="0,0,10,8"
                   ContextMenu="{x:Null}" ContextFlyout="{x:Null}" AutomationProperties.Name="Exact audit correlation ID filter" />
        </WrapPanel>
        <WrapPanel>
          <TextBox Text="{Binding FromFilter}" PlaceholderText="From inclusive: 2026-10-10T00:00:00Z" Width="380" Margin="0,0,10,8"
                   ContextMenu="{x:Null}" ContextFlyout="{x:Null}" AutomationProperties.Name="Inclusive evidence time range start" />
          <TextBox Text="{Binding UntilFilter}" PlaceholderText="Until inclusive: ISO time with Z or offset" Width="380" Margin="0,0,10,8"
                   ContextMenu="{x:Null}" ContextFlyout="{x:Null}" AutomationProperties.Name="Inclusive evidence time range end" />
        </WrapPanel>
        <StackPanel Orientation="Horizontal" Spacing="10">
          <ComboBox ItemsSource="{Binding Severities}" SelectedItem="{Binding Severity}" PlaceholderText="Any severity"
                    MinWidth="180" AutomationProperties.Name="Optional exact diagnostic severity filter" />
          <ComboBox ItemsSource="{Binding AuditOutcomes}" SelectedItem="{Binding AuditOutcome}" PlaceholderText="Any audit outcome"
                    MinWidth="210" AutomationProperties.Name="Optional exact typed audit outcome filter" />
          <Button x:Name="ClearAdvanced" Content="Clear advanced filters"
                  AutomationProperties.Name="Unset all advanced evidence filters without reading" />
        </StackPanel>
        <TextBlock TextWrapping="Wrap"
                   Text="Blank means unset; Clear advanced filters resets typed choices to Any. GUIDs are correlation only, never permission. Both time edges are inclusive; ISO Z or explicit offsets normalize to UTC. SQLite/AuthorityAudit use commit time; DailyLog uses observation time; CombinedLog uses each source's own time, not an atomic snapshot. Severity requires All, Log, Audit, DailyLog or CombinedLog; audit outcome requires All, Audit or AuthorityAudit. Changing any filter clears results; search again." />
      </StackPanel>
    </Expander>
    <controls:NamedTextBlock Grid.Row="4" Text="{Binding Status}" TextWrapping="Wrap"
               AutomationProperties.Name="Evidence status and storage limitations" />
    <Grid Grid.Row="5" ColumnDefinitions="320,*" ColumnSpacing="14">
      <Grid RowDefinitions="*,Auto,*">
        <controls:ScrollableListBox x:Name="Records" ItemsSource="{Binding Records}" AutomationProperties.Name="Cited evidence records">
          <ListBox.ItemTemplate>
            <DataTemplate><TextBlock Text="{Binding Reference.Citation}" TextWrapping="Wrap" /></DataTemplate>
          </ListBox.ItemTemplate>
        </controls:ScrollableListBox>
        <TextBlock Grid.Row="1" Text="Parent / explicit links (select, then Open segment)" Margin="0,12" TextWrapping="Wrap" />
        <controls:ScrollableListBox x:Name="Segments" Grid.Row="2" ItemsSource="{Binding Segments}"
                 AutomationProperties.Name="Trace parent and link segment availability">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel>
                <TextBlock Text="{Binding TraceId}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding SpanId}" />
                <TextBlock Text="{Binding Status}" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </controls:ScrollableListBox>
      </Grid>
      <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Disabled">
        <controls:NamedTextBlock Text="{Binding ResultText}" TextWrapping="Wrap" FontFamily="Consolas"
                   AutomationProperties.Name="Bounded structured evidence result, read only, no copy or export" />
      </ScrollViewer>
    </Grid>
    <StackPanel Grid.Row="6" Orientation="Horizontal" Spacing="10">
      <Button x:Name="OpenSegment" Content="Open selected segment" IsEnabled="{Binding CanQuery}" />
      <Button x:Name="CloseView" Content="Close" />
      <TextBlock Text="No copy, export, model, browser, deletion or execution." VerticalAlignment="Center" />
    </StackPanel>
  </Grid>
</Window>
