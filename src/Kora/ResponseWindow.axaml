<Window
    x:Class="Kora.ResponseWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Kora.Controls"
    xmlns:local="using:Kora"
    xmlns:chrome="using:Avalonia.Controls.Chrome"
    Classes="compact"
    Title="{Binding AssistantName}"
    Width="560"
    Height="690"
    MinWidth="480"
    MinHeight="570"
    Background="{DynamicResource KoraWindowBackgroundBrush}"
    CanResize="True"
    CanMaximize="False"
    ShowActivated="False"
    ShowInTaskbar="True"
    WindowDecorations="BorderOnly"
    ExtendClientAreaToDecorationsHint="True"
    ExtendClientAreaTitleBarHeightHint="32"
    Topmost="{Binding IsResponseWindowTopmost}"
    KeyDown="OnCancelTaskKeyDown"
    WindowStartupLocation="Manual">
  <Window.Styles>
    <StyleInclude Source="/Controls/ButtonStyles.axaml" />
    <Style Selector="Border#CurrentInteractionContent">
      <Setter Property="Margin" Value="12" />
      <Setter Property="Background" Value="{DynamicResource KoraPresencePanelBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource KoraBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="16" />
    </Style>
    <Style Selector="Window.compact Border#CompactFrame">
      <Setter Property="Background" Value="{DynamicResource KoraPresencePanelBrush}" />
    </Style>
    <Style Selector="Grid#WindowSurface">
      <Setter Property="Background" Value="{DynamicResource KoraWindowBackgroundBrush}" />
    </Style>
    <Style Selector="Window.compact Grid#WindowSurface">
      <Setter Property="Background" Value="{DynamicResource KoraPresencePanelBrush}" />
    </Style>
    <Style Selector="Window.compact Border#CurrentInteractionContent">
      <Setter Property="Margin" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="Window.compact Grid#ResponseLayout">
      <Setter Property="Width" Value="{Binding #ResponseViewport.Viewport.Width}" />
    </Style>
    <Style Selector="TextBlock">
      <Setter Property="Cursor" Value="Arrow" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button">
      <Setter Property="Cursor" Value="Arrow" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="Cursor" Value="Ibeam" />
    </Style>
    <Style Selector="Button.caption">
      <Setter Property="Width" Value="46" />
      <Setter Property="Height" Value="32" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.caption:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource KoraSurfaceAltBrush}" />
    </Style>
    <Style Selector="Button#CloseWorkbench:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#C42B1C" />
      <Setter Property="Foreground" Value="White" />
    </Style>
  </Window.Styles>
  <Grid x:Name="WindowSurface" RowDefinitions="Auto,*">
    <Border x:Name="WorkbenchCaption"
        Background="{DynamicResource KoraWindowBackgroundBrush}"
        chrome:WindowDecorationProperties.ElementRole="TitleBar">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="{Binding AssistantName}" Margin="12,0" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button x:Name="ExpandSessions" Classes="caption" Click="OnExpandSessionsClicked"
              chrome:WindowDecorationProperties.ElementRole="User"
              ToolTip.Tip="Expand to the full workbench"
              AutomationProperties.Name="Expand to the full workbench"
              AutomationProperties.HelpText="Switch this compact window to the expanded view without sending a message.">
            <Path Data="M 0,5 L 0,0 L 5,0 M 0,0 L 5,5 M 7,7 L 12,12 M 7,12 L 12,12 L 12,7"
                Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.5" Width="12" Height="12" />
          </Button>
          <Button x:Name="CollapseWorkbench" Classes="caption" Click="OnCollapseSessionsClicked" IsVisible="False"
              chrome:WindowDecorationProperties.ElementRole="User"
              ToolTip.Tip="Collapse to compact window" AutomationProperties.Name="Collapse to compact window">
            <Path Data="M 0,0 L 5,5 M 0,5 L 5,5 L 5,0 M 7,7 L 12,12 M 7,12 L 7,7 L 12,7"
                Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.5" Width="12" Height="12" />
          </Button>
          <Button x:Name="MinimizeWorkbench" Classes="caption" Click="OnMinimizeWorkbench"
              chrome:WindowDecorationProperties.ElementRole="MinimizeButton"
              ToolTip.Tip="Minimize" AutomationProperties.Name="Minimize">
            <Path Data="M 0,5 L 10,5" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1" Width="10" Height="10" />
          </Button>
          <Button x:Name="MaximizeWorkbench" Classes="caption" Click="OnMaximizeWorkbench" IsEnabled="False"
              chrome:WindowDecorationProperties.ElementRole="MaximizeButton"
              ToolTip.Tip="Maximize" AutomationProperties.Name="Maximize">
            <Path x:Name="MaximizeGlyph" Data="M 0,0 L 10,0 L 10,10 L 0,10 Z"
                Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1" Width="10" Height="10" />
          </Button>
          <Button x:Name="CloseWorkbench" Classes="caption" Click="OnCloseWorkbench"
              chrome:WindowDecorationProperties.ElementRole="CloseButton"
              ToolTip.Tip="Close" AutomationProperties.Name="Close">
            <Path Data="M 0,0 L 10,10 M 10,0 L 0,10" Stroke="{Binding $parent[Button].Foreground}"
                StrokeThickness="1" Width="10" Height="10" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>
  <ScrollViewer x:Name="ResponseViewport" Focusable="True"
      Grid.Row="1"
      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
      AutomationProperties.Name="Current response and controls; scroll to read and operate">
  <Grid x:Name="ResponseLayout" MinWidth="480" MinHeight="570">
  <Border x:Name="CompactFrame">
  <Grid RowDefinitions="Auto,Auto,*">
    <Grid Margin="12,8,12,0" ColumnDefinitions="*,Auto">
      <WrapPanel>
      <Button x:Name="ShowCurrentInteraction" Classes="compact-action" Click="OnCurrentInteractionClicked" IsVisible="False"
          ToolTip.Tip="Current interaction" AutomationProperties.Name="Current interaction">
        <PathIcon Data="M 2,2 L 14,2 L 14,11 L 7,11 L 3,15 L 3,11 L 2,11 Z" />
      </Button>
      <local:SessionDictationButton x:Name="SessionDictation" Classes="compact-action" DataContext="{x:Null}"
          IsEnabled="{Binding CanCompose}" IsVisible="False" ToolTip.Tip="Dictate session message">
        <PathIcon Data="M 6,1 L 10,1 L 10,9 L 6,9 Z M 3,6 L 4,6 L 4,10 L 7,12 L 7,14 L 5,14 L 5,15 L 11,15 L 11,14 L 9,14 L 9,12 L 12,10 L 12,6 L 13,6 L 13,11 L 10,13 L 6,13 L 3,11 Z" />
      </local:SessionDictationButton>
      <TextBlock x:Name="CompactLayoutStatus" TextWrapping="Wrap" MaxWidth="400"
          AutomationProperties.Name="Response layout availability" />
      </WrapPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
      <Button x:Name="ResponseMoreActions" Classes="compact-action"
          IsVisible="{Binding #CurrentInteractionContent.IsVisible}"
          ToolTip.Tip="More response actions" AutomationProperties.Name="More response actions">
        <PathIcon Data="M 2,7 L 4,7 L 4,9 L 2,9 Z M 7,7 L 9,7 L 9,9 L 7,9 Z M 12,7 L 14,7 L 14,9 L 12,9 Z" />
        <Button.Flyout>
          <MenuFlyout>
            <MenuItem x:Name="CurrentResponseDetails" Header="Current response details"
                Click="OnCurrentResponseDetailsClicked" />
            <MenuItem Header="Read current response" Command="{Binding ReadCurrentResponseCommand}"
                AutomationProperties.Name="Read this current ordinary response aloud once"
                ToolTip.Tip="Read this response once using normal speech, privacy and output admission." />
            <Separator />
            <MenuItem Header="Review speak once during call" Command="{Binding ReviewCallSpeechCommand}" />
            <MenuItem Header="Confirm speak once" Command="{Binding ConfirmCallSpeechCommand}" />
            <MenuItem Header="Cancel call speech" Command="{Binding CancelCallSpeechCommand}" />
            <MenuItem Header="Call speech status" Command="{Binding GetCallSpeechStatusCommand}"
                ToolTip.Tip="{Binding CallSpeechStatus}" />
            <Separator />
            <MenuItem x:Name="BeginReviewedVoiceCommand" Header="Review one spoken command" Click="OnBeginReviewedVoiceCommand"
                IsEnabled="{Binding !IsReviewedVoiceCommandActive}" />
            <Separator />
            <MenuItem x:Name="DismissResponse" Header="Dismiss response" Click="OnDismissClicked" />
          </MenuFlyout>
        </Button.Flyout>
      </Button>
      </StackPanel>
    </Grid>
    <WrapPanel x:Name="ExpandedControls" Grid.Row="1" Margin="24,0" IsVisible="False">
      <TextBlock Text="{Binding AssistantName}" FontWeight="SemiBold" Margin="0,6,12,0" />
      <Button x:Name="CollapseSessions" Content="Collapse" Click="OnCollapseSessionsClicked" IsVisible="False" />
      <Button x:Name="ShowNativeReviews" Content="Review tabs" Click="OnShowNativeReviews" IsVisible="False"
          AutomationProperties.Name="Show original native review tab headers; a retired review still requires fresh source admission" />
      <TextBlock Text="Question or approval waiting" IsVisible="{Binding IsResponseInteractionPending}"
          Margin="10,6" FontWeight="SemiBold" />
      <Button x:Name="RefreshSubmittedActivity" Content="Refresh submitted activity" Click="OnRefreshSubmittedActivity" />
      <Button x:Name="StopSubmittedActivity" Content="Review stop all work" Click="OnStopSubmittedActivity" />
      <TextBlock x:Name="SubmittedActivityStatus" Text="{Binding SubmittedWorkActivityStatus}" TextWrapping="Wrap" MaxWidth="720"
          AutomationProperties.Name="Submitted work activity and recovery" AutomationProperties.LiveSetting="Polite" />
    </WrapPanel>
    <Grid x:Name="WorkbenchContent" Grid.Row="2" ColumnDefinitions="Auto,*,0,0" RowDefinitions="*,Auto">
      <StackPanel x:Name="WorkbenchActivities" IsVisible="False" Width="56" Spacing="8" Margin="0,12"
          Background="{DynamicResource KoraWindowBackgroundBrush}">
        <Button x:Name="SessionsActivity" Content="Chat" Click="OnSessionsActivity"
            AutomationProperties.Name="Sessions workbench view" ToolTip.Tip="Sessions" />
        <Button x:Name="WorkActivity" Content="Work" Click="OnWorkActivity"
            AutomationProperties.Name="Work and attention workbench view" ToolTip.Tip="Work and attention" />
        <Button x:Name="SettingsActivity" Content="Set" Click="OnSettingsActivity"
            AutomationProperties.Name="Settings workbench view" ToolTip.Tip="Settings" />
        <Button x:Name="HelpActivity" Content="Help" Click="OnHelpActivity"
            AutomationProperties.Name="Help workbench view" ToolTip.Tip="Help" />
        <Button x:Name="PermissionsActivity" Content="Perm" Click="OnPermissionsActivity"
            AutomationProperties.Name="Permission grants workbench view" ToolTip.Tip="Permissions" />
        <Button x:Name="AuditActivity" Content="Audit" Click="OnAuditActivity"
            AutomationProperties.Name="Audit and diagnostics workbench view" ToolTip.Tip="Audit and diagnostics" />
        <Button x:Name="CustomizationsActivity" Content="Cust" Click="OnCustomizationsActivity"
            AutomationProperties.Name="Customizations workbench view" ToolTip.Tip="Customizations" />
      </StackPanel>
    <local:SessionInteractionView x:Name="SessionWorkspace" Grid.Column="1" IsVisible="False" DataContext="{x:Null}" />
    <ContentControl x:Name="HostedViewContent" Grid.Column="1" IsVisible="False" />
    <GridSplitter x:Name="NativeReviewDivider" Grid.Column="2" Width="6" IsVisible="False"
        ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Focusable="True"
        AutomationProperties.Name="Resize native review supporting pane" />
    <ContentControl x:Name="NativeReviewContent" Grid.Column="3" IsVisible="False"
        ZIndex="5"
        AutomationProperties.Name="Supporting original native reviews, separate from generated artifacts" />
    <ScrollViewer x:Name="InlineQuestionViewport" Grid.Column="1" Grid.Row="1" IsVisible="False"
        MaxHeight="460" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
        AutomationProperties.Name="Original live questions and exact permission input; selected chat never retargets them">
      <StackPanel x:Name="InlineQuestions" Spacing="8" Margin="12" />
    </ScrollViewer>
  <Border x:Name="CurrentInteractionContent" Grid.Column="1"
      Padding="22">
    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="12">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="4">
          <TextBlock Text="{Binding StateLabel}" Classes="eyebrow" />
          <TextBlock
              Text="{Binding ResponseTitle}"
              FontSize="22"
              FontWeight="SemiBold"
              TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
          <Button
              x:Name="CancelResponseTask" Classes="compact-action"
              ToolTip.Tip="Cancel task" AutomationProperties.Name="Cancel task"
              IsVisible="{Binding IsCancelTaskVisible}"
              Click="OnCancelTaskClicked">
            <PathIcon Data="M 3,3 L 13,3 L 13,13 L 3,13 Z" />
          </Button>
          <Button
              x:Name="StopResponseSpeech" Classes="compact-action"
              IsVisible="{Binding IsSpeaking}" Command="{Binding StopSpeechCommand}"
              ToolTip.Tip="Stop speaking" AutomationProperties.Name="Stop speaking">
            <PathIcon Data="M 2,6 L 5,6 L 9,2 L 9,14 L 5,10 L 2,10 Z M 12,5 L 14,7 L 16,5 L 17,6 L 15,8 L 17,10 L 16,11 L 14,9 L 12,11 L 11,10 L 13,8 L 11,6 Z" />
          </Button>
        </StackPanel>
      </Grid>

      <ScrollViewer x:Name="ResponseBodyViewport" Grid.Row="1" MaxHeight="150" Focusable="True"
          VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Current response text; scroll to read full response">
        <TextBlock x:Name="ResponseBodyText"
            Text="{Binding ResponseBody}"
            Classes="muted"
            FontSize="12"
            LineHeight="19"
            TextWrapping="Wrap" />
      </ScrollViewer>

      <Border
          Grid.Row="2"
          Padding="12"
          Background="{DynamicResource KoraSurfaceAltBrush}"
          CornerRadius="9">
        <StackPanel Spacing="5">
          <TextBlock Text="LAST TRANSCRIPT" Classes="eyebrow" />
          <TextBlock Text="{Binding Transcript}" FontSize="11" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <StackPanel
          Grid.Row="3"
          Spacing="6">
        <TextBlock Text="{Binding PendingQuestionNavigationStatus}" Classes="muted" FontSize="11" TextWrapping="Wrap"
                   AutomationProperties.Name="Pending question navigation status" />
        <TextBlock Text="{Binding ReadCurrentResponseStatus}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
        <StackPanel IsVisible="{Binding HasResponseReadProposal}" Spacing="6">
          <TextBlock Text="{Binding ResponseReadProposalReview}" TextWrapping="Wrap"
                     AutomationProperties.Name="Exact current answer read proposal review" />
          <WrapPanel>
            <Button Content="Interpret read request locally" Command="{Binding PlanCurrentResponseReadCommand}" />
            <Button Content="Confirm captured answer read once" Command="{Binding ConfirmCurrentResponseReadCommand}" />
            <Button Content="Cancel answer read proposal" Command="{Binding CancelCurrentResponseReadCommand}" />
          </WrapPanel>
        </StackPanel>
        <StackPanel Spacing="6" IsVisible="{Binding IsProtectedCall}">
          <TextBlock Text="{Binding CallSpeechStatus}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel IsVisible="{Binding IsDetailsOfferPending}" Spacing="6">
          <TextBlock Text="Would you like to view the detailed response?" TextWrapping="Wrap" />
          <WrapPanel>
            <Button Content="Yes, show details" Click="OnCurrentResponseDetailsClicked"
                AutomationProperties.Name="Accept the offer to view this exact current response" />
            <Button Content="Not now" Click="OnDeclineDetailsOffer"
                AutomationProperties.Name="Decline this detail offer without discarding the result" />
          </WrapPanel>
        </StackPanel>
        <ItemsControl ItemsSource="{Binding WebResultDetailActions}" IsVisible="{Binding HasWebResultDetails}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Spacing="5">
              <Button Content="Open exact web-result details"
                      AutomationProperties.Name="Open exact web-result details"
                      Tag="{Binding}"
                      Click="OnWebResultDetailsClicked"
                      HorizontalAlignment="Left" />
              <Button Content="Review local summary of this exact web result"
                      Tag="{Binding}" Click="OnWebSummaryClicked" HorizontalAlignment="Left" />
              <Button Content="Open in external browser"
                      Tag="{Binding}" Click="OnExternalBrowserClicked" HorizontalAlignment="Left" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="{Binding WebResultDetailStatus}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
        <TextBlock Text="{Binding WebSummaryStatus}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
        <ItemsControl ItemsSource="{Binding WebSummaryConfirmations}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Content="Use this exact web result with the local model"
                      Tag="{Binding}" Click="OnWebSummaryConfirmed" HorizontalAlignment="Left" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <ScrollViewer MaxHeight="180">
          <TextBlock Text="{Binding WebSummaryText}" FontSize="12" TextWrapping="Wrap" />
        </ScrollViewer>
        <ItemsControl ItemsSource="{Binding ResponseActions}" IsVisible="{Binding HasResponseActions}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button
                  Classes="response-link"
                  Tag="{Binding}"
                  Click="OnResponseActionClicked">
                <TextBlock Text="{Binding Label}" TextDecorations="Underline" />
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <StackPanel Grid.Row="4" Spacing="6">
        <ItemsControl ItemsSource="{Binding ModelActionReviews}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal" Spacing="10">
                <controls:ModelActionReviewButton Classes="primary" Content="Once" Click="OnApproveModelActionOnce"
                    IsEnabled="{Binding $parent[Window].DataContext.CanConfirmModelActionReview}" />
                <controls:ModelActionReviewButton Content="This session" Click="OnApproveModelActionForSession"
                    IsEnabled="{Binding $parent[Window].DataContext.CanConfirmReusableModelActionReview}" />
                <controls:ModelActionReviewButton Content="Always" Click="OnApproveModelActionAlways"
                    IsEnabled="{Binding $parent[Window].DataContext.CanConfirmReusableModelActionReview}" />
                <controls:ModelActionReviewButton Content="Reject" Click="OnRejectModelAction"
                    IsEnabled="{Binding $parent[Window].DataContext.CanRejectModelActionReview}" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="{Binding ModelActionReviewStatus}" TextWrapping="Wrap"
                   AutomationProperties.LiveSetting="Polite" />
      </StackPanel>

      <StackPanel Grid.Row="5" Spacing="6" IsVisible="{Binding IsGrantEditorVisible}">
        <TextBlock Text="Choose exact grant change" Classes="eyebrow" />
        <ComboBox ItemsSource="{Binding GrantActions}" SelectedItem="{Binding SelectedGrantAction}" DisplayMemberBinding="{Binding Action}" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <ComboBox ItemsSource="{Binding GrantOperations}" SelectedItem="{Binding SelectedGrantOperation}" />
          <ComboBox ItemsSource="{Binding GrantScopes}" SelectedItem="{Binding SelectedGrantScope}" />
          <TextBlock Text="to" VerticalAlignment="Center" />
          <ComboBox ItemsSource="{Binding GrantScopes}" SelectedItem="{Binding SelectedGrantTargetScope}" />
          <Button Content="Prepare" Command="{Binding PrepareGrantChangeCommand}" />
        </StackPanel>
      </StackPanel>

      <StackPanel Grid.Row="6" Orientation="Horizontal" Spacing="10" IsVisible="{Binding IsGrantChangePending}">
        <Button Classes="primary" Content="Confirm grant change" Command="{Binding ConfirmGrantChangeCommand}" />
        <Button Content="Reject" Command="{Binding RejectGrantChangeCommand}" />
      </StackPanel>

      <StackPanel Grid.Row="7" Spacing="6" IsVisible="{Binding IsModelQuestionPending}">
        <TextBlock Text="CHOOSE AN OPTION (NOT AN APPROVAL)" Classes="eyebrow" />
        <TextBlock Text="Choose a suggestion or type or speak your own answer." Classes="muted" FontSize="11" />
        <ScrollViewer MaxHeight="170" VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding ModelQuestionChoices}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Tag="{Binding}" Click="OnQuestionChoiceClicked"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,2">
                  <TextBlock Text="{Binding DisplayText}" TextWrapping="Wrap" MaxWidth="390" />
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        <Button Content="Cancel question" Click="OnCancelQuestionClicked" HorizontalAlignment="Left" />
      </StackPanel>

      <Border Grid.Row="8"
              IsVisible="{Binding IsArtifactCommandDropdownVisible}"
              MaxHeight="190"
              Padding="5"
              Background="{DynamicResource KoraSurfaceAltBrush}"
              BorderBrush="{DynamicResource KoraBorderBrush}"
              BorderThickness="1"
              CornerRadius="7">
        <controls:ScrollableListBox x:Name="ArtifactCommandList"
                 ItemsSource="{Binding ArtifactCommandOptions}"
                 AutomationProperties.Name="Available artifact slash commands">
          <ListBox.Styles>
            <Style Selector="ListBoxItem">
              <Setter Property="AutomationProperties.Name" Value="{Binding Command}" />
            </Style>
          </ListBox.Styles>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Button Tag="{Binding}"
                      AutomationProperties.Name="{Binding Command}"
                      Click="OnArtifactCommandClicked"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Left"
                      Padding="8,5">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                  <TextBlock Text="{Binding Command}" FontWeight="SemiBold" />
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Name}" />
                    <TextBlock Text="{Binding Description}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
                  </StackPanel>
                  <TextBlock Grid.Column="2" Text="{Binding Source}" Classes="muted" FontSize="10" />
                </Grid>
              </Button>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </controls:ScrollableListBox>
      </Border>

      <StackPanel Grid.Row="9" Spacing="8">
        <TextBlock Text="{Binding ReviewedVoiceCommandStatus}" TextWrapping="Wrap" FontSize="11" />
        <WrapPanel>
          <Button x:Name="FinishReviewedVoiceCommand" Classes="compact-action" Click="OnFinishReviewedVoiceCommand"
              ToolTip.Tip="Finish capture" AutomationProperties.Name="Finish capture"
              IsVisible="{Binding IsReviewedVoiceCommandActive}" IsEnabled="{Binding !HasReviewedVoiceCommand}">
            <PathIcon Data="M 3,3 L 13,3 L 13,13 L 3,13 Z" />
          </Button>
          <Button x:Name="CancelReviewedVoiceCommand" Classes="compact-action" Click="OnCancelReviewedVoiceCommand"
              ToolTip.Tip="Cancel reviewed command" AutomationProperties.Name="Cancel reviewed command"
              IsVisible="{Binding IsReviewedVoiceCommandActive}">
            <PathIcon Data="M 2,3 L 3,2 L 8,7 L 13,2 L 14,3 L 9,8 L 14,13 L 13,14 L 8,9 L 3,14 L 2,13 L 7,8 Z" />
          </Button>
        </WrapPanel>
        <TextBox x:Name="ReviewedVoiceCommandInput"
            IsVisible="{Binding HasReviewedVoiceCommand}" TextChanged="OnReviewedVoiceCommandTextChanged"
            AutomationProperties.Name="Exact command transcript; edit without executing"
            AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="110" />
        <Button x:Name="ConfirmReviewedVoiceCommand" Content="Dispatch this exact voice command once" Click="OnConfirmReviewedVoiceCommand"
            IsVisible="{Binding HasReviewedVoiceCommand}" />
      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="9">
        <TextBox
            x:Name="CommandInput"
            MaxWidth="{Binding #ResponseViewport.Viewport.Width}"
            Text="{Binding CommandText}"
            AutomationProperties.Name="Typed command or artifact slash input"
            PlaceholderText="{Binding CommandInputPlaceholder}"
            KeyDown="OnCommandTextKeyDown"
            VerticalContentAlignment="Center" />
        <Button
            Grid.Column="1"
            x:Name="PushToTalkButton"
            Classes="compact-action"
            IsVisible="{Binding IsPushToTalkVisible}"
            AutomationProperties.Name="Push to talk; hold while speaking"
            ToolTip.Tip="Push to talk (hold)">
          <PathIcon Data="M 6,1 L 10,1 L 10,9 L 6,9 Z M 3,6 L 4,6 L 4,10 L 7,12 L 7,14 L 5,14 L 5,15 L 11,15 L 11,14 L 9,14 L 9,12 L 12,10 L 12,6 L 13,6 L 13,11 L 10,13 L 6,13 L 3,11 Z" />
        </Button>
        <Button
            Grid.Column="2"
            x:Name="SubmitResponseCommand" Classes="primary compact-action"
            ToolTip.Tip="{Binding CommandSubmitLabel}" AutomationProperties.Name="{Binding CommandSubmitLabel}"
            Command="{Binding RunTypedCommand}">
          <PathIcon Data="M 2,2 L 15,8 L 2,14 L 5,8 Z M 5,8 L 15,8" />
        </Button>
      </Grid>
      </StackPanel>
    </Grid>
  </Border>
    </Grid>
  </Grid>
  </Border>
  </Grid>
  </ScrollViewer>
  </Grid>
</Window>
