<Project Sdk="WixToolset.Sdk/7.0.0">
  <PropertyGroup>
    <InstallerPlatform>x64</InstallerPlatform>
    <OutputName>Kora-$(ProductVersion)-win-x64</OutputName>
    <DefineConstants>ProductVersion=$(ProductVersion);ApplicationPayload=$(ApplicationPayload)</DefineConstants>
    <!-- e_sqlite3.dll has no version-resource language. Its explicit neutral fallback is verified by package inspection. -->
    <SuppressSpecificWarnings>$(SuppressSpecificWarnings);1101</SuppressSpecificWarnings>
  </PropertyGroup>
</Project>
