<Window
    x:Class="Kora.SettingsWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:configuration="clr-namespace:Kora.Core.Configuration;assembly=Kora.Core"
    xmlns:controls="using:Kora.Controls"
    Title="{Binding SettingsWindowTitle}"
    Icon="/Assets/Kora.ico"
    Width="1040"
    Height="760"
    MinWidth="860"
    MinHeight="620"
    Background="{DynamicResource KoraWindowBackgroundBrush}"
    Foreground="{DynamicResource KoraForegroundBrush}"
    WindowStartupLocation="CenterScreen">
  <Window.Styles>
    <Style Selector="NumericUpDown /template/ TextBox#PART_TextBox">
      <Setter Property="AutomationProperties.Name"
              Value="{Binding (AutomationProperties.Name), RelativeSource={RelativeSource TemplatedParent}}" />
    </Style>
    <Style Selector="NumericUpDown /template/ ButtonSpinner /template/ :is(Button)#PART_IncreaseButton">
      <Setter Property="AutomationProperties.Name"
              Value="{Binding $parent[NumericUpDown].(AutomationProperties.Name), StringFormat='Increase {0}'}" />
    </Style>
    <Style Selector="NumericUpDown /template/ ButtonSpinner /template/ :is(Button)#PART_DecreaseButton">
      <Setter Property="AutomationProperties.Name"
              Value="{Binding $parent[NumericUpDown].(AutomationProperties.Name), StringFormat='Decrease {0}'}" />
    </Style>
  </Window.Styles>
  <Grid RowDefinitions="72,Auto,*">
    <Border BorderBrush="{DynamicResource KoraHeaderBorderBrush}" BorderThickness="0,0,0,1" Padding="30,0">
      <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
        <Border Width="34" Height="34" Background="{DynamicResource KoraAccentBrush}" CornerRadius="9">
          <TextBlock
              Text="{Binding AssistantInitial}"
              Foreground="{DynamicResource KoraAccentForegroundBrush}"
              FontSize="23"
              FontWeight="SemiBold"
              HorizontalAlignment="Center"
              VerticalAlignment="Center" />
        </Border>
        <StackPanel Grid.Column="1" Margin="13,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="Settings" FontSize="20" FontWeight="SemiBold" />
          <TextBlock Text="{Binding SettingsSubtitle}" Classes="muted" FontSize="11" />
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Ellipse Width="7" Height="7" Fill="{DynamicResource KoraStatusBrush}" />
          <TextBlock Text="{Binding ListeningStatus}" Classes="muted" FontSize="11" />
        </StackPanel>
      </Grid>
    </Border>

    <TextBlock
        Grid.Row="1"
        Margin="30,12,30,0"
        Text="{Binding LocalStorageDisclosure}"
        Classes="muted"
        FontSize="11"
        TextWrapping="Wrap" />

    <controls:NavigableTabControl
        x:Name="SettingsTabs"
        Grid.Row="2"
        TabStripPlacement="Left"
        Margin="22"
        Background="Transparent">
      <TabItem Header="Appearance">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="30,4,30,30" Spacing="16" MaxWidth="700" HorizontalAlignment="Left">
            <StackPanel Spacing="5" Margin="0,0,0,8">
              <TextBlock Text="Appearance" FontSize="28" FontWeight="SemiBold" />
              <TextBlock
                  Text="{Binding AppearanceSettingsDescription}"
                  Classes="muted"
                  FontSize="13"
                  TextWrapping="Wrap" />
            </StackPanel>

            <TextBlock Text="{Binding AppearanceSettingStatus}" Classes="muted" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="12">
              <ComboBox ItemsSource="{Binding AppearanceOptions}" SelectedItem="{Binding SelectedAppearanceOption}" Width="340"
                        AutomationProperties.Name="Select an appearance option to inspect or change">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Description}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <Button Content="Reset selected option" Command="{Binding ResetAppearanceOptionCommand}"
                      AutomationProperties.Name="Reset the selected appearance option to its default" />
            </StackPanel>

            <Border Classes="settings-card">
              <Grid ColumnDefinitions="*,240" ColumnSpacing="24">
                <StackPanel Spacing="4">
                  <TextBlock Text="Show presence" Classes="settings-title" />
                  <TextBlock
                      Text="{Binding PresenceDisplayDescription}"
                      Classes="settings-description"
                      TextWrapping="Wrap" />
                </StackPanel>
                <CheckBox
                    Grid.Column="1"
                    Content="Show presence"
                    IsChecked="{Binding IsPresenceDisplayEnabled}"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Show animated presence" />
              </Grid>
            </Border>

            <Border Classes="settings-card">
              <Grid ColumnDefinitions="*,240" ColumnSpacing="24">
                <StackPanel Spacing="4">
                  <TextBlock Text="Application theme" Classes="settings-title" />
                  <TextBlock
                      Text="{Binding AppearanceThemeDescription}"
                      Classes="settings-description"
                      TextWrapping="Wrap" />
                </StackPanel>
                <ComboBox
                    Grid.Column="1"
                    ItemsSource="{Binding ThemeModes}"
                    SelectedItem="{Binding ThemeMode}"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Application theme" />
              </Grid>
            </Border>

            <StackPanel Spacing="5" Margin="0,8,0,0">
              <TextBlock Text="Visual feedback" FontSize="18" FontWeight="SemiBold" />
              <TextBlock
                  Text="Control how the presence and response window remain visible."
                  Classes="muted"
                  FontSize="12"
                  TextWrapping="Wrap" />
            </StackPanel>

            <Border Classes="settings-card">
              <Grid ColumnDefinitions="*,240" ColumnSpacing="24">
                <StackPanel Spacing="4">
                  <TextBlock Text="Always show responses" Classes="settings-title" />
                  <TextBlock
                      Text="Keep the response window visible until you dismiss it."
                      Classes="settings-description"
                      TextWrapping="Wrap" />
                </StackPanel>
                <CheckBox
                    Grid.Column="1"
                    Content="Always show"
                    IsChecked="{Binding IsResponseAlwaysVisible}"
                    VerticalAlignment="Center" />
              </Grid>
            </Border>

            <Border Classes="settings-card">
              <Grid ColumnDefinitions="*,240" ColumnSpacing="24">
                <StackPanel Spacing="4">
                  <TextBlock Text="Keep responses on top" Classes="settings-title" />
                  <TextBlock
                      Text="Keep the response window above other application windows."
                      Classes="settings-description"
                      TextWrapping="Wrap" />
                </StackPanel>
                <CheckBox
                    Grid.Column="1"
                    Content="Stay on top"
                    IsChecked="{Binding IsResponseWindowTopmost}"
                    VerticalAlignment="Center" />
              </Grid>
            </Border>

            <Border Classes="settings-card">
              <Grid ColumnDefinitions="*,240" ColumnSpacing="24">
                <StackPanel Spacing="4">
                  <TextBlock Text="Response timeout" Classes="settings-title" />
                  <TextBlock
                      Text="{Binding ResponseTimeoutDescription}"
                      Classes="settings-description"
                      TextWrapping="Wrap" />
                </StackPanel>
                <NumericUpDown
                    Grid.Column="1"
                    AutomationProperties.Name="Response timeout in seconds"
                    Value="{Binding ResponseTimeoutSeconds}"
                    Minimum="{Binding Source={x:Static configuration:ResponseWindowSettings.MinimumTimeoutSeconds}}"
                    Maximum="{Binding Source={x:Static configuration:ResponseWindowSettings.MaximumTimeoutSeconds}}"
                    Increment="1"
                    FormatString="0"
                    VerticalAlignment="Center" />
              </Grid>
            </Border>

            <StackPanel Spacing="5" Margin="0,8,0,0">
              <TextBlock Text="Presence appearance" FontSize="18" FontWeight="SemiBold" />
              <TextBlock
                  Text="Animated dots that communicate the assistant's current state."
                  Classes="muted"
                  FontSize="12"
                  TextWrapping="Wrap" />
            </StackPanel>

            <Border Classes="settings-card">
              <Grid ColumnDefinitions="*,240" ColumnSpacing="24">
                <StackPanel Spacing="4">
                  <TextBlock Text="Presence timeout" Classes="settings-title" />
                  <TextBlock
                      Text="{Binding PresenceTimeoutDescription}"
                      Classes="settings-description"
                      TextWrapping="Wrap" />
                </StackPanel>
                <NumericUpDown
                    Grid.Column="1"
                    AutomationProperties.Name="Presence timeout in seconds"
                    Value="{Binding PresenceTimeoutSeconds}"
                    Minimum="{Binding Source={x:Static configuration:PresenceSettings.MinimumTimeoutSeconds}}"
                    Maximum="{Binding Source={x:Static configuration:PresenceSettings.MaximumTimeoutSeconds}}"
                    Increment="1"
                    FormatString="0"
                    VerticalAlignment="Center" />
              </Grid>
            </Border>

            <Border Classes="settings-card">
              <Grid ColumnDefinitions="*,240" ColumnSpacing="24">
                <StackPanel Spacing="4">
                  <TextBlock Text="Presence size" Classes="settings-title" />
                  <TextBlock
                      Text="{Binding PresenceSizeDescription}"
                      Classes="settings-description"
                      TextWrapping="Wrap" />
                </StackPanel>
                <Slider
                    Grid.Column="1"
                    Value="{Binding PresenceSizePixels}"
                    Minimum="{Binding Source={x:Static configuration:PresenceSettings.MinimumSizePixels}}"
                    Maximum="{Binding Source={x:Static configuration:PresenceSettings.MaximumSizePixels}}"
                    TickFrequency="20"
                    IsSnapToTickEnabled="True"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Presence size in pixels" />
              </Grid>
            </Border>

            <Border Classes="settings-card">
              <Grid ColumnDefinitions="*,240" ColumnSpacing="24">
                <StackPanel Spacing="4">
                  <TextBlock Text="Dot size" Classes="settings-title" />
                  <TextBlock
                      Text="{Binding PresenceDotSizeDescription}"
                      Classes="settings-description"
                      TextWrapping="Wrap" />
                </StackPanel>
                <Slider
                    Grid.Column="1"
                    Value="{Binding PresenceDotSizePercent}"
                    Minimum="{Binding Source={x:Static configuration:PresenceSettings.MinimumDotSizePercent}}"
                    Maximum="{Binding Source={x:Static configuration:PresenceSettings.MaximumDotSizePercent}}"
                    TickFrequency="10"
                    IsSnapToTickEnabled="True"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Dot size percent" />
              </Grid>
            </Border>

            <Border Classes="settings-card">
              <Grid ColumnDefinitions="*,240" ColumnSpacing="24">
                <StackPanel Spacing="4">
                  <TextBlock Text="Dot density" Classes="settings-title" />
                  <TextBlock
                      Text="{Binding PresenceDotDensityDescription}"
                      Classes="settings-description"
                      TextWrapping="Wrap" />
                </StackPanel>
                <Slider
                    Grid.Column="1"
                    Value="{Binding PresenceDotDensityPercent}"
                    Minimum="{Binding Source={x:Static configuration:PresenceSettings.MinimumDotDensityPercent}}"
                    Maximum="{Binding Source={x:Static configuration:PresenceSettings.MaximumDotDensityPercent}}"
                    TickFrequency="5"
                    IsSnapToTickEnabled="True"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Dot density percent" />
              </Grid>
            </Border>

            <Border Classes="settings-card">
              <Grid ColumnDefinitions="*,240" ColumnSpacing="24">
                <StackPanel Spacing="4">
                  <TextBlock Text="Movement speed" Classes="settings-title" />
                  <TextBlock
                      Text="{Binding PresenceMovementSpeedDescription}"
                      Classes="settings-description"
                      TextWrapping="Wrap" />
                </StackPanel>
                <Slider
                    Grid.Column="1"
                    Value="{Binding PresenceMovementSpeedPercent}"
                    Minimum="{Binding Source={x:Static configuration:PresenceSettings.MinimumMovementSpeedPercent}}"
                    Maximum="{Binding Source={x:Static configuration:PresenceSettings.MaximumMovementSpeedPercent}}"
                    TickFrequency="5"
                    IsSnapToTickEnabled="True"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Movement speed percent" />
              </Grid>
            </Border>

            <Border Classes="settings-card">
              <Grid ColumnDefinitions="*,240" ColumnSpacing="24">
                <StackPanel Spacing="4">
                  <TextBlock Text="Speech sizing" Classes="settings-title" />
                  <TextBlock
                      Text="{Binding PresenceSpeechScalingDescription}"
                      Classes="settings-description"
                      TextWrapping="Wrap" />
                </StackPanel>
                <CheckBox
                    Grid.Column="1"
                    Content="Scale with speech"
                    IsChecked="{Binding IsPresenceSpeechScalingEnabled}"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Scale presence with speech playback" />
              </Grid>
            </Border>

            <Border Classes="settings-card">
              <Grid ColumnDefinitions="*,240" ColumnSpacing="24">
                <StackPanel Spacing="4">
                  <TextBlock Text="Speech scale amount" Classes="settings-title" />
                  <TextBlock
                      Text="{Binding PresenceSpeechScaleAmountDescription}"
                      Classes="settings-description"
                      TextWrapping="Wrap" />
                </StackPanel>
                <Slider
                    Grid.Column="1"
                    Value="{Binding PresenceSpeechScaleAmountPercent}"
                    IsEnabled="{Binding IsPresenceSpeechScalingEnabled}"
                    Minimum="{Binding Source={x:Static configuration:PresenceSettings.MinimumSpeechScaleAmountPercent}}"
                    Maximum="{Binding Source={x:Static configuration:PresenceSettings.MaximumSpeechScaleAmountPercent}}"
                    TickFrequency="5"
                    IsSnapToTickEnabled="True"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Speech scale amount percent" />
              </Grid>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem x:Name="SpeechAudioTab" Header="Speech &amp; audio">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="30,4,30,30" Spacing="16" MaxWidth="700" HorizontalAlignment="Left">
            <StackPanel Spacing="5" Margin="0,0,0,8">
              <TextBlock Text="Speech &amp; audio" FontSize="28" FontWeight="SemiBold" />
              <TextBlock
                  Text="{Binding SpeechAudioSettingsDescription}"
                  Classes="muted"
                  FontSize="13" />
            </StackPanel>

            <Border Classes="settings-card">
              <Grid ColumnDefinitions="*,300" ColumnSpacing="24">
                <StackPanel Spacing="4">
                  <TextBlock Text="Display / PTT command-prefix name" Classes="settings-title" />
                  <TextBlock
                      Text="{Binding AssistantNameSettingStatus}"
                      Classes="settings-description"
                      TextWrapping="Wrap" />
                  <TextBlock
                      Text="{Binding AssistantNameConfigurationDescription}"
                      Classes="settings-description"
                      TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="8">
                  <TextBox
                      Text="{Binding AssistantNameInput, Mode=TwoWay}"
                      PlaceholderText="Assistant name" />
                  <Button
                      Classes="primary"
                      Content="Apply name"
                      Command="{Binding ApplyAssistantNameCommand}"
                      HorizontalAlignment="Stretch" />
                  <Button
                      Content="Reset name to Kora"
                      Command="{Binding ResetAssistantNameCommand}"
                      HorizontalAlignment="Stretch" />
                </StackPanel>
              </Grid>
            </Border>

            <Border Classes="settings-card">
              <Grid ColumnDefinitions="*,300" ColumnSpacing="24">
                <StackPanel Spacing="4">
                  <TextBlock Text="Microphone" Classes="settings-title" />
                  <TextBlock
                      Text="{Binding MicrophoneAccessMessage}"
                      Classes="settings-description"
                      FontWeight="SemiBold"
                      TextWrapping="Wrap" />
                  <TextBlock
                      Text="{Binding MicrophoneAvailabilityMessage}"
                      Classes="settings-description"
                      TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
                  <Button x:Name="ChooseMicrophone"
                      Content="Choose microphone (native recovery)"
                      HorizontalAlignment="Stretch" />
                  <Button
                      Content="Open Windows microphone settings"
                      Command="{Binding OpenMicrophonePrivacySettingsCommand}"
                      HorizontalAlignment="Stretch" />
                </StackPanel>
              </Grid>
            </Border>

            <Border Classes="settings-card">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24">
                <StackPanel Spacing="4">
                  <TextBlock Text="Voice consent and activation" Classes="settings-title" />
                  <TextBlock Text="{Binding ListeningStatus}" Classes="settings-description" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding VoiceConsentDescription}" Classes="settings-description" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
                  <Button Classes="primary" Content="Enable voice (save consent)" Command="{Binding EnableVoiceConsentCommand}" IsVisible="{Binding !HasVoiceConsent}" />
                  <Button Content="Continue without voice" Command="{Binding WithdrawVoiceConsentCommand}" IsVisible="{Binding !HasVoiceConsent}" />
                  <Button Content="Refresh microphones" Command="{Binding RefreshMicrophonesCommand}" />
                  <Button Classes="primary" Content="{Binding ListeningButtonText}" Command="{Binding ToggleListeningCommand}" IsVisible="{Binding HasVoiceConsent}" />
                  <Button Content="Withdraw voice consent" Command="{Binding WithdrawVoiceConsentCommand}" IsVisible="{Binding HasVoiceConsent}" />
                  <Button
                      x:Name="PushToTalkButton"
                      Content="Push to talk (hold)"
                      IsEnabled="{Binding IsVoiceEnabled}"
                      PointerCaptureLost="OnPushToTalkCaptureLost"
                      LostFocus="OnPushToTalkFocusLost" />
                </StackPanel>
              </Grid>
            </Border>

            <Border Classes="settings-card">
              <Grid ColumnDefinitions="*,300" ColumnSpacing="24">
                <StackPanel Spacing="4">
                  <TextBlock Text="Speech provider assets (review only)" Classes="settings-title" />
                  <TextBlock
                      Text="{Binding SpeechProviderAvailabilityMessage}"
                      Classes="settings-description"
                      TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="8">
                  <ComboBox
                      ItemsSource="{Binding SpeechProviders}"
                      SelectedItem="{Binding SelectedSpeechProvider}"
                      DisplayMemberBinding="{Binding Name}"
                      IsEnabled="{Binding !IsSpeechProviderOperationActive}"
                      PlaceholderText="No provider available" />
                  <ProgressBar
                      Minimum="0"
                      Maximum="100"
                      Value="{Binding SpeechProviderOperationProgress}"
                      IsVisible="{Binding IsSpeechProviderOperationActive}" />
                  <TextBlock
                      Text="{Binding SpeechProviderOperationStatus}"
                      Classes="muted"
                      FontSize="11"
                      TextWrapping="Wrap"
                      IsVisible="{Binding IsSpeechProviderOperationActive}" />
                  <Button
                      Classes="primary"
                      Content="{Binding SpeechProviderDownloadButtonText}"
                      Command="{Binding DownloadSpeechProviderCommand}"
                      IsVisible="{Binding CanDownloadSpeechProvider}" />
                  <Button
                      Content="Remove downloaded model"
                      Command="{Binding RemoveSpeechProviderCommand}"
                      IsVisible="{Binding CanRemoveSpeechProvider}" />
                </StackPanel>
              </Grid>
            </Border>

            <Border Classes="settings-card">
              <Grid ColumnDefinitions="*,300" ColumnSpacing="24">
                <StackPanel Spacing="4">
                  <TextBlock Text="Installed speech provider and voice" Classes="settings-title" />
                  <TextBlock
                      Text="{Binding VoiceAvailabilityMessage}"
                      Classes="settings-description"
                      TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="8">
                  <ComboBox
                      ItemsSource="{Binding InstalledSpeechProviders}"
                      SelectedItem="{Binding SelectedInstalledSpeechProvider}"
                      DisplayMemberBinding="{Binding Name}"
                      PlaceholderText="Choose a ready installed provider" />
                  <TextBlock Text="{Binding SpeechSettingStatus}" TextWrapping="Wrap" Classes="settings-description" />
                  <Button Content="Reset speech provider" Command="{Binding ResetSpeechProviderCommand}" />
                  <Button Content="Reset speech voice" Command="{Binding ResetSpeechVoiceCommand}" />
                  <ComboBox
                      ItemsSource="{Binding InstalledSpeechVoices}"
                      SelectedItem="{Binding SelectedVoice}"
                      PlaceholderText="No voice selected">
                    <ComboBox.ItemTemplate>
                      <DataTemplate>
                        <StackPanel>
                          <TextBlock Text="{Binding Name}" />
                          <TextBlock Text="{Binding ConfigurationId}" Classes="muted" FontSize="10" />
                          <TextBlock Text="{Binding Culture}" Classes="muted" FontSize="10" />
                        </StackPanel>
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <Button Content="Preview" Command="{Binding PreviewVoiceCommand}" />
                    <Button Grid.Column="1" Content="Stop" Command="{Binding StopSpeechCommand}" />
                  </Grid>
                </StackPanel>
              </Grid>
            </Border>

            <Border Classes="settings-card">
              <Grid ColumnDefinitions="*,300" ColumnSpacing="24">
                <StackPanel Spacing="4">
                  <TextBlock Text="Spoken summary limits" Classes="settings-title" />
                  <TextBlock Text="Ordinary results must fit both caps, including the spoken title. Over-cap results remain fully visual; no truncation or extra model call. Exact approval/question readback keeps its existing bounds."
                             TextWrapping="Wrap" Classes="settings-description" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="8">
                  <TextBlock Text="Maximum sentences (1-3)" Classes="settings-description" />
                  <ComboBox ItemsSource="{Binding SummarySentenceChoices}" SelectedItem="{Binding SelectedSummarySentences}" PlaceholderText="Invalid saved limits; repair and refresh" />
                  <Button Content="Reset sentence cap" Command="{Binding ResetSummarySentencesCommand}" />
                  <TextBlock Text="Maximum words (1-80)" Classes="settings-description" />
                  <ComboBox ItemsSource="{Binding SummaryWordChoices}" SelectedItem="{Binding SelectedSummaryWords}" PlaceholderText="Invalid saved limits; repair and refresh" />
                  <Button Content="Reset word cap" Command="{Binding ResetSummaryWordsCommand}" />
                  <TextBlock Text="{Binding SpeechSettingStatus}" TextWrapping="Wrap" Classes="settings-description" />
                </StackPanel>
              </Grid>
            </Border>

            <Border Classes="settings-card">
              <Grid ColumnDefinitions="*,300" ColumnSpacing="24">
                <StackPanel Spacing="4">
                  <TextBlock Text="Audio output" Classes="settings-title" />
                  <TextBlock
                      Text="{Binding AudioOutputConfigurationStatus}"
                      Classes="settings-description"
                      TextWrapping="Wrap" />
                  <TextBlock
                      Text="{Binding OutputDeviceAvailabilityMessage}"
                      Classes="settings-description"
                      TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="8">
                  <ComboBox ItemsSource="{Binding OutputDeviceChoices}" SelectedItem="{Binding SelectedOutputChoice}"
                      DisplayMemberBinding="{Binding Label}" IsEnabled="{Binding CanChangeAudioOutputDevice}"
                      PlaceholderText="Refresh and choose exact output" />
                  <Button Content="Refresh output metadata only" Command="{Binding RefreshOutputDevicesCommand}" IsEnabled="{Binding CanChangeAudioOutputDevice}" />
                  <Button Content="Save output preference only" Command="{Binding SaveOutputDeviceCommand}" IsEnabled="{Binding CanChangeAudioOutputDevice}" />
                  <Button Content="Reset output to System" Command="{Binding ResetOutputDeviceCommand}" IsEnabled="{Binding CanChangeAudioOutputDevice}" />
                </StackPanel>
              </Grid>
            </Border>

            <Border Classes="settings-card">
              <Grid ColumnDefinitions="*,300" ColumnSpacing="24">
                <StackPanel Spacing="4">
                  <TextBlock Text="Kora playback volume (0-100%)" Classes="settings-title" />
                  <TextBlock Text="Kora-owned speech only. 100 is the original unscaled level. Zero prevents synthesis and keeps the full response visual. Saving stops old output; raising/resetting never replays it. Windows, call volume, microphone and consent are unchanged."
                             TextWrapping="Wrap" Classes="settings-description" />
                  <TextBlock Text="{Binding PlaybackVolumeStatus}" TextWrapping="Wrap" Classes="settings-description" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="8">
                  <ComboBox ItemsSource="{Binding PlaybackVolumeChoices}" SelectedItem="{Binding SelectedPlaybackVolume}" IsEnabled="{Binding CanChangePlaybackVolume}" />
                  <Button Content="Refresh volume preference only" Command="{Binding RefreshPlaybackVolumeCommand}" IsEnabled="{Binding CanChangePlaybackVolume}" />
                  <Button Content="Save Kora volume only" Command="{Binding SavePlaybackVolumeCommand}" IsEnabled="{Binding CanChangePlaybackVolume}" />
                  <Button Content="Reset volume to 100%" Command="{Binding ResetPlaybackVolumeCommand}" IsEnabled="{Binding CanChangePlaybackVolume}" />
                </StackPanel>
              </Grid>
            </Border>

            <Border Classes="settings-card">
              <Grid ColumnDefinitions="*,300" ColumnSpacing="24">
                <StackPanel Spacing="4">
                  <TextBlock Text="Windows-native speech rate (-10 through 10)" Classes="settings-title" />
                  <TextBlock Text="Windows provider only; 0 is engine-normal/default/reset. Native units are not percent or words per minute. Kokoro is unsupported and unchanged. Saving retires active/queued speech; only future eligible Windows synthesis uses the rate. No replay, preview, microphone or global Windows setting change."
                             TextWrapping="Wrap" Classes="settings-description" />
                  <TextBlock Text="{Binding WindowsSpeechRateStatus}" TextWrapping="Wrap" Classes="settings-description" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="8">
                  <ComboBox ItemsSource="{Binding WindowsSpeechRateChoices}" SelectedItem="{Binding SelectedWindowsSpeechRate}" IsEnabled="{Binding CanChangeWindowsSpeechRateNative}" />
                  <Button Content="Refresh Windows rate preference only" Command="{Binding RefreshWindowsSpeechRateCommand}" IsEnabled="{Binding CanInspectWindowsSpeechRateNative}" />
                  <Button Content="Save Windows-native rate only" Command="{Binding SaveWindowsSpeechRateCommand}" IsEnabled="{Binding CanChangeWindowsSpeechRateNative}" />
                  <Button Content="Reset Windows rate to normal (0)" Command="{Binding ResetWindowsSpeechRateCommand}" IsEnabled="{Binding CanChangeWindowsSpeechRateNative}" />
                </StackPanel>
              </Grid>
            </Border>

            <Button
                Content="Refresh devices and readiness"
                Command="{Binding RefreshCommand}"
                HorizontalAlignment="Left" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Responses">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="30,4,30,30" Spacing="16" MaxWidth="700" HorizontalAlignment="Left">
            <StackPanel Spacing="5" Margin="0,0,0,8">
              <TextBlock Text="Responses" FontSize="28" FontWeight="SemiBold" />
              <TextBlock
                  Text="{Binding ResponseSettingsDescription}"
                  Classes="muted"
                  FontSize="13" />
            </StackPanel>

            <Border Classes="settings-card">
              <Grid ColumnDefinitions="*,260" ColumnSpacing="24">
                <StackPanel Spacing="4">
                  <TextBlock Text="Device default" Classes="settings-title" />
                  <TextBlock
                      Text="The persisted response mode used when no narrower override is active."
                      Classes="settings-description"
                      TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="8">
                  <ComboBox ItemsSource="{Binding ResponseModeChoices}" SelectedItem="{Binding SelectedResponseModeChoice}"
                      DisplayMemberBinding="{Binding Label}" IsEnabled="{Binding CanChangeResponseMode}"
                      PlaceholderText="Inspect and choose exact mode" />
                  <Button Content="Inspect response mode" Command="{Binding RefreshResponseModeCommand}" IsEnabled="{Binding CanChangeResponseMode}" />
                  <Button Content="Save device-default mode" Command="{Binding SaveResponseModeCommand}" IsEnabled="{Binding CanChangeResponseMode}" />
                  <Button Content="Reset device default to Hybrid" Command="{Binding ResetResponseModeCommand}" IsEnabled="{Binding CanChangeResponseMode}" />
                  <TextBlock Text="{Binding ResponseModeConfigurationStatus}" Classes="settings-description" TextWrapping="Wrap" />
                </StackPanel>
              </Grid>
            </Border>

            <Border Classes="settings-card">
              <Grid ColumnDefinitions="*,300" ColumnSpacing="24">
                <StackPanel Spacing="4">
                  <TextBlock Text="Local speech text (off by default)" Classes="settings-title" />
                  <TextBlock Text="Optional exact utterance after playback starts. Normal completion retains observed text for 0-30 seconds (default 5), or until unpinned. Stop, replacement and privacy retirement still clear immediately. Placement selects a primary-screen corner. No speech, replay, capture, model request or response/call policy changes. Sentence alignment is unavailable."
                      Classes="settings-description" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding SpeechTextConfigurationStatus}" Classes="settings-description" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="8">
                  <ComboBox ItemsSource="{Binding SpeechTextChoices}" SelectedItem="{Binding SelectedSpeechTextChoice}"
                      DisplayMemberBinding="{Binding Label}" IsEnabled="{Binding CanChangeSpeechText}"
                      PlaceholderText="Inspect and choose exact speech text mode"
                      AutomationProperties.Name="Local speech text mode" />
                  <Button Content="Inspect speech text" Command="{Binding RefreshSpeechTextCommand}" IsEnabled="{Binding CanChangeSpeechText}" />
                  <Button Content="Save speech text only" Command="{Binding SaveSpeechTextCommand}" IsEnabled="{Binding CanChangeSpeechText}" />
                  <Button Content="Reset speech text to Off" Command="{Binding ResetSpeechTextCommand}" IsEnabled="{Binding CanChangeSpeechText}" />
                  <ComboBox ItemsSource="{Binding SpeechCaptionOptionsList}" SelectedItem="{Binding SelectedSpeechCaptionOption}"
                      IsEnabled="{Binding CanChangeSpeechText}" AutomationProperties.Name="Speech caption option" />
                  <ComboBox ItemsSource="{Binding SpeechCaptionOptionChoices}" SelectedItem="{Binding SelectedSpeechCaptionChoice}"
                      DisplayMemberBinding="{Binding Label}" IsEnabled="{Binding CanChangeSpeechText}"
                      PlaceholderText="Inspect and choose exact caption option" AutomationProperties.Name="Speech caption option value" />
                  <Button Content="Save caption option only" Command="{Binding SaveSpeechCaptionOptionCommand}" IsEnabled="{Binding CanChangeSpeechText}" />
                  <Button Content="Reset selected caption option" Command="{Binding ResetSpeechCaptionOptionCommand}" IsEnabled="{Binding CanChangeSpeechText}" />
                </StackPanel>
              </Grid>
            </Border>

            <Border Classes="settings-card">
              <Grid ColumnDefinitions="*,260" ColumnSpacing="24">
                <StackPanel Spacing="4">
                  <TextBlock Text="Current queue" Classes="settings-title" />
                  <TextBlock
                      Text="A temporary override for work in the current queue. Choose Inherit to use the device default."
                      Classes="settings-description"
                      TextWrapping="Wrap" />
                </StackPanel>
                <ComboBox
                    Grid.Column="1"
                    ItemsSource="{Binding ResponseModeOverrideOptions}"
                    SelectedItem="{Binding QueueResponseModeOption}"
                    DisplayMemberBinding="{Binding Label}"
                    VerticalAlignment="Center" />
              </Grid>
            </Border>

            <Border Classes="settings-card">
              <Grid ColumnDefinitions="*,260" ColumnSpacing="24">
                <StackPanel Spacing="4">
                  <TextBlock Text="Current task" Classes="settings-title" />
                  <TextBlock
                      Text="The highest-precedence temporary output override. Choose Inherit to use the queue override or device default."
                      Classes="settings-description"
                      TextWrapping="Wrap" />
                </StackPanel>
                <ComboBox
                    Grid.Column="1"
                    ItemsSource="{Binding ResponseModeOverrideOptions}"
                    SelectedItem="{Binding TaskResponseModeOption}"
                    DisplayMemberBinding="{Binding Label}"
                    VerticalAlignment="Center" />
              </Grid>
            </Border>

            <Border Classes="settings-card">
              <Grid ColumnDefinitions="*,260" ColumnSpacing="24">
                <StackPanel Spacing="4">
                  <TextBlock Text="Muted speaker fallback" Classes="settings-title" />
                  <TextBlock
                      Text="Retained legacy preference. Unavailable, muted, zero-volume or failed output always keeps the complete visual response."
                      Classes="settings-description"
                      TextWrapping="Wrap" />
                </StackPanel>
                <CheckBox
                    Grid.Column="1"
                    Content="Stored legacy preference"
                    IsChecked="{Binding FallbackToVisualWhenOutputMuted}"
                    VerticalAlignment="Center" />
              </Grid>
            </Border>

            <Border Classes="settings-card" Background="{DynamicResource KoraSurfaceAltBrush}">
              <StackPanel Spacing="4">
                <TextBlock Text="Effective output" Classes="settings-title" />
                <TextBlock
                    Text="{Binding ResponseOutputStatus}"
                    Classes="settings-description"
                    TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Logging">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="30,4,30,30" Spacing="16" MaxWidth="700" HorizontalAlignment="Left">
            <TextBlock Text="Future-only retention" FontSize="28" FontWeight="SemiBold" />
            <Border Classes="settings-card">
              <StackPanel Spacing="8">
                <TextBlock Text="Ordinary SQLite diagnostic days (integer 1–365; default/reset 30)" Classes="settings-title" />
                <TextBlock Text="Future newly committed ordinary SQLite logs and spans only. Existing deadlines never change. Apply-now and immediate deletion are unavailable. Independently configured audit retention, daily files 30 days/30 files, session/history, all grants/approvals and cleanup triggers are unchanged."
                           Classes="settings-description" TextWrapping="Wrap" />
                <TextBlock Text="{Binding DiagnosticRetentionStatus}" Classes="settings-description" TextWrapping="Wrap" />
                <ComboBox ItemsSource="{Binding DiagnosticRetentionChoices}" SelectedItem="{Binding SelectedDiagnosticRetentionDays}" IsEnabled="{Binding CanChangeDiagnosticRetentionNative}" />
                <Button Content="Refresh SQLite retention only" Command="{Binding RefreshDiagnosticRetentionCommand}" IsEnabled="{Binding CanChangeDiagnosticRetentionNative}" />
                <Button Content="Save future SQLite retention only" Command="{Binding SaveDiagnosticRetentionCommand}" IsEnabled="{Binding CanChangeDiagnosticRetentionNative}" />
                <Button Content="Reset future SQLite retention to 30 days" Command="{Binding ResetDiagnosticRetentionCommand}" IsEnabled="{Binding CanChangeDiagnosticRetentionNative}" />
              </StackPanel>
            </Border>
            <Border Classes="settings-card">
              <StackPanel Spacing="8">
                <TextBlock Text="Audit metadata days (integer 30–365; default/reset 90)" Classes="settings-title" />
                <TextBlock Text="Only NEW committed required authority audit and independently qualified diagnostic audit projections. Existing deadlines and payloads never change. Requested/terminal preference receipts use the prior policy; confirmed activation affects later commits only. Apply-now, immediate deletion and audit pruning are unavailable. No grant expiry/retention/eviction, session/history, ordinary SQLite, file or cleanup-schedule changes."
                           Classes="settings-description" TextWrapping="Wrap" />
                <TextBlock Text="{Binding AuditRetentionStatus}" Classes="settings-description" TextWrapping="Wrap" />
                <ComboBox ItemsSource="{Binding AuditRetentionChoices}" SelectedItem="{Binding SelectedAuditRetentionDays}" IsEnabled="{Binding CanChangeAuditRetentionNative}" />
                <Button Content="Refresh audit retention only" Command="{Binding RefreshAuditRetentionCommand}" IsEnabled="{Binding CanChangeAuditRetentionNative}" />
                <Button Content="Save future audit retention only" Command="{Binding SaveAuditRetentionCommand}" IsEnabled="{Binding CanChangeAuditRetentionNative}" />
                <Button Content="Reset future audit retention to 90 days" Command="{Binding ResetAuditRetentionCommand}" IsEnabled="{Binding CanChangeAuditRetentionNative}" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Calls">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="30,4,30,30" Spacing="16" MaxWidth="700" HorizontalAlignment="Left">
            <StackPanel Spacing="5" Margin="0,0,0,8">
              <TextBlock Text="Calls" FontSize="28" FontWeight="SemiBold" />
              <TextBlock
                  Text="Use run-scoped manual call mode. Enabled automatic observations remain independent."
                  Classes="muted"
                  FontSize="13"
                  TextWrapping="Wrap" />
            </StackPanel>

            <Border Classes="settings-card" Background="{DynamicResource KoraSurfaceAltBrush}">
              <StackPanel Spacing="4">
                <TextBlock Text="Call detection" Classes="settings-title" />
                <controls:NamedTextBlock
                    Text="{Binding CallStateStatus}"
                    AutomationProperties.Name="Current call status"
                    AutomationProperties.LiveSetting="Polite"
                    Classes="settings-description"
                    TextWrapping="Wrap" />
              </StackPanel>
            </Border>

            <Border Classes="settings-card">
              <StackPanel Spacing="8">
                <TextBlock Text="Manual call mode" Classes="settings-title" />
                <controls:NamedTextBlock Text="{Binding CallManualStatus}" AutomationProperties.Name="Manual call status" AutomationProperties.LiveSetting="Polite" Classes="settings-description" TextWrapping="Wrap" />
                <controls:NamedTextBlock Text="{Binding ManualCallConfigurationStatus}" AutomationProperties.Name="Cached manual and automatic call policy status" Classes="settings-description" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Content="I'm in a call" AutomationProperties.Name="Enable manual call mode for this run" TabIndex="0" Command="{Binding EnableManualCallCommand}" />
                  <Button Content="Clear manual call mode" AutomationProperties.Name="Clear only manual call mode" TabIndex="1" Command="{Binding ClearManualCallCommand}" />
                  <Button Content="Reset manual off" AutomationProperties.Name="Reset manual call layer off for this run" TabIndex="2" Command="{Binding ResetManualCallCommand}" />
                  <Button Content="Cached call status" AutomationProperties.Name="Inspect cached call status without effects" TabIndex="3" Command="{Binding GetManualCallStatusCommand}" />
                </StackPanel>
                <TextBlock Text="{Binding CallProtectionLimitations}" Classes="settings-description" TextWrapping="Wrap" />
              </StackPanel>
            </Border>

            <Border Classes="settings-card">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24">
                <StackPanel Spacing="4">
                  <TextBlock Text="Call speech suppression (independent of feedback)" Classes="settings-title" />
                  <TextBlock
                      Text="{Binding CallVisualOverrideStatus}"
                      Classes="settings-description"
                      TextWrapping="Wrap" />
                </StackPanel>
                <Button
                    Grid.Column="1"
                    Content="{Binding CallVisualOverrideButtonText}"
                    Command="{Binding ToggleCallVisualOverrideCommand}"
                    IsEnabled="{Binding CanEnableCallVisualProtection}"
                    VerticalAlignment="Center" />
              </Grid>
            </Border>

            <Border Classes="settings-card">
              <StackPanel Spacing="8">
                <TextBlock Text="In-call feedback override" Classes="settings-title" />
                <TextBlock Text="UI by default. Active/Suspected calls select this before ordinary response modes; Inherit restores ordinary precedence. Voice/Both never permit suppressed speech. Unknown or unconfirmed state retains full visual recovery. Input, consent and grants are unchanged."
                    Classes="settings-description" TextWrapping="Wrap" />
                <ComboBox ItemsSource="{Binding InCallFeedbackChoices}" SelectedItem="{Binding SelectedInCallFeedbackChoice}"
                    DisplayMemberBinding="{Binding Label}" IsEnabled="{Binding CanChangeInCallFeedbackNative}"
                    AutomationProperties.Name="In-call feedback draft: Voice UI Both or Inherit" />
                <WrapPanel Orientation="Horizontal">
                  <Button Content="Refresh call feedback" Command="{Binding RefreshInCallFeedbackCommand}"
                      IsEnabled="{Binding CanInspectInCallFeedbackNative}" AutomationProperties.Name="Inspect in-call feedback preference only" />
                  <Button Content="Save call feedback only" Command="{Binding SaveInCallFeedbackCommand}"
                      IsEnabled="{Binding CanChangeInCallFeedbackNative}" AutomationProperties.Name="Save selected in-call feedback only" />
                  <Button Content="Reset call feedback to UI" Command="{Binding ResetInCallFeedbackCommand}"
                      IsEnabled="{Binding CanChangeInCallFeedbackNative}" AutomationProperties.Name="Remove saved in-call feedback override only" />
                </WrapPanel>
                <controls:NamedTextBlock Text="{Binding InCallFeedbackStatus}" AutomationProperties.Name="In-call feedback saved effective policy and recovery status"
                    AutomationProperties.LiveSetting="Polite" Classes="settings-description" TextWrapping="Wrap" />
              </StackPanel>
            </Border>

            <Border Classes="settings-card">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24">
                <StackPanel Spacing="4">
                  <TextBlock Text="Voice activation during calls" Classes="settings-title" />
                  <TextBlock
                      Text="{Binding CallVoiceActivationStatus}"
                      Classes="settings-description"
                      TextWrapping="Wrap" />
                </StackPanel>
                <Button
                    Grid.Column="1"
                    Content="{Binding CallVoiceActivationButtonText}"
                    Command="{Binding ToggleCallVoiceActivationCommand}"
                    IsEnabled="{Binding CanDisableCallVoiceActivation}"
                    VerticalAlignment="Center" />
              </Grid>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Models">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="30,4,30,30" Spacing="16" MaxWidth="700" HorizontalAlignment="Left">
            <StackPanel Spacing="5" Margin="0,0,0,8">
              <TextBlock Text="Model execution" FontSize="28" FontWeight="SemiBold" />
              <TextBlock
                  Text="Choose which model locations Kora may use for free-form commands. Exact built-in commands remain available when every model is disabled."
                  Classes="muted"
                  FontSize="13"
                  TextWrapping="Wrap" />
            </StackPanel>

            <Border Classes="settings-card">
              <Grid ColumnDefinitions="*,240" ColumnSpacing="24">
                <StackPanel Spacing="4">
                  <TextBlock Text="Local models" Classes="settings-title" />
                  <TextBlock
                      Text="Allow requests to use the verified Ollama model on this device. Turning this off cancels a running local request."
                      Classes="settings-description"
                      TextWrapping="Wrap" />
                </StackPanel>
                <CheckBox
                    Grid.Column="1"
                    Content="Allow local models"
                    IsChecked="{Binding LocalModelsEnabled}"
                    VerticalAlignment="Center" />
              </Grid>
            </Border>

            <Border Classes="settings-card">
              <Grid ColumnDefinitions="*,240" ColumnSpacing="24">
                <StackPanel Spacing="4">
                  <TextBlock Text="Hosted models" Classes="settings-title" />
                  <TextBlock
                      Text="{Binding HostedModelExecutionDescription}"
                      Classes="settings-description"
                      TextWrapping="Wrap" />
                  <TextBlock
                      Text="No hosted provider or credentials are included in this build. Enabling this permission does not send data by itself."
                      Classes="settings-description"
                      TextWrapping="Wrap" />
                </StackPanel>
                <CheckBox
                    Grid.Column="1"
                    Content="Allow hosted models"
                    IsChecked="{Binding HostedModelsEnabled}"
                    VerticalAlignment="Center" />
              </Grid>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem x:Name="ReadinessTab" Header="Readiness">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="30,4,30,30" Spacing="16" MaxWidth="700" HorizontalAlignment="Left">
            <StackPanel Spacing="5" Margin="0,0,0,8">
              <TextBlock Text="Readiness" FontSize="28" FontWeight="SemiBold" />
              <TextBlock
                  Text="{Binding ReadinessSettingsDescription}"
                  Classes="muted"
                  FontSize="13" />
            </StackPanel>

            <TextBlock Text="Setup tasks" Classes="settings-title" />
            <TextBlock Text="Local model inference (Ollama)" Classes="settings-title" />
            <TextBlock Text="{Binding LocalModelSetupStatus}" Classes="muted" TextWrapping="Wrap" />
            <Button Content="Review local model setup"
                    IsEnabled="{Binding CanInstallLocalModel}"
                    IsVisible="{Binding ShouldOfferLocalModelSetup}"
                    Click="OnInstallLocalModelClicked"
                    HorizontalAlignment="Left" />
            <ProgressBar Minimum="0"
                         Maximum="100"
                         Value="{Binding LocalModelSetupProgress}"
                         IsIndeterminate="{Binding IsLocalModelSetupProgressIndeterminate}"
                         IsVisible="{Binding IsLocalModelSetupActive}" />
            <TextBlock Text="PowerShell 7 (pwsh)" Classes="settings-title" />
            <TextBlock Text="{Binding PowerShellSetupStatus}" Classes="muted" TextWrapping="Wrap" />
            <Button Content="Review PowerShell 7 setup"
                    IsEnabled="{Binding CanInstallPowerShell}"
                    IsVisible="{Binding ShouldOfferPowerShellSetup}"
                    Click="OnInstallPowerShellClicked"
                    HorizontalAlignment="Left" />
            <ItemsControl ItemsSource="{Binding SetupTasks}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Classes="settings-card" Margin="0,0,0,10">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24">
                      <StackPanel Spacing="4">
                        <TextBlock Text="{Binding Name}" Classes="settings-title" />
                        <TextBlock Text="{Binding Detail}" Classes="settings-description" TextWrapping="Wrap" />
                      </StackPanel>
                      <TextBlock Grid.Column="1" Text="{Binding State}"
                                 Foreground="{DynamicResource KoraAccentBrush}"
                                 FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <ItemsControl ItemsSource="{Binding Dependencies}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Classes="settings-card" Margin="0,0,0,10">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24">
                      <StackPanel Spacing="4">
                        <TextBlock Text="{Binding Name}" Classes="settings-title" />
                        <TextBlock
                            Text="{Binding Detail}"
                            Classes="settings-description"
                            TextWrapping="Wrap" />
                      </StackPanel>
                      <TextBlock
                          Grid.Column="1"
                          Text="{Binding DisplayReadiness}"
                          Foreground="{DynamicResource KoraAccentBrush}"
                          FontSize="11"
                          FontWeight="SemiBold"
                          VerticalAlignment="Center" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel Orientation="Horizontal" Spacing="10">
              <Button
                  Content="Refresh readiness"
                  Command="{Binding RefreshCommand}" />
              <Button
                  Content="Open Windows microphone settings"
                  Command="{Binding OpenMicrophonePrivacySettingsCommand}" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="Approvals">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="30,4,30,30" Spacing="16" MaxWidth="700" HorizontalAlignment="Left">
            <TextBlock Text="Model action approvals" FontSize="28" FontWeight="SemiBold" />
            <TextBlock
                Text="A model can suggest one named Kora action. Once applies only to that request; session lasts until Kora exits, restarts, or locks Windows through Kora; always persists until revoked. Every approval card is visible, including in VoiceOnly mode."
                TextWrapping="Wrap" Classes="muted" />
            <Border Classes="settings-card">
              <StackPanel Spacing="5">
                <TextBlock Text="Spoken approval" Classes="settings-title" />
                <CheckBox
                    Content="Require the assistant name before a verbal approval"
                    IsChecked="{Binding RequireAssistantNameForVoiceApproval}" />
                <TextBlock
                    Text="Enabled by default. Turn off only if you want to answer an approval prompt without saying the assistant name."
                    Classes="settings-description" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
            <TextBlock Text="Approved for this session" Classes="settings-title" />
            <ItemsControl ItemsSource="{Binding SessionAllowedModelActions}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap" />
                    <Button Grid.Column="1" Content="Revoke" Tag="{Binding Action}"
                            Click="OnRevokeSessionApprovalClicked" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="Always approved on this device" Classes="settings-title" />
            <ItemsControl ItemsSource="{Binding AlwaysAllowedModelActions}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap" />
                    <Button Grid.Column="1" Content="Revoke" Tag="{Binding Action}"
                            Click="OnRevokeAlwaysApprovalClicked" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="Maintenance">
        <StackPanel Margin="30" Spacing="16" MaxWidth="700">
          <TextBlock Text="Release maintenance (notify-only)" FontSize="24" FontWeight="SemiBold" />
          <TextBlock Text="{Binding MaintenanceStatus}" TextWrapping="Wrap" />
          <TextBlock Text="Canonical GitHub Releases metadata only. Network access is off until explicitly permitted for this run. Replacement is manual and unsigned; Kora has no updater." TextWrapping="Wrap" />
          <Button Content="Review / check / open canonical release" Click="OnMaintenanceClicked" HorizontalAlignment="Left" />
        </StackPanel>
      </TabItem>
    </controls:NavigableTabControl>
  </Grid>
</Window>
