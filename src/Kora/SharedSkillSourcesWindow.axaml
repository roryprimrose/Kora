<Window
    x:Class="Kora.SharedSkillSourcesWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Kora.Controls"
    Title="Shared profile skills - local read-only inspection"
    Icon="/Assets/Kora.ico" Width="1050" Height="800" MinWidth="700" MinHeight="500"
    Background="{DynamicResource KoraWindowBackgroundBrush}"
    Foreground="{DynamicResource KoraForegroundBrush}">
  <Grid Margin="20" RowDefinitions="Auto,Auto,Auto,Auto,Auto,*" RowSpacing="10">
    <TextBlock Text="Registration authorizes only bounded local reading. No enable/disable/invoke, model exposure, execution, egress, approval, source editing or trust promotion."
               TextWrapping="Wrap" />
    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10">
      <Button x:Name="RegisterSource" Content="Choose and register profile root (read only)" />
      <Button x:Name="RefreshSources" Content="Refresh registrations" />
    </StackPanel>
    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="10">
      <ComboBox x:Name="SourceSelector" MinWidth="360" AutomationProperties.Name="Registered exact shared profile roots" />
      <Button x:Name="DiscoverSource" Content="List selected source" />
      <Button x:Name="VerifyRevision" Content="Recheck selected revision" />
    </StackPanel>
    <controls:NamedTextBlock x:Name="SharedStatus" Grid.Row="3" TextWrapping="Wrap"
                            AutomationProperties.Name="Source availability and immutable revision status" />
    <ComboBox x:Name="SharedPackageSelector" Grid.Row="4" HorizontalAlignment="Stretch"
              AutomationProperties.Name="Compatible and unavailable shared skill snapshots" />
    <Grid Grid.Row="5" RowDefinitions="Auto,Auto,*" RowSpacing="10">
      <controls:NamedTextBlock x:Name="SharedIdentity" TextWrapping="Wrap"
                              AutomationProperties.Name="Exact source-qualified identity, digest and compatibility" />
      <Expander x:Name="UninspectedDisclosure" Grid.Row="1" Header="Additional entries (names only; incompatible, no contents read)">
        <TextBox x:Name="UninspectedEntries" IsReadOnly="True" AcceptsReturn="True" IsUndoEnabled="False"
                 MaxHeight="140" FontFamily="Consolas" TextWrapping="NoWrap"
                 AutomationProperties.Name="Uninspected additional entry paths, not a dependency closure" />
      </Expander>
      <TextBox x:Name="SharedSource" Grid.Row="2" IsReadOnly="True" AcceptsReturn="True"
               IsUndoEnabled="False" FontFamily="Consolas" TextWrapping="NoWrap"
               AutomationProperties.Name="Exact immutable untrusted SKILL.md source, inert plain text" />
    </Grid>
  </Grid>
</Window>
