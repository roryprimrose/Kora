<ResourceDictionary xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <DataTemplate x:Key="ConversationMessageTemplate">
    <StackPanel Spacing="4">
      <TextBlock Text="{Binding Sequence, StringFormat='USER message sequence {0}'}" />
      <TextBlock Text="{Binding Request.RequestId.Value, StringFormat='Original request {0}'}" TextWrapping="Wrap" />
      <TextBlock Text="{Binding Request.TaskId.Value, StringFormat='Original task {0}'}" TextWrapping="Wrap" />
      <TextBlock Text="{Binding SubmittedAt, StringFormat='Submitted UTC {0:O}'}" />
      <TextBlock Text="{Binding Body}" TextWrapping="Wrap" />
      <TextBlock Text="{Binding Outcome, TargetNullValue='Pending / inspect task recovery', StringFormat='HOST status: {0}'}" />
      <TextBlock Text="{Binding Reason, StringFormat='HOST reason: {0}'}" />
      <TextBlock Text="{Binding ExpectedTaskState, StringFormat='HOST task status: {0}'}" />
      <Button Name="OpenConversationDetail" Content="Details - exact original USER / separate HOST"
          IsEnabled="{Binding $parent[Window].DataContext.CanOpenConversationDetails}"
          AutomationProperties.Name="Explicit passive Details for this exact retained original USER record and separate typed HOST outcome; no clipboard authority" />
      <Button Name="ReviewOriginalMessageReuse" Content="Review reuse of this original USER text in a New request"
          IsEnabled="{Binding $parent[Window].DataContext.CanReviewOriginalMessageReuse}"
          AutomationProperties.Name="Review complete exact retained original USER text and historical attribution; separate confirmation copies to New request memory only, never replay, HOST output, Save or Submit" />
    </StackPanel>
  </DataTemplate>
</ResourceDictionary>
