<Window x:Class="Kora.CompactSessionWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Kora"
    xmlns:controls="using:Kora.Controls"
    Title="Kora - selected session conversation" Icon="/Assets/Kora.ico"
    Width="620" Height="740" MinWidth="420" MinHeight="420"
    Background="{DynamicResource KoraWindowBackgroundBrush}"
    Foreground="{DynamicResource KoraForegroundBrush}" WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="/ConversationPresentation.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>
  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="18" Spacing="8">
      <TextBlock Text="Selected session — native conversation" FontSize="20" FontWeight="SemiBold" />
      <WrapPanel>
        <Button x:Name="Sessions" Content="_Sessions / explicit selection" />
        <Button x:Name="NewRequest" Content="_New request (fresh target)" />
      </WrapPanel>
      <controls:NamedTextBlock x:Name="ComposerTargetLabel" Text="{Binding ComposerTarget}" TextWrapping="Wrap"
          AutomationProperties.Name="Conversation name and exact session identity for this message" />
      <TextBlock Text="{Binding SelectedSessionRecord.Authority.IsActive, TargetNullValue='No selected target', StringFormat='Observed Active lifecycle: {0}'}" />
      <local:SessionRequestReviewPanel x:Name="OriginalRequestReview" />
      <local:AnswerReviewPanel />
      <controls:NamedTextBlock Text="{Binding WorkStatus}" TextWrapping="Wrap"
          AutomationProperties.Name="Observed exact selected-session work source and time; not inferred execution or current success" />
      <TextBlock Text="No target? Open Sessions and explicitly select one. Opening never selects, loads bodies, resumes work or grants permission. Questions, approvals and voice stay in their existing windows." TextWrapping="Wrap" />
      <WrapPanel>
        <Button x:Name="ReadConversation" Content="Read exact conversation" IsEnabled="{Binding CanReadConversation}" />
        <Button x:Name="NextConversation" Content="Next bounded page" IsEnabled="{Binding CanNextConversation}" />
        <Button x:Name="RefreshWork" Content="Refresh observed work" IsEnabled="{Binding CanRefreshWork}" />
      </WrapPanel>
      <controls:ScrollableListBox x:Name="AnswerSourceRecords" ItemsSource="{Binding ConversationMessages}" MaxHeight="200"
          SelectedItem="{Binding SelectedAnswerRecord, Mode=TwoWay}"
          ItemTemplate="{StaticResource ConversationMessageTemplate}"
          AutomationProperties.Name="Original USER messages, separate retained ASSISTANT answers and typed HOST outcomes; selection never starts speech" />
      <WrapPanel>
        <Button x:Name="ReadSelectedAnswer" Content="Read selected ASSISTANT answer once" IsEnabled="{Binding CanReadSelectedAnswer}" />
        <Button x:Name="CancelAnswerRead" Content="Cancel answer reading" IsEnabled="{Binding CanCancelAnswerRead}" />
      </WrapPanel>
      <controls:NamedTextBlock Text="{Binding AnswerReadStatus}" TextWrapping="Wrap"
          AutomationProperties.Name="Exact retained assistant answer speech outcome; selection never starts playback" />
      <TextBox x:Name="ConversationQuery" Text="{Binding ConversationQuery, Mode=TwoWay}" IsEnabled="{Binding CanReadConversation}"
          PlaceholderText="Search retained USER words or typed HOST outcome/reason/task state in only this exact selected session"
          AutomationProperties.Name="Shared private exact-session conversation lexical query; memory-only, not composer input, a model instruction or global search" />
      <ComboBox x:Name="ConversationRole" ItemsSource="{Binding ConversationRoles}"
          SelectedItem="{Binding ConversationRole, Mode=TwoWay}" IsEnabled="{Binding CanReadConversation}"
          AutomationProperties.Name="Shared conversation search field filter: All original USER and typed HOST fields, USER original body only, HOST outcome reason and task state only; editing does not read" />
      <TextBlock Text="Submitted from UTC (inclusive)" />
      <TextBox x:Name="ConversationSubmittedFrom" Text="{Binding ConversationSubmittedFrom, Mode=TwoWay}"
          IsEnabled="{Binding CanReadConversation}" PlaceholderText="yyyy-MM-ddTHH:mm:ss.fffffff+00:00"
          AutomationProperties.Name="Shared conversation submitted from UTC, inclusive; empty means Any; editing does not search" />
      <TextBlock Text="Submitted through UTC (inclusive)" />
      <TextBox x:Name="ConversationSubmittedThrough" Text="{Binding ConversationSubmittedThrough, Mode=TwoWay}"
          IsEnabled="{Binding CanReadConversation}" PlaceholderText="yyyy-MM-ddTHH:mm:ss.fffffff+00:00"
          AutomationProperties.Name="Shared conversation submitted through UTC, inclusive; empty means Any; editing does not search" />
      <TextBlock Text="Observed task state" />
      <ComboBox x:Name="ConversationTaskState" ItemsSource="{Binding ConversationTaskStates}"
          SelectedItem="{Binding ConversationTaskStateChoice, Mode=TwoWay}" IsEnabled="{Binding CanReadConversation}"
          AutomationProperties.Name="Shared conversation observed task state; Any adds no restriction; exact state matches typed HOST outcomes only, not USER-only search; editing does not search" />
      <WrapPanel>
        <Button x:Name="SearchConversation" Content="Search this conversation" IsEnabled="{Binding CanSearchConversation}" />
        <Button x:Name="NextConversationSearch" Content="Next conversation matches" IsEnabled="{Binding CanNextConversationSearch}" />
        <Button x:Name="CancelConversationSearch" Content="Cancel conversation search" IsEnabled="{Binding CanCancelConversationSearch}" />
        <Button x:Name="ClearConversationSearch" Content="Clear private conversation search" />
      </WrapPanel>
      <controls:NamedTextBlock Text="{Binding ConversationSearchStatus}" TextWrapping="Wrap"
          AutomationProperties.Name="Shared conversation search counters, exact snapshot continuation and explicit failures; no model context" />
      <controls:ScrollableListBox x:Name="ConversationSearchResults" ItemsSource="{Binding ConversationSearchMessages}" MaxHeight="160"
          ItemTemplate="{StaticResource ConversationMessageTemplate}"
          AutomationProperties.Name="Shared exact immutable USER messages matching lexical words or typed HOST status; inert native text, chronological, no export or actions" />
      <TextBlock Text="Submit privately retains the original USER body with the actual HOST outcome. Production generation is unavailable; no runtime fallback, history context, network or tools. Structural credential checks cannot guarantee secret-free text. Draft edits are memory-only; both windows edit the same buffer." TextWrapping="Wrap" />
      <TextBox x:Name="ConversationComposer" Text="{Binding ComposerBody, Mode=TwoWay}" AcceptsReturn="True"
          Height="110" TextWrapping="Wrap" IsEnabled="{Binding CanCompose}"
          PlaceholderText="Original body: at most 4096 UTF-16 characters / 16384 UTF-8 bytes; rejected, never truncated"
          AutomationProperties.Name="Shared exact-session memory draft, not question input or approval" />
      <controls:NamedTextBlock x:Name="DraftSizeFeedback" Text="{Binding ComposerDraftSizeFeedback}" TextWrapping="Wrap"
          AutomationProperties.Name="Current editable shared conversation draft size and shape" />
      <local:SessionDictationButton IsEnabled="{Binding CanCompose}" />
      <CheckBox x:Name="WrapDraftText" Content="Wrap draft text" IsEnabled="{Binding CanCompose}"
          AutomationProperties.Name="Wrap draft text"
          ToolTip.Tip="Visual rows only, not logical lines or tokens. Exact draft text is unchanged. Uncheck to scroll long lines horizontally; this view and source only, until closed." />
      <WrapPanel>
        <Button x:Name="RecoverConversationDraft" Content="Recover existing legacy text into empty input" IsEnabled="{Binding CanRecoverConversationDraft}"
            AutomationProperties.Name="Read-only compatibility recovery for this exact session; no save, delete or submit" />
        <Button x:Name="DiscardComposer" Content="Discard this unsent message..." IsEnabled="{Binding CanReadConversation}" />
        <Button x:Name="SubmitConversation" Content="Submit exact message — unavailable provider" IsEnabled="{Binding CanSubmitConversation}" />
        <Button x:Name="SubmitConversationWithClarification" Content="Submit with one clarification"
          IsEnabled="{Binding CanSubmitConversationWithClarification}"
          AutomationProperties.HelpText="Local request with ask_user only: one question with radio buttons, checkboxes or bounded text, answered here through the session-owned question window or by voice. Unqualified providers remain unavailable." />
        <Button x:Name="SubmitClaudeWithClarification" Content="Ask Claude with one clarification (separate disclosure reviews)"
          IsEnabled="{Binding CanSubmitConversationWithClarification}"
          AutomationProperties.HelpText="Explicit question-only Claude operation. Answer in the session-owned window or by eligible voice. Each token-count and Messages POST requires separate native consent; answering never approves transmission. No sources, observation tools or retry." />
        <Button x:Name="SubmitReadOnlyWithClarification" Content="Ask locally with observations and one question"
          IsEnabled="{Binding CanSubmitConversationWithClarification}"
          AutomationProperties.HelpText="Uses six read-only observation tools and ask_user once, with radio buttons, checkboxes or bounded text. Answer in the session-owned question window or by voice. A reply is not approval or permission. Unqualified local providers remain unavailable." />
        <Button x:Name="SubmitWebPage" Content="Retrieve and summarize one page locally"
          IsEnabled="{Binding CanSubmitConversation}"
          AutomationProperties.HelpText="Enter get web page followed by one absolute public address. Requires separate exact once-only approval; unqualified local models remain unavailable." />
        <Button x:Name="RefreshRunningConversation" Content="Refresh running work" IsEnabled="{Binding CanRefreshRunningConversation}" />
        <Button x:Name="CancelRunningConversation" Content="Cancel this running conversation task"
          IsEnabled="{Binding CanCancelRunningConversation}"
          AutomationProperties.HelpText="Requests cancellation only for this exact observed running task; waits for owned resources and retains a terminal outcome." />
      </WrapPanel>
      <controls:NamedTextBlock Text="{Binding RunningConversationStatus}" TextWrapping="Wrap"
        AutomationProperties.Name="Exact running conversation task and cancellation state" />
      <local:PendingConversationPanel />
      <Button x:Name="SubmitLocalAnswer" Content="Answer locally (no tools)" IsEnabled="{Binding CanSubmitConversation}" />
      <StackPanel IsVisible="{Binding HasProvisionalAnswer}" Spacing="4">
        <TextBlock Text="Provisional answer — not retained" TextWrapping="Wrap" />
        <TextBlock Text="{Binding ProvisionalAnswer}" TextWrapping="Wrap"
            AutomationProperties.Name="Unstable provisional local answer; not spoken automatically" />
      </StackPanel>
      <controls:NamedTextBlock Text="{Binding ConversationStatus}" TextWrapping="Wrap"
          AutomationProperties.Name="Actual shared conversation submission, unavailable or legacy recovery outcome" />
      <local:ModelMemoryProposalPanel />
      <local:AssistantReplyPanel />
      <TextBlock Text="{Binding RegisteredSettingsDescription}" TextWrapping="Wrap" />
      <TextBlock Text="{Binding RegisteredSettingSuggestionDescription}" TextWrapping="Wrap"
          AutomationProperties.Name="Exact current and proposed registered setting values, provenance, shared scope, timing and recovery; review is not approval" />
      <WrapPanel>
        <Button Name="ConfirmRegisteredSettingSuggestion" Content="Confirm exact setting change" IsEnabled="{Binding CanConfirmRegisteredSettingSuggestion}" />
        <Button Name="CancelRegisteredSettingSuggestion" Content="Cancel setting review" IsEnabled="{Binding CanConfirmRegisteredSettingSuggestion}" />
      </WrapPanel>
      <Button x:Name="CloseView" Content="_Close compact view (work unchanged)" HorizontalAlignment="Right" />
    </StackPanel>
  </ScrollViewer>
</Window>
