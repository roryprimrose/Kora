<Window x:Class="Kora.SharedSkillSourcesWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Shared profile skills - local read-only inspection"
    Icon="/Assets/Kora.ico" Width="1050" Height="800" MinWidth="700" MinHeight="500"
    Background="{DynamicResource KoraWindowBackgroundBrush}" Foreground="{DynamicResource KoraForegroundBrush}">
</Window>
