<Window
    x:Class="Kora.DocumentationWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Icon="/Assets/Kora.ico"
    Width="1120"
    Height="780"
    MinWidth="860"
    MinHeight="620"
    Background="{DynamicResource KoraWindowBackgroundBrush}"
    Foreground="{DynamicResource KoraForegroundBrush}"
    WindowStartupLocation="CenterScreen">
  <Grid RowDefinitions="72,*">
    <Border
        BorderBrush="{DynamicResource KoraHeaderBorderBrush}"
        BorderThickness="0,0,0,1"
        Padding="30,0">
      <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center">
        <Border
            Width="34"
            Height="34"
            Background="{DynamicResource KoraAccentBrush}"
            CornerRadius="9">
          <TextBlock
              Text="{Binding AssistantInitial}"
              Foreground="{DynamicResource KoraAccentForegroundBrush}"
              FontSize="23"
              FontWeight="SemiBold"
              HorizontalAlignment="Center"
              VerticalAlignment="Center" />
        </Border>
        <StackPanel Grid.Column="1" Margin="13,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="Documentation" FontSize="20" FontWeight="SemiBold" />
          <TextBlock
              Text="{Binding AssistantName, StringFormat='{}{0} user guide'}"
              Classes="muted"
              FontSize="11" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="270,*">
      <Border
          BorderBrush="{DynamicResource KoraHeaderBorderBrush}"
          BorderThickness="0,0,1,0"
          Background="{DynamicResource KoraSurfaceAltBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel
              x:Name="NavigationPanel"
              Margin="22"
              Spacing="6" />
        </ScrollViewer>
      </Border>

      <ScrollViewer
          x:Name="DocumentScrollViewer"
          Grid.Column="1"
          VerticalScrollBarVisibility="Auto">
        <StackPanel
            x:Name="DocumentPanel"
            Margin="44,36,54,60"
            MaxWidth="760"
            HorizontalAlignment="Left"
            Spacing="4" />
      </ScrollViewer>
    </Grid>
  </Grid>
</Window>
