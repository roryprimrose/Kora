<Window x:Class="Kora.AttachmentCatalogueWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Kora.Controls"
    Title="Retained session attachments - metadata only" Icon="/Assets/Kora.ico"
    Width="1100" Height="720" MinWidth="850" MinHeight="580"
    Background="{DynamicResource KoraWindowBackgroundBrush}"
    Foreground="{DynamicResource KoraForegroundBrush}" WindowStartupLocation="CenterScreen">
  <Grid Margin="24" RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="12">
    <WrapPanel>
      <Button x:Name="RefreshPage" Content="_Search / refresh metadata" IsEnabled="{Binding CanSearch}" />
      <Button x:Name="NextPage" Content="_Next bounded page" IsEnabled="{Binding CanNext}" />
      <Button x:Name="CancelRead" Content="_Cancel read" IsEnabled="{Binding CanCancel}" />
      <CheckBox Content="Include _removed slots (provenance only)" IsChecked="{Binding IncludeRemoved, Mode=TwoWay}"
                IsEnabled="{Binding CanEdit}" />
      <Button x:Name="ClearQuery" Content="Clear _query (Browse)" IsEnabled="{Binding CanEdit}" />
    </WrapPanel>
    <ScrollViewer Grid.Row="1" MaxHeight="380" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <StackPanel Spacing="6">
      <WrapPanel>
        <ComboBox x:Name="AttachmentSessionFilter" ItemsSource="{Binding Filters}" SelectedItem="{Binding Filter, Mode=TwoWay}"
                  IsEnabled="{Binding CanEdit}" AutomationProperties.Name="Stored session lifecycle: All, Active, Done or Removed; independent of removed attachment slots" />
        <ComboBox x:Name="AttachmentMediaType" ItemsSource="{Binding MediaTypes}" SelectedItem="{Binding MediaType, Mode=TwoWay}"
                  IsEnabled="{Binding CanEdit}" AutomationProperties.Name="Exact retained media type: All, text/plain or text/markdown; removed tombstones match only All; changing performs no read" />
        <ComboBox x:Name="AttachmentQueryMode" ItemsSource="{Binding Modes}" SelectedItem="{Binding Mode, Mode=TwoWay}"
                  IsEnabled="{Binding CanEdit}" AutomationProperties.Name="Attachment metadata query mode: Browse or ExactId" />
        <TextBox x:Name="AttachmentQueryText" Text="{Binding QueryText, Mode=TwoWay}" Width="540"
                 IsEnabled="{Binding CanEditId}" AutomationProperties.Name="Private volatile exact session ID query; typing performs no read" />
      </WrapPanel>
      <controls:NamedTextBlock Text="{Binding QueryHint}" TextWrapping="Wrap" />
      <controls:NamedTextBlock Text="{Binding MediaTypeHint}" TextWrapping="Wrap" />
      <WrapPanel>
        <ComboBox x:Name="AttachmentCopyStatus" ItemsSource="{Binding CopyStatuses}" SelectedItem="{Binding CopyStatus, Mode=TwoWay}"
                  IsEnabled="{Binding CanEdit}" AutomationProperties.Name="Exact copy status: Any, Confirmed, Held or Unavailable; changing performs no read" />
        <TextBox x:Name="AttachmentMinimumBytes" Text="{Binding MinimumBytesText, Mode=TwoWay}" Width="200"
                 PlaceholderText="Minimum stored bytes (Any)" IsEnabled="{Binding CanEdit}"
                 AutomationProperties.Name="Inclusive minimum retained stored bytes; empty means Any; unsigned invariant digits only; typing performs no read" />
        <TextBox x:Name="AttachmentMaximumBytes" Text="{Binding MaximumBytesText, Mode=TwoWay}" Width="200"
                 PlaceholderText="Maximum stored bytes (Any)" IsEnabled="{Binding CanEdit}"
                 AutomationProperties.Name="Inclusive maximum retained stored bytes; empty means Any; unsigned invariant digits only; typing performs no read" />
      </WrapPanel>
      <controls:NamedTextBlock Text="{Binding CopyAndBytesHint}" TextWrapping="Wrap" />
      <TextBox x:Name="AttachmentMetadataText" Text="{Binding MetadataText, Mode=TwoWay}" Width="700"
               PlaceholderText="Optional literal metadata (IDs, digest or media type)"
               HorizontalAlignment="Left" IsEnabled="{Binding CanEdit}"
               AutomationProperties.Name="Optional private volatile literal metadata query: exposed IDs, digest or media type; case sensitive; typing performs no read" />
      <controls:NamedTextBlock Text="{Binding MetadataHint}" TextWrapping="Wrap" />
      <TextBox x:Name="AttachmentDigest" Text="{Binding DigestText, Mode=TwoWay}" Width="700"
               PlaceholderText="Optional exact SHA-256 (Any when empty)"
               HorizontalAlignment="Left" IsEnabled="{Binding CanEdit}"
               AutomationProperties.Name="Optional exact SHA-256 of a Confirmed retained copy; 64 lowercase hexadecimal characters, not all zero; typing performs no read" />
      <controls:NamedTextBlock Text="{Binding DigestHint}" TextWrapping="Wrap" />
      <WrapPanel>
        <TextBox x:Name="AttachmentFileSourceId" Text="{Binding FileSourceIdText, Mode=TwoWay}" Width="460"
                 PlaceholderText="Exact local-file source GUID (Any when empty)" IsEnabled="{Binding CanEdit}"
                 AutomationProperties.Name="Optional exact retained local-file source ID; nonempty canonical lowercase D-format GUID; correlation only, not source consent or file-read authority; typing performs no read" />
        <TextBox x:Name="AttachmentFileRevisionId" Text="{Binding FileRevisionIdText, Mode=TwoWay}" Width="460"
                 PlaceholderText="Exact local-file revision GUID (Any when empty)" IsEnabled="{Binding CanEdit}"
                 AutomationProperties.Name="Optional exact retained local-file revision ID; nonempty canonical lowercase D-format GUID; correlation only, not current file identity or body integrity; typing performs no read" />
        <TextBox x:Name="AttachmentFileItemId" Text="{Binding FileItemIdText, Mode=TwoWay}" Width="460"
                 PlaceholderText="Exact local-file item GUID (Any when empty)" IsEnabled="{Binding CanEdit}"
                 AutomationProperties.Name="Optional exact retained local-file item ID; nonempty canonical lowercase D-format GUID; correlation only, not path disclosure or proof a copy exists; typing performs no read" />
      </WrapPanel>
      <controls:NamedTextBlock Text="{Binding FileReferenceHint}" TextWrapping="Wrap" />
      <WrapPanel>
        <TextBox x:Name="AttachmentObservationSource" Text="{Binding ObservationSourceText, Mode=TwoWay}" Width="460"
                 PlaceholderText="Exact observation-source GUID (Any when empty)" IsEnabled="{Binding CanEdit}"
                 AutomationProperties.Name="Optional exact retained observation-source GUID; lowercase D format; correlation only, not source consent; typing performs no read" />
        <TextBox x:Name="AttachmentDeviceProfile" Text="{Binding DeviceProfileText, Mode=TwoWay}" Width="460"
                 PlaceholderText="Exact device-profile GUID (Any when empty)" IsEnabled="{Binding CanEdit}"
                 AutomationProperties.Name="Optional exact retained device-profile GUID; lowercase D format; correlation only, not ownership; typing performs no read" />
      </WrapPanel>
      <WrapPanel>
        <TextBox x:Name="AttachmentCapturedFrom" Text="{Binding CapturedFromText, Mode=TwoWay}" Width="460"
                 PlaceholderText="Captured From UTC (Any when empty)" IsEnabled="{Binding CanEdit}"
                 AutomationProperties.Name="Optional inclusive retained Captured From canonical UTC; yyyy-MM-ddTHH:mm:ss.fffffff+00:00; typing performs no read" />
        <TextBox x:Name="AttachmentCapturedUntil" Text="{Binding CapturedUntilText, Mode=TwoWay}" Width="460"
                 PlaceholderText="Captured Until UTC (Any when empty)" IsEnabled="{Binding CanEdit}"
                 AutomationProperties.Name="Optional inclusive retained Captured Until canonical UTC; yyyy-MM-ddTHH:mm:ss.fffffff+00:00; typing performs no read" />
      </WrapPanel>
      <controls:NamedTextBlock Text="{Binding CorrelationHint}" TextWrapping="Wrap" />
      <WrapPanel>
        <TextBox x:Name="AttachmentMinimumSessionGeneration" Text="{Binding MinimumSessionGenerationText, Mode=TwoWay}" Width="460"
                 PlaceholderText="Minimum session generation (Any)" IsEnabled="{Binding CanEdit}"
                 AutomationProperties.Name="Optional inclusive minimum retained session generation; positive invariant digits; typing performs no read" />
        <TextBox x:Name="AttachmentMaximumSessionGeneration" Text="{Binding MaximumSessionGenerationText, Mode=TwoWay}" Width="460"
                 PlaceholderText="Maximum session generation (Any)" IsEnabled="{Binding CanEdit}"
                 AutomationProperties.Name="Optional inclusive maximum retained session generation; positive invariant digits; typing performs no read" />
      </WrapPanel>
      <WrapPanel>
        <TextBox x:Name="AttachmentMinimumCapturedGeneration" Text="{Binding MinimumCapturedGenerationText, Mode=TwoWay}" Width="460"
                 PlaceholderText="Minimum captured generation (Any)" IsEnabled="{Binding CanEdit}"
                 AutomationProperties.Name="Optional inclusive minimum retained captured generation; positive invariant digits; typing performs no read" />
        <TextBox x:Name="AttachmentMaximumCapturedGeneration" Text="{Binding MaximumCapturedGenerationText, Mode=TwoWay}" Width="460"
                 PlaceholderText="Maximum captured generation (Any)" IsEnabled="{Binding CanEdit}"
                 AutomationProperties.Name="Optional inclusive maximum retained captured generation; positive invariant digits; typing performs no read" />
      </WrapPanel>
      <WrapPanel>
        <TextBox x:Name="AttachmentMinimumStorageRevision" Text="{Binding MinimumStorageRevisionText, Mode=TwoWay}" Width="460"
                 PlaceholderText="Minimum storage revision (Any)" IsEnabled="{Binding CanEdit}"
                 AutomationProperties.Name="Optional inclusive minimum retained storage revision; positive invariant digits; typing performs no read" />
        <TextBox x:Name="AttachmentMaximumStorageRevision" Text="{Binding MaximumStorageRevisionText, Mode=TwoWay}" Width="460"
                 PlaceholderText="Maximum storage revision (Any)" IsEnabled="{Binding CanEdit}"
                 AutomationProperties.Name="Optional inclusive maximum retained storage revision; positive invariant digits; typing performs no read" />
      </WrapPanel>
      <controls:NamedTextBlock Text="{Binding VersionHint}" TextWrapping="Wrap" />
    </StackPanel>
    </ScrollViewer>
    <controls:NamedTextBlock Grid.Row="2" Text="{Binding Status}" TextWrapping="Wrap"
                            AutomationProperties.Name="Content-free metadata scope and finite scan limitations; not full body verification" />
    <Grid Grid.Row="3" ColumnDefinitions="430,*" ColumnSpacing="12">
      <controls:ScrollableListBox x:Name="SlotRecords" ItemsSource="{Binding Records}"
          SelectedItem="{Binding SelectedRecord, Mode=OneWay}"
          AutomationProperties.Name="Exact retained private session slots; no filenames, original paths or source body">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel Spacing="4">
              <TextBlock Text="{Binding Session.Value, StringFormat='Session: {0}'}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding SessionState, StringFormat='Stored session: {0}'}" />
              <TextBlock Text="{Binding CopyStatus, StringFormat='Copy certification: {0}'}" />
              <TextBlock Text="{Binding RetainedSessionGeneration.Value, StringFormat='Session generation: {0}', TargetNullValue='Session generation: unavailable (removed provenance)'}" />
              <TextBlock Text="{Binding RetainedCapturedGeneration.Value, StringFormat='Captured generation: {0}', TargetNullValue='Captured generation: unavailable (removed provenance)'}" />
              <TextBlock Text="{Binding RetainedStorageRevision.Value, StringFormat='Storage revision: {0}', TargetNullValue='Storage revision: unavailable (removed provenance)'}" />
              <TextBlock Text="{Binding RetainedStoredBytes, StringFormat='Stored original bytes: {0}', TargetNullValue='Stored original bytes: unavailable (removed provenance; no size claim)'}" />
              <TextBlock Text="{Binding MediaType}" />
              <TextBlock Text="{Binding RetainedCapturedAt, StringFormat='Captured UTC: {0:O}', TargetNullValue='Captured UTC: unavailable (removed provenance)'}" />
              <TextBlock Text="{Binding RetainedDigest, StringFormat='Original digest header: {0}', TargetNullValue='Original digest: unavailable (removed provenance)'}" TextWrapping="Wrap" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </controls:ScrollableListBox>
      <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <controls:NamedTextBlock Text="{Binding SelectedDetails}" TextWrapping="Wrap"
          AutomationProperties.Name="Selected exact session generation, storage revision, source, revision, item and digest headers; no body integrity claim" />
      </ScrollViewer>
    </Grid>
    <WrapPanel Grid.Row="4">
      <Button x:Name="OpenExact" Content="Open exact _session/attachment" IsEnabled="{Binding CanNavigate}"
              AutomationProperties.Name="Re-resolve original exact session and attachment; no resume, replacement retarget or new consent" />
      <Button x:Name="CloseView" Content="_Close" />
    </WrapPanel>
  </Grid>
</Window>
