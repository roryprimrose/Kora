<Window x:Class="Kora.SkillPackagesWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Skill packages - exact source review" Icon="/Assets/Kora.ico"
    Width="1100" Height="800" MinWidth="700" MinHeight="500" WindowStartupLocation="CenterOwner"
    Background="{DynamicResource KoraWindowBackgroundBrush}" Foreground="{DynamicResource KoraForegroundBrush}">
</Window>
