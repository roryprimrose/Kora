<UserControl x:Class="Kora.SessionInteractionView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Kora"
    xmlns:controls="using:Kora.Controls">
  <UserControl.Resources>
    <local:BriefAnswerConverter x:Key="BriefAnswer" />
    <DataTemplate x:Key="TimelineMessage">
      <Border Padding="12" Margin="0,0,0,10" Background="{DynamicResource KoraSurfaceAltBrush}" CornerRadius="8">
        <StackPanel Spacing="8">
          <TextBlock Text="{Binding SubmittedAt, StringFormat='You - {0:g}'}" Classes="eyebrow" />
          <TextBlock Text="{Binding Body}" TextWrapping="Wrap" />
          <StackPanel IsVisible="{Binding HasAssistantResponse}" Spacing="6">
            <TextBlock Text="Kora" Classes="eyebrow" />
            <TextBlock Text="{Binding AssistantResponse.Body, Converter={StaticResource BriefAnswer}}" TextWrapping="Wrap" />
            <Button Name="ReplyToAssistantAnswer" Content="_Reply to this answer"
                IsEnabled="{Binding $parent[UserControl].DataContext.CanReplyToAnswer}"
                AutomationProperties.Name="Reply to this exact retained answer; review the full source and unchanged follow-up before separate local-only confirmation"
                HorizontalAlignment="Left" />
            <Button Name="ReviewModelMemoryProposal" Content="Review session-memory proposal..."
                IsEnabled="{Binding $parent[UserControl].DataContext.CanReviewModelMemoryProposal}"
                AutomationProperties.Name="Explicitly inspect this actual retained answer; separate acceptance and session-only memory admission"
                HorizontalAlignment="Left" />
            <Button Name="OpenAssistantConversationDetail" Content="Open full detailed answer"
                IsEnabled="{Binding $parent[UserControl].DataContext.CanOpenConversationDetails}"
                HorizontalAlignment="Left" />
          </StackPanel>
          <TextBlock Text="{Binding Outcome, TargetNullValue='Pending / inspect work', StringFormat='Action outcome: {0}'}"
              TextWrapping="Wrap" Classes="muted" />
          <TextBlock Text="{Binding Reason, StringFormat='Reason: {0}'}" TextWrapping="Wrap" Classes="muted" />
          <Button Name="OpenConversationDetail" Content="Message details"
              IsEnabled="{Binding $parent[UserControl].DataContext.CanOpenConversationDetails}"
              HorizontalAlignment="Left" />
        </StackPanel>
      </Border>
    </DataTemplate>
  </UserControl.Resources>
  <Grid Margin="12" ColumnDefinitions="230,Auto,*" ColumnSpacing="10">
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto" RowSpacing="8">
      <TextBlock Text="Sessions" FontSize="20" FontWeight="SemiBold" />
      <ComboBox Grid.Row="1" ItemsSource="{Binding SessionFilters}"
          SelectedItem="{Binding SessionFilter, Mode=TwoWay}" IsEnabled="{Binding CanRead}"
          AutomationProperties.Name="Session list lifecycle filter" />
      <StackPanel Grid.Row="2" Spacing="6">
        <TextBlock Text="Conversation name" />
        <TextBox x:Name="SessionNameQuery" Text="{Binding SessionNameQuery, Mode=TwoWay}"
            IsEnabled="{Binding CanEditListSearch}" PlaceholderText="Part of a conversation name"
            AutomationProperties.Name="Search session names; editing does not search or read conversations" />
        <WrapPanel>
          <Button x:Name="SearchSessionNames" Content="Search" IsEnabled="{Binding CanSearchSessionNames}" />
          <Button x:Name="ClearSessionNameSearch" Content="Clear" IsEnabled="{Binding CanEditListSearch}" />
          <Button x:Name="NextSessionNameSearch" Content="Next matches" IsEnabled="{Binding CanNextSessionNameSearch}"
              AutomationProperties.Name="Next bounded name search page, including after zero matches" />
          <Button x:Name="CancelSessionNameSearch" Content="Cancel search" IsEnabled="{Binding CanCancelListSearch}" />
        </WrapPanel>
      </StackPanel>
      <WrapPanel Grid.Row="3">
        <Button x:Name="RefreshSessions" Content="Refresh list" IsEnabled="{Binding CanRead}" />
        <Button x:Name="NextSessions" Content="Next page" IsEnabled="{Binding CanNext}" />
      </WrapPanel>
      <controls:ScrollableListBox Grid.Row="4" x:Name="SessionList" ItemsSource="{Binding Sessions}"
          SelectedItem="{Binding SelectedSessionRecord, Mode=OneWay}" IsEnabled="{Binding CanRead}"
          AutomationProperties.Name="Presented session page; spoken positions count from the top, last means last on this page">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel Spacing="4" Margin="4">
              <TextBlock Text="{Binding Metadata.Name.Value, TargetNullValue='Unnamed conversation'}"
                  FontWeight="SemiBold" TextWrapping="Wrap" />
              <TextBlock Text="{Binding Authority.IsActive, StringFormat='Active: {0}'}" Classes="muted" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </controls:ScrollableListBox>
      <StackPanel Grid.Row="5" Spacing="6">
        <TextBlock Text="Positions refer to this loaded page, not all saved sessions. Refresh explicitly; background work does not reorder this list."
            TextWrapping="Wrap" Classes="muted" FontSize="11" />
        <Button x:Name="NewConversation" Content="New conversation..." />
        <Button x:Name="ManageSessions" Content="Session management..." />
      </StackPanel>
    </Grid>
    <GridSplitter Grid.Column="1" Width="4" ResizeDirection="Columns" />
    <Grid x:Name="ReadingPanes" Grid.Column="2" ColumnDefinitions="*,0,0">
    <Grid MinWidth="320" RowDefinitions="Auto,Auto,*,Auto,Auto,Auto" RowSpacing="8">
      <Grid ColumnDefinitions="*,Auto">
      <TextBlock Text="{Binding InteractionTarget}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"
          AutomationProperties.Name="Selected conversation; context is not a lock for general voice requests" />
      <Button Grid.Column="1" x:Name="ShowSessionDetails" Content="Show details" IsEnabled="{Binding CanShowDetails}"
          AutomationProperties.Name="Show details available for the selected session"
          ToolTip.Tip="{Binding DetailsAvailability}" />
      </Grid>
      <StackPanel Grid.Row="1" Spacing="6">
        <TextBlock Text="{Binding Status}" Classes="muted" TextWrapping="Wrap"
            AutomationProperties.Name="Session navigation outcome or failure" />
        <local:SessionPermissionControls />
      </StackPanel>
      <TabControl Grid.Row="2" x:Name="ConversationTabs">
        <TabItem x:Name="ConversationTab" Header="Conversation">
          <Grid RowDefinitions="Auto,*,Auto" RowSpacing="8">
            <WrapPanel>
              <Button x:Name="ReadConversation" Content="Read conversation" IsEnabled="{Binding CanReadConversation}" />
              <Button x:Name="NextConversation" Content="More messages" IsEnabled="{Binding CanNextConversation}" />
              <Button x:Name="ReadSessionLogs" Content="Session logs" IsEnabled="{Binding CanEvidence}" />
              <Button x:Name="ReadSessionAudit" Content="Session audit" IsEnabled="{Binding CanEvidence}" />
            </WrapPanel>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
              <StackPanel Spacing="8">
                <ItemsControl ItemsSource="{Binding ConversationMessages}" ItemTemplate="{StaticResource TimelineMessage}" />
                <StackPanel IsVisible="{Binding HasProvisionalAnswer}" Spacing="4">
                  <TextBlock Text="Provisional local answer — not retained; only a validated completed answer is saved."
                      TextWrapping="Wrap" AutomationProperties.Name="Provisional local answer, not retained" />
                  <TextBlock Text="{Binding ProvisionalAnswer}" TextWrapping="Wrap"
                      AutomationProperties.Name="Unstable provisional answer text; not spoken automatically" />
                </StackPanel>
                <local:ModelMemoryProposalPanel />
                <local:AssistantReplyPanel />
                <ContentControl Content="{Binding DetailsOfferMessage}">
                  <ContentControl.ContentTemplate>
                    <DataTemplate>
                      <StackPanel Spacing="6">
                        <TextBlock Text="Would you like to view the detailed response? You can also say: show detailed results."
                            TextWrapping="Wrap" />
                        <WrapPanel>
                          <Button Name="OpenAssistantConversationDetail" Content="Yes, show this detailed response" />
                          <Button Name="DeclineSessionDetailsOffer" Content="Not now" />
                        </WrapPanel>
                      </StackPanel>
                    </DataTemplate>
                  </ContentControl.ContentTemplate>
                </ContentControl>
                <ItemsControl ItemsSource="{Binding EvidenceDetails}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <StackPanel Spacing="6" Margin="0,8,0,0">
                        <TextBlock Text="{Binding Label}" TextWrapping="Wrap" />
                        <Button Name="OpenSessionEvidence" Content="Open this exact session evidence result" HorizontalAlignment="Left" />
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </ScrollViewer>
            <TextBlock Grid.Row="2" Text="{Binding ConversationStatus}" Classes="muted" TextWrapping="Wrap" />
          </Grid>
        </TabItem>
        <TabItem Header="Activity">
          <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="8">
            <TextBlock Text="Retained host records: questions, answers, work and decisions. Historical records are read-only, never approval controls."
                TextWrapping="Wrap" Classes="muted" />
            <WrapPanel Grid.Row="1">
              <Button x:Name="ReadActivity" Content="Read activity" IsEnabled="{Binding CanHistory}" />
              <Button x:Name="NextActivity" Content="More activity" IsEnabled="{Binding CanNextHistory}" />
            </WrapPanel>
            <controls:ScrollableListBox Grid.Row="2" x:Name="ActivityList" ItemsSource="{Binding HistoryRecords}"
                SelectedItem="{Binding SelectedHistoryRecord, Mode=OneWay}"
                AutomationProperties.Name="Inert retained activity for the selected session; never grants or answers">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Border Padding="10" Margin="0,0,0,6" Background="{DynamicResource KoraSurfaceAltBrush}" CornerRadius="8">
                    <StackPanel Spacing="4">
                      <TextBlock Text="{Binding Kind}" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding Question}" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding Answer}" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding Decision, StringFormat='Outcome: {0}'}" />
                      <TextBlock Text="{Binding Availability, StringFormat='Retained content: {0}'}" Classes="muted" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </controls:ScrollableListBox>
            <Button Grid.Row="3" x:Name="ActivityDetails" Content="Selected activity details"
                IsEnabled="{Binding CanOpenHistoryDetail}" HorizontalAlignment="Left" />
          </Grid>
        </TabItem>
      </TabControl>
      <TextBox Grid.Row="3" x:Name="SessionComposer" Text="{Binding ComposerBody, Mode=TwoWay}"
          AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70" MaxHeight="160"
          IsEnabled="{Binding CanCompose}" PlaceholderText="Message this selected conversation..."
          AutomationProperties.Name="Memory-only unsent message for the selected conversation; not an answer or approval" />
      <WrapPanel Grid.Row="4">
        <Button x:Name="SubmitMessage" Content="Send to this conversation" IsEnabled="{Binding CanSubmitConversation}" />
        <Button x:Name="SubmitLocalAnswer" Content="Answer locally (no tools)" IsEnabled="{Binding CanSubmitConversation}"
            AutomationProperties.Name="Answer in this conversation using the qualified local model without tools" />
        <Button x:Name="StopLocalAnswer" Content="Stop this answer" IsEnabled="{Binding CanCancelRunningConversation}" />
        <Button x:Name="DiscardMessage" Content="Discard unsent..." IsEnabled="{Binding ComposerDirty}" />
      </WrapPanel>
      <StackPanel Grid.Row="5" Spacing="4">
      <TextBlock Text="{Binding RunningConversationStatus}" TextWrapping="Wrap"
          AutomationProperties.Name="Exact conversation running, stopping or terminal outcome" />
      <TextBlock
          Text="General voice relatedness matching is not available yet. This composer explicitly targets the selected conversation. Questions and approvals retain their original controls."
          TextWrapping="Wrap" Classes="muted" FontSize="11" />
      </StackPanel>
    </Grid>
    <GridSplitter x:Name="DetailsDivider" Grid.Column="1" Width="6" IsVisible="False" ResizeDirection="Columns"
        ResizeBehavior="PreviousAndNext" Focusable="True"
        AutomationProperties.Name="Resize conversation and Details panes" />
    <Grid x:Name="DetailsPane" Grid.Column="2" IsVisible="False" MinWidth="400" RowDefinitions="Auto,Auto,*" RowSpacing="8">
      <StackPanel Spacing="6">
        <TextBlock x:Name="DetailsHeading" Text="Details" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
        <WrapPanel>
          <Button x:Name="BackToConversation" Content="Back to conversation" IsEnabled="False"
              AutomationProperties.Name="Return focus to this exact originating message without hiding Details" />
          <Button x:Name="HideSessionDetails" Content="Hide details"
              AutomationProperties.Name="Hide Details and return to the originating message or Show details" />
        </WrapPanel>
      </StackPanel>
      <TextBlock Grid.Row="1" x:Name="DetailNavigationStatus" TextWrapping="Wrap" Classes="muted"
          AutomationProperties.Name="Details return navigation availability" />
      <ContentControl Grid.Row="2" x:Name="DetailsContent" />
    </Grid>
    </Grid>
  </Grid>
</UserControl>
