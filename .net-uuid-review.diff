+        internal Exception? Failure { get; set; }
+        internal Guid Output { get; set; } = Guid.Parse(Value);
+        internal Action? Callback { get; set; }
+        public Guid Generate()
+        {
+            Calls++;
+            Callback?.Invoke();
+            if (Failure is not null) { throw Failure; }
+            return Output;
+        }
+    }
