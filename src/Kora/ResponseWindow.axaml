<Window
    x:Class="Kora.ResponseWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Kora.Controls"
    xmlns:local="using:Kora"
    Title="{Binding AssistantName}"
    Width="560"
    Height="690"
    MinWidth="480"
    MinHeight="570"
    Background="Transparent"
    CanResize="False"
    ShowActivated="False"
    ShowInTaskbar="False"
    WindowDecorations="None"
    Topmost="{Binding IsResponseWindowTopmost}"
    TransparencyLevelHint="Transparent"
    KeyDown="OnCancelTaskKeyDown"
    WindowStartupLocation="Manual">
  <Grid RowDefinitions="Auto,*">
    <WrapPanel Margin="24,14,24,0">
      <TextBlock Text="{Binding AssistantName}" FontWeight="SemiBold" Margin="0,6,12,0"
          Cursor="SizeAll" PointerPressed="OnDragHandlePointerPressed" />
      <Button x:Name="ExpandSessions" Content="Show sessions" Click="OnExpandSessionsClicked" />
      <Button x:Name="CollapseSessions" Content="Collapse" Click="OnCollapseSessionsClicked" IsVisible="False" />
      <local:SessionDictationButton x:Name="SessionDictation" DataContext="{x:Null}" IsEnabled="{Binding CanCompose}" IsVisible="False" />
      <Button x:Name="ShowCurrentInteraction" Content="Current interaction" Click="OnCurrentInteractionClicked" IsVisible="False"
          ToolTip.Tip="Original response, question and approval controls; selecting a session never retargets them." />
      <Button x:Name="HideInteraction" Content="Hide" Click="OnHideInteractionClicked" IsVisible="False" />
      <TextBlock Text="Question or approval waiting" IsVisible="{Binding IsResponseInteractionPending}"
          Margin="10,6" FontWeight="SemiBold" />
    </WrapPanel>
    <local:SessionInteractionView x:Name="SessionWorkspace" Grid.Row="1" IsVisible="False" DataContext="{x:Null}" />
  <Border x:Name="CurrentInteractionContent" Grid.Row="1"
      Margin="12"
      Padding="22"
      Background="{DynamicResource KoraPresencePanelBrush}"
      BorderBrush="{DynamicResource KoraBorderBrush}"
      BorderThickness="1"
      CornerRadius="16">
    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="12">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel
            Spacing="4"
            Cursor="SizeAll"
            PointerPressed="OnDragHandlePointerPressed">
          <TextBlock Text="{Binding StateLabel}" Classes="eyebrow" />
          <TextBlock
              Text="{Binding ResponseTitle}"
              FontSize="22"
              FontWeight="SemiBold"
              TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
          <Button
              Content="Cancel task"
              IsVisible="{Binding IsCancelTaskVisible}"
              Click="OnCancelTaskClicked" />
          <Button
              Content="Dismiss"
              Click="OnDismissClicked" />
        </StackPanel>
      </Grid>

      <ScrollViewer Grid.Row="1" MaxHeight="150" VerticalScrollBarVisibility="Auto">
        <TextBlock
            Text="{Binding ResponseBody}"
            Classes="muted"
            FontSize="12"
            LineHeight="19"
            TextWrapping="Wrap" />
      </ScrollViewer>

      <Border
          Grid.Row="2"
          Padding="12"
          Background="{DynamicResource KoraSurfaceAltBrush}"
          CornerRadius="9">
        <StackPanel Spacing="5">
          <TextBlock Text="LAST TRANSCRIPT" Classes="eyebrow" />
          <TextBlock Text="{Binding Transcript}" FontSize="11" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <StackPanel
          Grid.Row="3"
          Spacing="6">
        <TextBlock Text="{Binding PendingQuestionNavigationStatus}" Classes="muted" FontSize="11" TextWrapping="Wrap"
                   AutomationProperties.Name="Pending question navigation status" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="Current response details"
                  AutomationProperties.Name="Open exact current ordinary response details"
                  Click="OnCurrentResponseDetailsClicked" />
          <Button Content="Read current response"
                  AutomationProperties.Name="Read this current ordinary response aloud once"
                  ToolTip.Tip="Uses normal speech mode, privacy, call, voice, length, volume and output admission. Questions, approvals and raw sources are not eligible."
                  Command="{Binding ReadCurrentResponseCommand}" />
          <Button Content="Stop speaking" Command="{Binding StopSpeechCommand}" />
        </StackPanel>
        <TextBlock Text="{Binding ReadCurrentResponseStatus}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
        <StackPanel IsVisible="{Binding IsDetailsOfferPending}" Spacing="6">
          <TextBlock Text="Would you like to view the detailed response?" TextWrapping="Wrap" />
          <WrapPanel>
            <Button Content="Yes, show details" Click="OnCurrentResponseDetailsClicked"
                AutomationProperties.Name="Accept the offer to view this exact current response" />
            <Button Content="Not now" Click="OnDeclineDetailsOffer"
                AutomationProperties.Name="Decline this detail offer without discarding the result" />
          </WrapPanel>
        </StackPanel>
        <ItemsControl ItemsSource="{Binding WebResultDetailActions}" IsVisible="{Binding HasWebResultDetails}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Spacing="5">
              <Button Content="Open exact web-result details"
                      AutomationProperties.Name="Open exact web-result details"
                      Tag="{Binding}"
                      Click="OnWebResultDetailsClicked"
                      HorizontalAlignment="Left" />
              <Button Content="Review local summary of this exact web result"
                      Tag="{Binding}" Click="OnWebSummaryClicked" HorizontalAlignment="Left" />
              <Button Content="Open in external browser"
                      Tag="{Binding}" Click="OnExternalBrowserClicked" HorizontalAlignment="Left" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="{Binding WebResultDetailStatus}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
        <TextBlock Text="{Binding WebSummaryStatus}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
        <ItemsControl ItemsSource="{Binding WebSummaryConfirmations}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Content="Use this exact web result with the local model"
                      Tag="{Binding}" Click="OnWebSummaryConfirmed" HorizontalAlignment="Left" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <ScrollViewer MaxHeight="180">
          <TextBlock Text="{Binding WebSummaryText}" FontSize="12" TextWrapping="Wrap" />
        </ScrollViewer>
        <ItemsControl ItemsSource="{Binding ResponseActions}" IsVisible="{Binding HasResponseActions}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button
                  Classes="response-link"
                  Tag="{Binding}"
                  Click="OnResponseActionClicked">
                <TextBlock Text="{Binding Label}" TextDecorations="Underline" />
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <StackPanel Grid.Row="4" Spacing="6">
        <ItemsControl ItemsSource="{Binding ModelActionReviews}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal" Spacing="10">
                <controls:ModelActionReviewButton Classes="primary" Content="Once" Click="OnApproveModelActionOnce"
                    IsEnabled="{Binding $parent[Window].DataContext.CanConfirmModelActionReview}" />
                <controls:ModelActionReviewButton Content="This session" Click="OnApproveModelActionForSession"
                    IsEnabled="{Binding $parent[Window].DataContext.CanConfirmReusableModelActionReview}" />
                <controls:ModelActionReviewButton Content="Always" Click="OnApproveModelActionAlways"
                    IsEnabled="{Binding $parent[Window].DataContext.CanConfirmReusableModelActionReview}" />
                <controls:ModelActionReviewButton Content="Reject" Click="OnRejectModelAction"
                    IsEnabled="{Binding $parent[Window].DataContext.CanRejectModelActionReview}" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="{Binding ModelActionReviewStatus}" TextWrapping="Wrap"
                   AutomationProperties.LiveSetting="Polite" />
      </StackPanel>

      <StackPanel Grid.Row="5" Spacing="6" IsVisible="{Binding IsGrantEditorVisible}">
        <TextBlock Text="Choose exact grant change" Classes="eyebrow" />
        <ComboBox ItemsSource="{Binding GrantActions}" SelectedItem="{Binding SelectedGrantAction}" DisplayMemberBinding="{Binding Action}" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <ComboBox ItemsSource="{Binding GrantOperations}" SelectedItem="{Binding SelectedGrantOperation}" />
          <ComboBox ItemsSource="{Binding GrantScopes}" SelectedItem="{Binding SelectedGrantScope}" />
          <TextBlock Text="to" VerticalAlignment="Center" />
          <ComboBox ItemsSource="{Binding GrantScopes}" SelectedItem="{Binding SelectedGrantTargetScope}" />
          <Button Content="Prepare" Command="{Binding PrepareGrantChangeCommand}" />
        </StackPanel>
      </StackPanel>

      <StackPanel Grid.Row="6" Orientation="Horizontal" Spacing="10" IsVisible="{Binding IsGrantChangePending}">
        <Button Classes="primary" Content="Confirm grant change" Command="{Binding ConfirmGrantChangeCommand}" />
        <Button Content="Reject" Command="{Binding RejectGrantChangeCommand}" />
      </StackPanel>

      <StackPanel Grid.Row="7" Spacing="6" IsVisible="{Binding IsModelQuestionPending}">
        <TextBlock Text="CHOOSE AN OPTION (NOT AN APPROVAL)" Classes="eyebrow" />
        <TextBlock Text="Choose a suggestion or type or speak your own answer." Classes="muted" FontSize="11" />
        <ScrollViewer MaxHeight="170" VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding ModelQuestionChoices}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Tag="{Binding}" Click="OnQuestionChoiceClicked"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,2">
                  <TextBlock Text="{Binding DisplayText}" TextWrapping="Wrap" MaxWidth="390" />
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        <Button Content="Cancel question" Click="OnCancelQuestionClicked" HorizontalAlignment="Left" />
      </StackPanel>

      <Border Grid.Row="8"
              IsVisible="{Binding IsArtifactCommandDropdownVisible}"
              MaxHeight="190"
              Padding="5"
              Background="{DynamicResource KoraSurfaceAltBrush}"
              BorderBrush="{DynamicResource KoraBorderBrush}"
              BorderThickness="1"
              CornerRadius="7">
        <controls:ScrollableListBox x:Name="ArtifactCommandList"
                 ItemsSource="{Binding ArtifactCommandOptions}"
                 AutomationProperties.Name="Available artifact slash commands">
          <ListBox.Styles>
            <Style Selector="ListBoxItem">
              <Setter Property="AutomationProperties.Name" Value="{Binding Command}" />
            </Style>
          </ListBox.Styles>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Button Tag="{Binding}"
                      AutomationProperties.Name="{Binding Command}"
                      Click="OnArtifactCommandClicked"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Left"
                      Padding="8,5">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                  <TextBlock Text="{Binding Command}" FontWeight="SemiBold" />
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Name}" />
                    <TextBlock Text="{Binding Description}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
                  </StackPanel>
                  <TextBlock Grid.Column="2" Text="{Binding Source}" Classes="muted" FontSize="10" />
                </Grid>
              </Button>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </controls:ScrollableListBox>
      </Border>

      <Grid Grid.Row="9" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="9">
        <TextBox
            x:Name="CommandInput"
            Text="{Binding CommandText}"
            AutomationProperties.Name="Typed command or artifact slash input"
            PlaceholderText="{Binding CommandInputPlaceholder}"
            KeyDown="OnCommandTextKeyDown"
            VerticalContentAlignment="Center" />
        <Button
            Grid.Column="1"
            x:Name="PushToTalkButton"
            Content="🎙"
            FontSize="18"
            Width="42"
            IsVisible="{Binding IsPushToTalkVisible}"
            AutomationProperties.Name="Push to talk; hold while speaking"
            ToolTip.Tip="Push to talk (hold)" />
        <Button
            Grid.Column="2"
            Classes="primary"
            Content="{Binding CommandSubmitLabel}"
            Command="{Binding RunTypedCommand}" />
      </Grid>
    </Grid>
  </Border>
  </Grid>
</Window>
