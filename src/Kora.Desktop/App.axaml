<Application
    x:Class="Kora.Desktop.App"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Styles>
    <FluentTheme />
    <Style Selector="Window">
      <Setter Property="FontFamily" Value="avares://Avalonia.Fonts.Inter/Assets#Inter" />
    </Style>
    <Style Selector="Button">
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="14,9" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#AF9BFF" />
      <Setter Property="Foreground" Value="#16131F" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.eyebrow">
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#B6A6F1" />
      <Setter Property="LetterSpacing" Value="1.7" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="#929BA9" />
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="#181C23" />
      <Setter Property="BorderBrush" Value="#303640" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="18" />
    </Style>
  </Application.Styles>
</Application>
