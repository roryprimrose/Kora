<Window x:Class="Kora.AllWorkWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Kora.Controls"
    Title="All work / attention overview - passive observations" Icon="/Assets/Kora.ico"
    Width="1120" Height="760" MinWidth="850" MinHeight="600"
    Background="{DynamicResource KoraWindowBackgroundBrush}"
    Foreground="{DynamicResource KoraForegroundBrush}" WindowStartupLocation="CenterScreen">
  <Grid Margin="24" RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="12">
    <WrapPanel>
      <Button x:Name="Refresh" Content="_Refresh overview" IsEnabled="{Binding CanSearch}" />
      <Button x:Name="Next" Content="_Next session page" IsEnabled="{Binding CanNext}" />
      <Button x:Name="CancelRead" Content="_Cancel read" IsEnabled="{Binding CanCancel}" />
      <ComboBox ItemsSource="{Binding Filters}" SelectedItem="{Binding Filter, Mode=TwoWay}"
                IsEnabled="{Binding CanEdit}" AutomationProperties.Name="Stored lifecycle filter, independent of task and queue state" />
      <ComboBox x:Name="ObservationAvailability" ItemsSource="{Binding AvailabilityChoices}"
                SelectedItem="{Binding SelectedAvailabilityChoice, Mode=TwoWay}"
                IsEnabled="{Binding CanEdit}"
                AutomationProperties.Name="Observation availability filter: Any, Observed, Source changed, Read unavailable, Output bound; changing performs no read; unavailable is not empty work">
        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
      </ComboBox>
      <ComboBox x:Name="ObservedContent" ItemsSource="{Binding ContentChoices}"
                SelectedItem="{Binding SelectedContentChoice, Mode=TwoWay}"
                IsEnabled="{Binding CanEdit}"
                AutomationProperties.Name="Observed content filter: Any, at least one observed queue receipt, task, or pending question; changing performs no read; unavailable never matches positive choices; omissions prove no absence or completion">
        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
      </ComboBox>
      <StackPanel>
        <TextBlock Text="Observed task state" />
        <ComboBox x:Name="ObservedTaskState" ItemsSource="{Binding TaskStateChoices}"
                  SelectedItem="{Binding SelectedTaskStateChoice, Mode=TwoWay}"
                  IsEnabled="{Binding CanEdit}"
                  AutomationProperties.Name="Observed task state: Any or exact defined HostTaskState; changing performs no read; only validated retained observed tasks match; omissions prove no absence, completion, current dispatch, ownership or authority">
          <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
        </ComboBox>
      </StackPanel>
      <CheckBox Content="Observed needs _answer" IsChecked="{Binding NeedsAnswer, Mode=TwoWay}"
                IsEnabled="{Binding CanEdit}" AutomationProperties.Name="Pending-question metadata in scanned snapshots only; unavailable sources remain explicit, never a fresh reply target" />
    </WrapPanel>
    <StackPanel Grid.Row="1" Spacing="6">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
        <ComboBox ItemsSource="{Binding QueryKinds}" SelectedItem="{Binding QueryKind, Mode=TwoWay}"
                  IsEnabled="{Binding CanEdit}" AutomationProperties.Name="Private metadata query mode: literal saved name substring or exact session ID" />
        <TextBox x:Name="MetadataQuery" Grid.Column="1" Text="{Binding QueryText, Mode=TwoWay}"
                 IsEnabled="{Binding CanEdit}" PlaceholderText="Optional private session metadata query"
                 AutomationProperties.Name="Private session metadata query; typing performs no read; Enter searches, Escape clears" />
        <Button x:Name="Search" Grid.Column="2" Content="_Search metadata" IsEnabled="{Binding CanSearch}" />
        <Button x:Name="ClearQuery" Grid.Column="3" Content="C_lear query" IsEnabled="{Binding CanEdit}" />
      </Grid>
      <controls:NamedTextBlock Text="{Binding QueryHint}" TextWrapping="Wrap"
                              AutomationProperties.Name="Metadata query validation and passive search scope" />
      <Expander x:Name="WorkRanges" Header="Optional inclusive observed work metadata ranges" HorizontalAlignment="Stretch">
        <StackPanel Spacing="6" IsEnabled="{Binding CanEdit}">
          <controls:NamedTextBlock Text="{Binding RangeHint}" TextWrapping="Wrap"
                                  AutomationProperties.Name="Work range validation; unavailable never matches ranges; omissions prove no absence, completeness, success or authority" />
          <ScrollViewer MaxHeight="210" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                        AutomationProperties.Name="Nine optional inclusive work metadata ranges">
            <ItemsControl ItemsSource="{Binding RangeInputs}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid ColumnDefinitions="240,*,*" ColumnSpacing="8" Margin="0,4">
                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Text="{Binding Minimum, Mode=TwoWay}" PlaceholderText="Minimum (Any)"
                             AutomationProperties.Name="{Binding MinimumLabel}" />
                    <TextBox Grid.Column="2" Text="{Binding Maximum, Mode=TwoWay}" PlaceholderText="Maximum (Any)"
                             AutomationProperties.Name="{Binding MaximumLabel}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          <Button x:Name="ClearRanges" Content="Clear work metadata _ranges" />
        </StackPanel>
      </Expander>
    </StackPanel>
    <controls:NamedTextBlock Grid.Row="2" Text="{Binding Status}" TextWrapping="Wrap"
                            AutomationProperties.Name="Bounded overview scope, scanned and omission markers; no global totals or all-clear" />
    <Grid Grid.Row="3" ColumnDefinitions="360,*" ColumnSpacing="12">
      <controls:ScrollableListBox x:Name="Records" ItemsSource="{Binding Records}" SelectedItem="{Binding SelectedRecord, Mode=OneWay}"
               AutomationProperties.Name="Independent work grouped by exact immutable session; selection is passive and grants nothing">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel Spacing="4">
              <TextBlock Text="{Binding Session.Metadata.Name.Value}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding Session.Authority.SessionId.Value}" FontFamily="Cascadia Mono,Consolas,monospace" TextWrapping="Wrap" />
              <TextBlock Text="{Binding Availability}" />
              <TextBlock Text="{Binding Session.Authority.IsActive, StringFormat='Stored Active: {0} (false means Done)'}" />
              <TextBlock Text="{Binding Work.ExecutionSlots, StringFormat='Confirmed fixed-profile slots: {0}'}" />
              <TextBlock Text="{Binding Work.ObservedCurrentFixedReads, StringFormat='Observed current fixed reads here: {0}'}" />
              <TextBlock Text="{Binding Work.PendingQuestions.Length, StringFormat='Observed pending questions: {0}'}" />
              <ItemsControl ItemsSource="{Binding Work.QueueRecords}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <StackPanel>
                      <TextBlock Text="{Binding Entry.Request.TaskId.Value, StringFormat='Queue task {0}'}" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding Entry.State, StringFormat='Queue state: {0}'}" />
                      <TextBlock Text="{Binding Eligibility, StringFormat='Observed policy reason: {0}'}" TextWrapping="Wrap" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <ItemsControl ItemsSource="{Binding Work.Tasks}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <StackPanel>
                      <TextBlock Text="{Binding Request.TaskId.Value, StringFormat='Durable task {0}'}" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding State, StringFormat='Durable task state: {0}'}" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="Select for complete source revisions, deadlines and omission counts." TextWrapping="Wrap" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </controls:ScrollableListBox>
      <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                    AutomationProperties.Name="Complete bounded selected group work metadata and policy reasons">
        <controls:NamedTextBlock Text="{Binding SelectedDetails}" TextWrapping="Wrap"
                             AutomationProperties.Name="Exact observation provenance, stored lifecycle, queue/task states, deadlines and pending-question metadata; no bodies or authority" />
      </ScrollViewer>
    </Grid>
    <WrapPanel Grid.Row="4">
      <Button x:Name="Navigate" Content="Open exact _session with fresh passive read" IsEnabled="{Binding CanNavigate}"
              AutomationProperties.Name="Navigate this immutable session ID through Sessions private workspace admission; no resume, dispatch, cancel, enqueue or question retarget" />
      <Button x:Name="CloseView" Content="_Close" />
    </WrapPanel>
  </Grid>
</Window>
