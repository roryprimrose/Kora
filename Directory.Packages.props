    <PackageVersion Include="coverlet.MTP" Version="10.0.1" />
    <PackageVersion Include="KokoroSharp" Version="0.8.4" />
    <PackageVersion Include="Markdig" Version="1.4.0" />
    <PackageVersion Include="Meziantou.Analyzer" Version="3.0.290" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageVersion Include="Microsoft.ML.OnnxRuntime" Version="1.30.0" />
    <PackageVersion Include="Microsoft.Testing.Extensions.TrxReport" Version="2.4.1" />
    <PackageVersion Include="Microsoft.VisualStudio.Threading.Analyzers" Version="18.7.23" />
    <PackageVersion Include="Microsoft.Win32.SystemEvents" Version="10.0.0" />
    <PackageVersion Include="MisakiSharp" Version="2.2.0" />
    <PackageVersion Include="NAudio" Version="3.1.0" />
    <PackageVersion Include="Neovolve.Logging.Xunit.v3" Version="7.2.0" />
    <PackageVersion Include="Serilog" Version="4.4.0" />
    <PackageVersion Include="Serilog.Extensions.Logging" Version="10.0.0" />
    <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageVersion Include="System.Speech" Version="10.0.12" />
    <PackageVersion Include="WixToolset.BootstrapperApplicationApi" Version="7.0.0" />
    <PackageVersion Include="WixToolset.Netfx.wixext" Version="7.0.0" />
    <PackageVersion Include="WixToolset.Util.wixext" Version="7.0.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.1" />
