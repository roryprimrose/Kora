<Window x:Class="Kora.ModelHistoryContextWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Review context for the original question" Icon="/Assets/Kora.ico"
    Width="820" Height="780" MinWidth="600" MinHeight="500"
    Background="{DynamicResource KoraWindowBackgroundBrush}"
    Foreground="{DynamicResource KoraForegroundBrush}">
</Window>
