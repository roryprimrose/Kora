<Window
    x:Class="Kora.SharedSkillSourcesWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Kora.Controls"
    Title="Shared profile skills - local read-only inspection"
    Icon="/Assets/Kora.ico" Width="1050" Height="800" MinWidth="700" MinHeight="500"
    Background="{DynamicResource KoraWindowBackgroundBrush}"
    Foreground="{DynamicResource KoraForegroundBrush}">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <Grid Margin="20" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,*" RowSpacing="10">
    <TextBlock Text="Registration authorizes only bounded local reading. No enable/disable/invoke, model exposure, execution, egress, approval, source editing or trust promotion."
               TextWrapping="Wrap" />
    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10">
      <Button x:Name="RegisterSource" Content="Choose and register profile root (read only)" />
      <Button x:Name="RefreshSources" Content="Refresh registrations" />
      <Button x:Name="UnregisterSource" Content="Withdraw local read consent"
              AutomationProperties.Name="Unregister the exact selected source without changing shared files" />
    </StackPanel>
    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="10">
      <ComboBox x:Name="SourceSelector" MinWidth="360" AutomationProperties.Name="Registered exact shared profile roots" />
      <Button x:Name="DiscoverSource" Content="List selected source" />
      <Button x:Name="VerifyRevision" Content="Recheck selected revision" />
    </StackPanel>
    <controls:NamedTextBlock x:Name="SharedStatus" Grid.Row="3" TextWrapping="Wrap"
                            AutomationProperties.Name="Source availability and immutable revision status" />
    <StackPanel Grid.Row="4" Spacing="6">
      <TextBlock Text="Search this admitted source only: declared names, metadata-qualified IDs and valid declared descriptions. Literal ordinal-ignore-case substring, no trimming; no paths or instruction bodies." TextWrapping="Wrap" />
      <WrapPanel Orientation="Horizontal">
        <TextBox x:Name="SharedQuery" MinWidth="280" IsUndoEnabled="False" AutomationProperties.Name="Shared metadata query, at most 256 UTF-16 units and 512 UTF-8 bytes" />
        <ComboBox x:Name="SharedFilter" AutomationProperties.Name="Instruction-only compatibility filter; all invocation unavailable" />
        <Button x:Name="SearchSharedPackages" Content="Search" AutomationProperties.Name="Search admitted shared metadata without reading the source" />
        <Button x:Name="ClearSharedSearch" Content="Clear" AutomationProperties.Name="Clear shared search and restore All and source order without selecting a result" />
      </WrapPanel>
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
        <Label Content="Order" Target="{Binding #SharedOrder}" />
        <ComboBox x:Name="SharedOrder" Grid.Column="1" HorizontalAlignment="Stretch"
                  AutomationProperties.Name="Shared metadata order; source default, ordinal names, unknown names last" />
      </Grid>
    </StackPanel>
    <controls:NamedTextBlock x:Name="SharedSearchStatus" Grid.Row="5" TextWrapping="Wrap"
                            AutomationProperties.Name="Shared metadata search results and validation" />
    <ComboBox x:Name="SharedPackageSelector" Grid.Row="6" HorizontalAlignment="Stretch"
              AutomationProperties.Name="Compatible and unavailable shared skill snapshots" />
    <Grid Grid.Row="7" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="10">
      <controls:NamedTextBlock x:Name="SharedIdentity" TextWrapping="Wrap"
                              AutomationProperties.Name="Exact source-qualified identity, digest and compatibility" />
      <controls:IdentityMetadataFindPane x:Name="IdentityFind" Grid.Row="1"
                                       AutomationProperties.Name="Find in selected displayed shared identity metadata only" />
      <Expander x:Name="UninspectedDisclosure" Grid.Row="2" Header="Additional entries (names only; incompatible, no contents read)">
        <TextBox x:Name="UninspectedEntries" IsReadOnly="True" AcceptsReturn="True" IsUndoEnabled="False"
                 MaxHeight="140" FontFamily="Consolas" TextWrapping="NoWrap"
                 AutomationProperties.Name="Uninspected additional entry paths, not a dependency closure" />
      </Expander>
      <TextBox x:Name="SharedSource" Grid.Row="3" IsReadOnly="True" AcceptsReturn="True"
               IsUndoEnabled="False" FontFamily="Consolas" TextWrapping="NoWrap" MinHeight="160" MaxHeight="360"
               AutomationProperties.Name="Exact immutable untrusted SKILL.md source, inert plain text" />
    </Grid>
  </Grid>
  </ScrollViewer>
</Window>
