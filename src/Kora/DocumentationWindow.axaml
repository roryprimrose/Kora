<Window x:Class="Kora.DocumentationWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="1120" Height="780" MinWidth="860" MinHeight="620" Icon="/Assets/Kora.ico"
    Background="{DynamicResource KoraWindowBackgroundBrush}"
    Foreground="{DynamicResource KoraForegroundBrush}" WindowStartupLocation="CenterScreen" />
