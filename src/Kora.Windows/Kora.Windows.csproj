<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Kora.Core\Kora.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference
        Include="GitHub.Copilot.SDK"
        ExcludeAssets="build;buildTransitive;contentFiles" />
    <PackageReference
        Include="KokoroSharp"
        ExcludeAssets="build;buildTransitive;contentFiles" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" />
    <PackageReference Include="Microsoft.Win32.SystemEvents" />
    <PackageReference Include="MisakiSharp" />
    <PackageReference Include="NAudio" />
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="System.Speech" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Kora.Windows.IntegrationTests" />
  </ItemGroup>

  <ItemGroup Condition="'$(RuntimeIdentifier)' == '' or '$(RuntimeIdentifier)' == 'win-x64'">
    <Content Include="Audio\Native\pocketsphinx-win-x64.dll" Link="HandsFreeNative\pocketsphinx-win-x64.dll"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Audio\Native\*.txt" Link="HandsFreeNative\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

</Project>
