<Window
    x:Class="Kora.MaintenanceWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Kora release maintenance (notify-only)"
    Icon="/Assets/Kora.ico"
    Width="790" Height="660" MinWidth="650" MinHeight="520"
    Background="{DynamicResource KoraWindowBackgroundBrush}"
    Foreground="{DynamicResource KoraForegroundBrush}">
  <ScrollViewer>
    <StackPanel Margin="24" Spacing="14">
      <TextBlock Text="Canonical release metadata" FontSize="24" FontWeight="SemiBold" />
      <TextBlock Text="{Binding CurrentVersion, StringFormat='Running version: {0}'}" />
      <TextBlock Text="{Binding Disclosure}" TextWrapping="Wrap" />
      <TextBlock Text="Production excludes drafts and prereleases. Preview explicitly selects published beta releases. Remote notes are not rendered. Review this exact page before opening it; replacement is external and manual." TextWrapping="Wrap" />
      <ComboBox ItemsSource="{Binding Channels}" SelectedItem="{Binding Channel}" Width="200" HorizontalAlignment="Left" />
      <CheckBox Content="Permit public metadata checks for this run (initial check, then 6 hours + jitter/backoff)"
                IsChecked="{Binding NetworkEnabled}" />
      <Button Content="Check canonical releases" Command="{Binding CheckCommand}" HorizontalAlignment="Left" />
      <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
      <TextBlock Text="{Binding VerificationStatus}" TextWrapping="Wrap" />
      <TextBlock Text="{Binding NextCheck, StringFormat='Next eligible check: {0:u}'}" TextWrapping="Wrap" />
      <TextBlock Text="{Binding ReleaseDetails}" TextWrapping="Wrap" />
      <TextBlock Text="{Binding ReleasePage}" TextWrapping="Wrap" />
      <StackPanel Orientation="Horizontal" Spacing="12">
        <Button Content="Open reviewed canonical release page" Command="{Binding OpenCommand}" IsEnabled="{Binding CanOpen}" />
        <Button Content="Snooze this version (24h)" Command="{Binding SnoozeCommand}" IsEnabled="{Binding CanOpen}" />
      </StackPanel>
      <TextBlock Text="No unsolicited window, focus, audio, microphone, model call or install approval. Unknown deployment mode never authorizes source mutation. Permission and snooze are not saved across restart." TextWrapping="Wrap" />
    </StackPanel>
  </ScrollViewer>
</Window>
