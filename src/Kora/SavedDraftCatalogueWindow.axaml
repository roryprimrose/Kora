<Window x:Class="Kora.SavedDraftCatalogueWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Kora.Controls"
    Title="Saved conversation drafts - metadata only" Icon="/Assets/Kora.ico"
    Width="1100" Height="720" MinWidth="850" MinHeight="580"
    Background="{DynamicResource KoraWindowBackgroundBrush}"
    Foreground="{DynamicResource KoraForegroundBrush}" WindowStartupLocation="CenterScreen">
  <Grid Margin="24" RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="12">
    <WrapPanel>
      <Button x:Name="RefreshPage" Content="_Search / refresh metadata" IsEnabled="{Binding CanSearch}" />
      <Button x:Name="NextPage" Content="_Next bounded page" IsEnabled="{Binding CanNext}" />
      <Button x:Name="CancelRead" Content="_Cancel read" IsEnabled="{Binding CanCancel}" />
      <ComboBox x:Name="DraftFilter" ItemsSource="{Binding Filters}" SelectedItem="{Binding Filter, Mode=TwoWay}"
                IsEnabled="{Binding CanEditQuery}" AutomationProperties.Name="Stored session state filter; default All retained saved drafts" />
      <Button x:Name="ClearQuery" Content="Clear _query (Browse)" IsEnabled="{Binding CanEditQuery}" />
    </WrapPanel>
    <ScrollViewer Grid.Row="1" MaxHeight="240" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                  AutomationProperties.Name="Saved draft query and metadata predicates">
    <StackPanel Spacing="6">
      <WrapPanel>
        <ComboBox x:Name="DraftQueryMode" ItemsSource="{Binding Modes}" SelectedItem="{Binding Mode, Mode=TwoWay}"
                  IsEnabled="{Binding CanEditQuery}" AutomationProperties.Name="Saved draft metadata query mode: Browse, NameSubstring or ExactId" />
        <TextBox x:Name="DraftQueryText" Text="{Binding QueryText, Mode=TwoWay}" Width="540"
                 IsEnabled="{Binding CanEditQuery}" AutomationProperties.Name="Private volatile session name or exact ID query; typing performs no read" />
      </WrapPanel>
      <controls:NamedTextBlock Text="{Binding QueryHint}" TextWrapping="Wrap" />
      <WrapPanel>
        <StackPanel>
          <TextBlock Text="Exact saved revision (Any if empty)" />
          <TextBox x:Name="DraftRevisionText" Text="{Binding RevisionText, Mode=TwoWay}" Width="240"
                   IsEnabled="{Binding CanEditQuery}" AutomationProperties.Name="Exact positive saved draft revision; empty means Any; typing performs no read" />
        </StackPanel>
            <StackPanel>
              <TextBlock Text="Minimum session generation (inclusive)" />
              <TextBox x:Name="DraftMinimumSessionGenerationText" Text="{Binding MinimumSessionGenerationText, Mode=TwoWay}" Width="240"
                       IsEnabled="{Binding CanEditQuery}" AutomationProperties.Name="Inclusive minimum positive observed session generation; empty means Any; provenance only, not authority; typing performs no read" />
            </StackPanel>
            <StackPanel>
              <TextBlock Text="Maximum session generation (inclusive)" />
              <TextBox x:Name="DraftMaximumSessionGenerationText" Text="{Binding MaximumSessionGenerationText, Mode=TwoWay}" Width="240"
                       IsEnabled="{Binding CanEditQuery}" AutomationProperties.Name="Inclusive maximum positive observed session generation; empty means Any; provenance only, not authority; typing performs no read" />
            </StackPanel>
            <StackPanel>
              <TextBlock Text="Minimum name metadata revision (inclusive)" />
              <TextBox x:Name="DraftMinimumNameMetadataRevisionText" Text="{Binding MinimumNameMetadataRevisionText, Mode=TwoWay}" Width="240"
                       IsEnabled="{Binding CanEditQuery}" AutomationProperties.Name="Inclusive minimum positive name metadata revision; unnamed excluded; empty means Any; provenance only; typing performs no read" />
            </StackPanel>
            <StackPanel>
              <TextBlock Text="Maximum name metadata revision (inclusive)" />
              <TextBox x:Name="DraftMaximumNameMetadataRevisionText" Text="{Binding MaximumNameMetadataRevisionText, Mode=TwoWay}" Width="240"
                       IsEnabled="{Binding CanEditQuery}" AutomationProperties.Name="Inclusive maximum positive name metadata revision; unnamed excluded; empty means Any; provenance only; typing performs no read" />
            </StackPanel>
            <StackPanel>
              <TextBlock Text="Minimum control revision (inclusive)" />
              <TextBox x:Name="DraftMinimumControlRevisionText" Text="{Binding MinimumControlRevisionText, Mode=TwoWay}" Width="240"
                       IsEnabled="{Binding CanEditQuery}" AutomationProperties.Name="Inclusive minimum nonnegative observed control revision; empty means Any; provenance only, not permission; typing performs no read" />
            </StackPanel>
            <StackPanel>
              <TextBlock Text="Maximum control revision (inclusive)" />
              <TextBox x:Name="DraftMaximumControlRevisionText" Text="{Binding MaximumControlRevisionText, Mode=TwoWay}" Width="240"
                       IsEnabled="{Binding CanEditQuery}" AutomationProperties.Name="Inclusive maximum nonnegative observed control revision; empty means Any; provenance only, not permission; typing performs no read" />
            </StackPanel>
            <StackPanel>
              <TextBlock Text="Minimum authority ceiling (inclusive)" />
              <TextBox x:Name="DraftMinimumAuthorityCeilingText" Text="{Binding MinimumAuthorityCeilingText, Mode=TwoWay}" Width="240"
                       IsEnabled="{Binding CanEditQuery}" AutomationProperties.Name="Inclusive minimum positive observed authority ceiling; empty means Any; provenance only, not current authority; typing performs no read" />
            </StackPanel>
            <StackPanel>
              <TextBlock Text="Maximum authority ceiling (inclusive)" />
              <TextBox x:Name="DraftMaximumAuthorityCeilingText" Text="{Binding MaximumAuthorityCeilingText, Mode=TwoWay}" Width="240"
                       IsEnabled="{Binding CanEditQuery}" AutomationProperties.Name="Inclusive maximum positive observed authority ceiling; empty means Any; provenance only, not current authority; typing performs no read" />
            </StackPanel>
        <StackPanel>
          <TextBlock Text="Minimum UTF-8 bytes (inclusive)" />
          <TextBox x:Name="DraftMinimumBytesText" Text="{Binding MinimumBytesText, Mode=TwoWay}" Width="240"
                   IsEnabled="{Binding CanEditQuery}" AutomationProperties.Name="Inclusive minimum saved draft UTF-8 bytes; empty means Any; typing performs no read" />
        </StackPanel>
        <StackPanel>
          <TextBlock Text="Maximum UTF-8 bytes (inclusive)" />
          <TextBox x:Name="DraftMaximumBytesText" Text="{Binding MaximumBytesText, Mode=TwoWay}" Width="240"
                   IsEnabled="{Binding CanEditQuery}" AutomationProperties.Name="Inclusive maximum saved draft UTF-8 bytes; empty means Any; typing performs no read" />
        </StackPanel>
        <StackPanel>
          <TextBlock Text="Minimum Unicode scalars (inclusive)" />
          <TextBox x:Name="DraftMinimumScalarsText" Text="{Binding MinimumScalarsText, Mode=TwoWay}" Width="240"
                   IsEnabled="{Binding CanEditQuery}" AutomationProperties.Name="Inclusive minimum saved draft Unicode scalar count; empty means Any; typing performs no read" />
        </StackPanel>
        <StackPanel>
          <TextBlock Text="Maximum Unicode scalars (inclusive)" />
          <TextBox x:Name="DraftMaximumScalarsText" Text="{Binding MaximumScalarsText, Mode=TwoWay}" Width="240"
                   IsEnabled="{Binding CanEditQuery}" AutomationProperties.Name="Inclusive maximum saved draft Unicode scalar count; empty means Any; typing performs no read" />
        </StackPanel>
      </WrapPanel>
      <controls:NamedTextBlock Text="{Binding MetadataHint}" TextWrapping="Wrap" />
      <WrapPanel>
        <StackPanel>
          <TextBlock Text="Exact observation source GUID (Any if empty)" />
          <TextBox x:Name="DraftSourceText" Text="{Binding SourceText, Mode=TwoWay}" Width="360"
                   IsEnabled="{Binding CanEditQuery}" AutomationProperties.Name="Exact observation source GUID; canonical lowercase D format; empty means Any; metadata only, not authority; typing performs no read" />
        </StackPanel>
        <StackPanel>
          <TextBlock Text="Exact device profile GUID (Any if empty)" />
          <TextBox x:Name="DraftProfileText" Text="{Binding ProfileText, Mode=TwoWay}" Width="360"
                   IsEnabled="{Binding CanEditQuery}" AutomationProperties.Name="Exact device profile GUID; canonical lowercase D format; empty means Any; metadata only, not ownership or identity; typing performs no read" />
        </StackPanel>
      </WrapPanel>
    </StackPanel>
    </ScrollViewer>
    <ScrollViewer Grid.Row="2" MaxHeight="96" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <controls:NamedTextBlock Text="{Binding Status}" TextWrapping="Wrap"
                              AutomationProperties.Name="Passive bounded metadata observation; not body integrity verification" />
    </ScrollViewer>
    <Grid Grid.Row="3" ColumnDefinitions="430,*" ColumnSpacing="12">
      <controls:ScrollableListBox x:Name="DraftRecords" ItemsSource="{Binding Records}"
          SelectedItem="{Binding SelectedRecord, Mode=OneWay}"
          AutomationProperties.Name="Observed exact saved composer draft metadata; private inert session names, no body preview">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel Spacing="4">
              <TextBlock Text="{Binding Session.SessionId.Value, StringFormat='Exact session: {0}'}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding Metadata.Name.Value, StringFormat='Private inert name: {0}'}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding Session.IsActive, StringFormat='Stored Active: {0} (false means Done)'}" />
              <TextBlock Text="{Binding Session.Generation.Value, StringFormat='Observed session generation: {0}'}" />
              <TextBlock Text="{Binding Metadata.Revision.Value, StringFormat='Metadata revision: {0}'}" />
              <TextBlock Text="{Binding DraftRevision, StringFormat='Saved draft revision: {0}'}" />
              <TextBlock Text="{Binding Utf8Bytes, StringFormat='Saved UTF-8 bytes: {0}'}" />
              <TextBlock Text="{Binding UnicodeScalars, StringFormat='SQL Unicode scalar length: {0}'}" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </controls:ScrollableListBox>
      <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <controls:NamedTextBlock Text="{Binding SelectedDetails}" TextWrapping="Wrap"
          AutomationProperties.Name="Selected immutable saved draft metadata only, no body, excerpt or digest" />
      </ScrollViewer>
    </Grid>
    <WrapPanel Grid.Row="4">
      <Button x:Name="OpenExact" Content="Open exact _session (no body load)" IsEnabled="{Binding CanNavigate}"
              AutomationProperties.Name="Re-resolve exact saved revision and session; no reload, save, Submit or resume" />
      <Button x:Name="CloseView" Content="_Close" />
    </WrapPanel>
  </Grid>
</Window>
