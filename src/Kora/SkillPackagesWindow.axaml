<Window
    x:Class="Kora.SkillPackagesWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Kora.Controls"
    Title="Skill packages - inspection only"
    Icon="/Assets/Kora.ico"
    Width="1100" Height="800" MinWidth="700" MinHeight="500"
    WindowStartupLocation="CenterOwner"
    Background="{DynamicResource KoraWindowBackgroundBrush}"
    Foreground="{DynamicResource KoraForegroundBrush}">
  <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*" Margin="20" RowSpacing="12">
    <StackPanel Orientation="Horizontal" Spacing="12">
      <TextBlock Text="Skill packages - read-only embedded source review"
                 FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
      <Button x:Name="SharedSources" Content="Shared profile sources (read only)" />
    </StackPanel>
    <StackPanel Grid.Row="1" Spacing="6">
      <TextBlock Text="Search admitted names, IDs and declared descriptions only: literal ordinal-ignore-case substring, no trimming. Runtime availability is not instruction compatibility." TextWrapping="Wrap" />
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBox x:Name="PackageQuery" MinWidth="280" IsUndoEnabled="False" AutomationProperties.Name="Bundled metadata query, at most 256 UTF-16 units and 512 UTF-8 bytes" />
        <ComboBox x:Name="PackageFilter" AutomationProperties.Name="Bundled runtime availability filter" />
        <Button x:Name="SearchPackages" Content="Search" AutomationProperties.Name="Search admitted bundled metadata without reading resources" />
        <Button x:Name="ClearPackageSearch" Content="Clear" AutomationProperties.Name="Clear bundled search and restore All without selecting a result" />
      </StackPanel>
      <TextBlock Text="Exact snapshot digests: empty means Any; otherwise 64 lowercase hexadecimal characters. These filters do not verify live content or grant authority." TextWrapping="Wrap" />
      <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="6">
        <Label Content="Definition digest" Target="{Binding #PackageDefinitionDigest}" />
        <TextBox x:Name="PackageDefinitionDigest" Grid.Column="1" IsUndoEnabled="False"
                 AutomationProperties.Name="Exact bundled DefinitionDigest, empty means Any, lowercase SHA-256" />
        <Label Grid.Row="1" Content="Declared resource digest" Target="{Binding #PackageDeclaredResourceDigest}" />
        <TextBox x:Name="PackageDeclaredResourceDigest" Grid.Row="1" Grid.Column="1" IsUndoEnabled="False"
                 AutomationProperties.Name="Exact bundled DeclaredResourceDigest, empty means Any, lowercase SHA-256" />
      </Grid>
    </StackPanel>
    <controls:NamedTextBlock x:Name="PackageSearchStatus" Grid.Row="2" TextWrapping="Wrap"
                            AutomationProperties.Name="Bundled metadata search results and validation" />
    <ComboBox x:Name="PackageSelector" Grid.Row="3" HorizontalAlignment="Stretch"
              AutomationProperties.Name="Select an inspection-only bundled skill package" />
    <controls:NamedTextBlock x:Name="PackageIdentity" Grid.Row="4" TextWrapping="Wrap"
               AutomationProperties.Name="Exact package identities, unavailable invocation and transitive disclosure" />
    <controls:NavigableTabControl x:Name="SourceTabs" Grid.Row="5"
                AutomationProperties.Name="Every declared immutable package file including manifest and shared helper" />
  </Grid>
</Window>
